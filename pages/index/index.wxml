<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- ============================================================
       R207 · 首页头卡 hero（v3 UI 方案）
       · 原第一张「当前店铺卡」= 唯一的店铺切换入口 ⇒ **不能删**，降级为 hero 右上「切换店铺」按钮（功能零丢失）
       · 有本月数据 → 大数字区显示利润数：
                       付费档显示**会计利润**（total_factor_real_profit_fen，标签由 profitLabel 按"盘没盘点"生成：盘点⇒本月利润 / 没盘点⇒估算利润）；
                       免费档（R493 锁在付费墙后）只显示**经营参考利润**（operation_ref_profit_fen，参考口径、不含摊销），引导去开通看真实利润。
                       ⚠️ 两口径取数来源不同，必须按权益分流，否则免费档首页与月首页数字对不上。
       · 无本月数据 → 🔴 **绝不显示 ¥0**（红队结论：老板会读成"这店没赚钱"）
                      ⇒ 改「还没有本月数据」+ 辅助小字 + 「录入本月经营数据」按钮占住 C 位
       · 🔴 按钮文案不叫「记一笔」（会被理解成记当日流水，点进去却是一长串月度科目 ⇒ 觉得被骗）
       ============================================================ -->
  <view class="hero ovh">
    <!-- R679：纯 CSS 装饰圆（不用图片）。深蓝底不再是一块平板。
         ⚠️ 只做极淡白 4%~6%，不做渐变 —— 45 岁老板看渐变会觉得"这是促销页"。 -->
    <view class="hero-deco a"></view>
    <view class="hero-deco b"></view>
    <view class="hero-top">
      <view class="hero-shop">
        <!-- 长店名必须截断（否则挤压下面的净利数字，见 v3 样品「XX 重庆老火锅家常菜馆」实测） -->
        <view class="hero-name">{{shopName || t.defaultShopName}}</view>
        <view class="hero-month">{{curMonth}}</view>
      </view>
      <view class="hero-switch" bindtap="goSwitch" hover-class="none">{{t.heroSwitch}} ›</view>
    </view>

    <!-- 三态：**未确定 ≠ 无数据** —— 请求没回来时若按「无数据」渲染，
         有数据的老用户会先闪一帧「还没有本月数据」再跳成数字，观感像抖屏 ⇒ 必须分开。 -->
    <view class="hero-bot">
      <view class="hero-figure" wx:if="{{hasProfit}}">
        <view class="hero-lab">{{profitTitle}}</view>
        <!-- 🔴 R683：原来这里渲染成「¥ 51900.00元」—— 货币符号和「元」字**同时出现**，
             符号后还多一个空格。全仓其他金额一律只用 `¥` 前缀（结果页 ¥51900.00、
             卡片列表 ¥6.50），首页这套是唯一的例外 ⇒ 统一成 `¥51900.00`，
             并删掉已无引用的 `.hero-unit` 样式（留着它就是给后人一个"这里该有元字"的假线索）。 -->
        <view class="hero-num money">{{t.cur}}{{refProfit}}</view>
      </view>
      <view class="hero-figure" wx:elif="{{profitKnown}}">
        <view class="hero-lab">{{t.heroNoData}}</view>
        <view class="hero-hint">{{t.heroNoDataHint}}</view>
      </view>
      <view class="hero-figure" wx:else>
        <view class="hero-lab">{{profitTitle}}</view>
        <view class="hero-num money">{{t.loading}}</view>
      </view>
      <!-- 🔴 空态永远不显示 ¥0（老板会读成"这店没赚钱"）；按钮也不叫「记一笔」 -->
      <view class="hero-cta {{hasProfit ? '' : 'solid'}}" bindtap="goMonth">{{hasProfit ? t.heroCtaDetail : t.heroCtaEnter}} ›</view>
    </view>

    <!-- 🔴 R679：一行三列（营收 / 成本 / 毛利率）。
         为什么加：原来首页只有「利润」一个数，老板想知道的下一层是"收了多少、花了多少"。
         ⚠️ 数据全部来自同一次 getLedger，零新增接口（首页刚修完加载慢，不能再加调用）。
         ⚠️ 有账本记录才显示；没有就整块不渲染 —— 绝不显示 0。 -->
    <view class="hero-row" wx:if="{{hasProfit && heroIncome}}">
      <view class="hero-col">
        <view class="hero-col-lab">{{t.heroIncomeLab}}</view>
        <view class="hero-col-num">{{heroIncome}}</view>
      </view>
      <view class="hero-col">
        <view class="hero-col-lab">{{t.heroCostLab}}</view>
        <view class="hero-col-num">{{heroCost}}</view>
      </view>
      <view class="hero-col">
        <view class="hero-col-lab">{{t.heroGmLab}}</view>
        <view class="hero-col-num">{{heroGm}}</view>
      </view>
    </view>
  </view>

  <!-- ============================================================
       三大模块（无序号 —— 红队判其为冗余且易发虚；区分靠**形状图标**，
       🔴 不用颜色区分：红绿在本仓已绑定「涨/跌」语义，当模块色会被读成盈亏）
       ============================================================ -->
  <!-- 🔴 R679：一大两小（M1 是老板最常用的入口 ⇒ 大卡；M2/M3 并排）。
       原来三张完全同构 ⇒ 眼睛没有落点，老板反馈"太素"。
       顺带：三横条约 608rpx → 大卡 + 并排约 400rpx，首屏松出约 200rpx。 -->
  <view class="mod main ovh" bindtap="goMonth">
    <view class="mod-ico"><view class="i i-ledger"></view></view>
    <view class="mod-bd">
      <view class="mod-t">{{t.m1}}</view>
      <view class="mod-m">{{t.m1Sub}}</view>
      <!-- 🔴 有数据说"有数据"，没数据说"去记第一笔" —— **绝不显示 0**
           （老板会把 0 读成"我这块是空的/坏了"）。 -->
      <view class="mod-chip {{hasProfit ? '' : 'act'}}">{{hasProfit ? t.modHasData : t.modGoEnter}}</view>
    </view>
    <view class="mod-go">›</view>
  </view>

  <view class="mod-row">
    <view class="mod sm ovh" bindtap="goSandbox">
      <view class="mod-ico"><view class="i i-house"></view></view>
      <view class="mod-t">{{t.m2}}</view>
      <view class="mod-m">{{t.m2Sub}}</view>
    </view>
    <view class="mod sm ovh" bindtap="goCard">
      <view class="mod-ico"><view class="i i-pan"></view></view>
      <view class="mod-t">{{t.m3}}</view>
      <view class="mod-m">{{t.m3Sub}}</view>
    </view>
  </view>

  <!-- ============================================================
       R234/J3 · 首页常驻折叠引导条（第一次用？看这里）
       · 放在三张模块卡**之后**：老板打开 App 先看到「能做什么」，再看到「怎么用」；
         反过来会挡住三个入口（红队：首屏本来就紧，hero 200 + 3×模块卡 ≈ 608rpx）。
       · **默认收起** ⇒ 收起时只占一行 88rpx，展开才铺开四步。
       · 复用 exp.guideBody（与「我的 → 使用指引」同一份文案）⇒ 零新文案、不会两处漂移。
       · 🔴 不是替代 mine 页的弹窗：弹窗关掉就不再出现，这条是**随时能看的回程路**。
       ============================================================ -->
  <view class="guide-fold">
    <view class="guide-fold-head" bindtap="onToggleGuide">
      <text class="guide-fold-guide">{{guideOpen ? t.guideFoldHide : t.guideFoldShow}}</text>
      <text class="guide-fold-arrow">{{guideOpen ? '▾' : '▸'}}</text>
    </view>
    <view class="guide-fold-body" wx:if="{{guideOpen}}">{{t.guideBody}}</view>
  </view>

  <!-- R199：底部 tabBar 上线后，「我的」入口已由 tabBar 承担 ⇒ 此处不重复。
     「设置」保留 —— 店铺设置没有 tabBar 替代入口，删了就少一条路。 -->
  <view class="idx-tip">{{t.tipMore}}</view>
  <button class="btn ghost" bindtap="goSettings">{{t.settings}}</button>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
