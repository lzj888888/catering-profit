<view class="form safe-bottom" wx:if="{{!loading}}">
  <view class="field">
    <text class="lbl">{{t.matName}}</text>
    <input class="val-input" value="{{name}}" placeholder="{{t.matNamePh}}" bindinput="onName" />
  </view>
  <view class="field">
    <text class="lbl">{{t.matBrand}}</text>
    <input class="val-input" value="{{brand_spec}}" bindinput="onBrand" />
  </view>
  <!-- round149：采购单位仍可自由填（箱/件/提 这类没有通用换算），但给一排**建议池** chips
       —— 点一下填入，并**自动带出建议换算系数**。
       round151：外面套「输入框 + ▾」——改前是裸 input，真机上看着像"只是显示了个字"，
       用户不知道能改、更不知道有建议池。点 ▾ 可收起/展开 chips。
       ⚠️ 仍不改成纯 picker：picker 选不出「箱/桶/提」，且弹层×键盘在真机上是死结（PITFALLS §6）。 -->
  <view class="field">
    <text class="lbl">{{t.matUnit}}</text>
    <view class="pick-wrap">
      <input class="val-input pick-input" value="{{purchase_unit}}" placeholder="{{t.matUnitDefault}}" bindinput="onUnit" />
      <text class="pick-caret" bindtap="toggleUnitChips">▾</text>
    </view>
    <view class="chip-row" wx:if="{{unitChipsOpen}}">
      <block wx:for="{{unitChips}}" wx:key="*this">
        <view class="chip {{item === purchase_unit ? 'chip-on' : ''}}" data-unit="{{item}}" bindtap="pickUnit">{{item}}</view>
      </block>
    </view>
    <text class="muted">{{t.matUnitHint}}</text>
  </view>
  <view class="field">
    <text class="lbl">{{t.matPrice}}</text>
    <input class="val-input" type="digit" value="{{priceYuan}}" bindinput="onPrice"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- round153：句子式换算系数 —— 「1 斤 = [ 500 ] 克」。
       改前只有一个孤零零写着 500 的框 + 下一行浅底说明，真机上被读成"系统替我算好的结果值"
       ⇒ 老板找不到能下手的地方（实测反馈）。把等式摊开写在控件两侧，中间那个框自然就是待填项。
       ⚠️ 数字仍可手改（saveMaterial 只校验 >0 就原样落库）；手改后 convertTouched 立起，
       后续换单位不再被建议值冲掉（round152）。 -->
  <view class="field">
    <text class="lbl">{{convertLabel || t.matConvert}}</text>
    <view class="conv-wrap">
      <text class="conv-eq">{{convertLeft}}</text>
      <input class="val-input conv-input" type="number" value="{{convert_factor}}" bindinput="onConvert"  adjust-position="{{true}}" cursor-spacing="20" />
      <text class="conv-eq conv-word">{{convBaseWord}}</text>
    </view>
  </view>
  <view class="hint">{{convertHint}}</view>
  <view class="field">
    <text class="lbl">{{t.matYield}}</text>
    <input class="val-input" type="digit" value="{{yield_rate}}" bindinput="onYield"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>

  <!-- 分类（下拉 6 类，采购视角） -->
  <view class="field">
    <text class="lbl">{{t.matCategory}}</text>
    <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategory">
      <view class="picker">{{categoryOptions[categoryIndex].label}}</view>
    </picker>
  </view>

  <!-- 别名（逗号分隔，仅检索） -->
  <view class="field">
    <text class="lbl">{{t.matAliases}}</text>
    <input class="val-input" value="{{aliasesYuan}}" bindinput="onAliases" />
  </view>
  <view class="hint">{{t.matAliasesHint}}</view>

  <!-- 备注 -->
  <view class="field">
    <text class="lbl">{{t.matRemark}}</text>
    <input class="val-input" value="{{remark}}" bindinput="onRemark" />
  </view>

  <view style="height:20rpx;"></view>
  <button class="btn primary" style="margin-top:0;" bindtap="onSave">{{t.save}}</button>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>