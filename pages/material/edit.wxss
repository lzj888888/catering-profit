/* pages/material/edit.wxss —— 原料新增/编辑表单页 */
.val-input { text-align: right; font-size: 30rpx; width: 320rpx; }
.picker { color: #1e3a5f; font-size: 30rpx; min-height: 88rpx; line-height: 88rpx; }
/* round149 采购单位 chips。色值取 app.wxss 头注单源（墨蓝 #1e3a5f / 浅底 #e8eff7）；
   字号 28rpx = 新增字号下界（26rpx 必红）。 */
.chip-row { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip { font-size: 28rpx; padding: 10rpx 22rpx; margin: 0 12rpx 12rpx 0; border-radius: 24rpx; background: #e8eff7; color: #1e3a5f; }
.chip-on { background: #1e3a5f; color: #fff; }

/* round151：采购单位改成「输入框 + ▾」包裹层 —— 箭头让"能选、能改"看得见（真机实测反馈：
   改前是裸 input，老板以为那一格只是显示了个字）。⚠️ 仍保留 input 自由填「箱/桶/提」，
   不改成纯 picker：picker 选不出这些，且弹层×键盘在真机上是死结（PITFALLS §6）。 */
.pick-wrap { display: flex; align-items: center; }
.pick-input { flex: 1; width: auto; }
.pick-caret { flex: none; min-width: 44rpx; margin-left: 12rpx; text-align: center; font-size: 28rpx; color: #1e3a5f; }

/* round153：换算系数句子式组合行「1 斤 = [ 500 ] 克」。
   ⚠️ 选择器带 `.conv-wrap` 前缀提高权重 —— 否则被 app.wxss 的 `.field input{min-width:320rpx}` 压过去，
   输入框会被撑到 320rpx，句子被挤断行。边框/背景继承 app.wxss `.field input`，不另起一套样式。 */
.conv-wrap { display: flex; align-items: center; }
.conv-wrap .conv-input { width: 180rpx; min-width: 180rpx; text-align: center; }
.conv-eq { flex: none; font-size: 30rpx; color: #4a5b70; }
.conv-word { margin-left: 14rpx; color: #1e3a5f; }
