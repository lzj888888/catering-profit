/* pages/material/edit.wxss —— 原料新增/编辑表单页 */
.val-input { text-align: right; font-size: 30rpx; width: 320rpx; }
.picker { color: #1e3a5f; font-size: 30rpx; min-height: 88rpx; line-height: 88rpx; }
/* round149 采购单位 chips。色值取 app.wxss 头注单源（墨蓝 #1e3a5f / 浅底 #e8eff7）；
   字号 28rpx = 新增字号下界（26rpx 必红）。 */
.chip-row { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip { font-size: 28rpx; padding: 10rpx 22rpx; margin: 0 12rpx 12rpx 0; border-radius: 24rpx; background: #e8eff7; color: #1e3a5f; }
.chip-on { background: #1e3a5f; color: #fff; }
