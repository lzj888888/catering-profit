<view class="form safe-bottom" wx:if="{{!loading}}">
  <!-- round156：连续录入 —— 保存成功后**留在本页**，这条横幅是"存到哪了"的凭证 + 显式返回出口。
       改前每存一道菜就 navigateBack 回列表，录 30 道菜要来回 60 次。 -->
  <view class="saved-bar" wx:if="{{savedName}}">
    <text class="saved-txt">{{t.savedOk}}「{{savedName}}」· {{t.savedHint}}</text>
    <view class="saved-go" bindtap="backToList">{{t.backToList}}</view>
  </view>

  <view class="field">
    <text class="lbl">{{t.dishName}}</text>
    <input class="val-input" value="{{name}}" placeholder="{{t.dishNamePh}}" bindinput="onName" />
  </view>

  <!-- M3.16（批次 C）卡片类型：单品 / 套餐（引用型成本卡）
       R190：提到**名字下面第一步** —— 「是录一道菜，还是组一个套餐」先定，再谈别的；
       选套餐后隐藏「核算模式 / 批量产出 / 菜品模板」（套餐固定按「份」聚合，calc_mode 对其无意义）。 -->
  <view class="field">
    <text class="lbl">{{t.cardTypeLabel}}</text>
    <radio-group class="mode-group" bindchange="onCardType">
      <label class="mode-item"><radio value="1" checked="{{cardType === '1'}}" color="#1e3a5f"/>{{t.cardTypeDish}}</label>
      <label class="mode-item"><radio value="3" checked="{{cardType === '3'}}" color="#1e3a5f"/>{{t.cardTypeCombo}}</label>
    </radio-group>
    <text class="muted">{{t.cardTypeHint}}</text>
  </view>

  <!-- M3.20（批次 B 收尾）从模板新建：一键预填行名/用量/单位，价格全部留空。仅新建态 + 单品。 -->
  <view class="field" wx:if="{{!isEdit && cardType === '1'}}">
    <text class="lbl">{{t.templateFrom}}</text>
    <picker mode="selector" range="{{tplNames}}" value="{{tplPicked}}" bindchange="onPickTemplate">
      <view class="picker">{{tplPicked >= 0 ? tplNames[tplPicked] : t.templatePickPh}}</view>
    </picker>
    <text class="muted">{{t.templateHint}}</text>
  </view>

  <!-- 核算模式（仅单品） -->
  <view class="field" wx:if="{{cardType === '1'}}">
    <text class="lbl">{{t.calcMode}}</text>
    <radio-group class="mode-group" bindchange="onMode">
      <label class="mode-item"><radio value="A" checked="{{calcMode === 'A'}}" color="#1e3a5f"/>{{t.calcModeA}}</label>
      <label class="mode-item"><radio value="B" checked="{{calcMode === 'B'}}" color="#1e3a5f"/>{{t.calcModeB}}</label>
    </radio-group>
  </view>

  <!-- 批量模式：产出份数（仅单品：套餐无批量预制概念） -->
  <view class="field" wx:if="{{cardType === '1' && calcMode === 'B'}}">
    <text class="lbl">{{t.batchOutput}}</text>
    <input class="val-input" type="number" value="{{batchOutput}}" bindinput="onBatch"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>

  <!-- 明细行（录入方式：档案选择 / 临时手工）—— 仅单品 -->
  <block wx:if="{{cardType === '1'}}">
  <view class="line" wx:for="{{lines}}" wx:key="idx">
    <view class="cell2">
      <text class="lbl">{{t.inputType}}</text>
      <!-- round153：红「×」删行按钮原本挂在这一行的最右边 ⇒ 实测被读成"取消临时手工录入"
           （这行本来就是「二选一」，旁边杵个红叉语义打架）。已挪到明细行末尾「删除本行」。 -->
      <radio-group class="mode-group" data-idx="{{index}}" value="{{lines[index].input_type === 2 ? 'manual' : 'archive'}}" bindchange="onLineType">
        <label class="mode-item"><radio value="archive" checked="{{lines[index].input_type !== 2}}" color="#1e3a5f"/>{{t.inputTypeArchive}}</label>
        <label class="mode-item"><radio value="manual" checked="{{lines[index].input_type === 2}}" color="#1e3a5f"/>{{t.inputTypeManual}}</label>
      </radio-group>
    </view>

    <!-- 档案选择行 -->
    <block wx:if="{{lines[index].input_type !== 2}}">
      <view class="cell2">
        <text class="lbl">{{t.material}}</text>
        <!-- round156：原生 `<picker>`（只能滚）→ **独立选择页**（搜索 + 按分类分组）。
             100 个原料在原 picker 里要滚十几屏 ⇒ 换成跳 `pages/material/pick`。
             为什么不用弹层：弹层 × 键盘是死结（PITFALLS §6）。 -->
        <view class="picker" data-idx="{{index}}" bindtap="goPickMaterial">{{lines[index].material_name ? lines[index].material_name : t.material}}</view>
      </view>
      <!-- round149：把「买」与「用」的换算摆在眼前（采购价 ÷ 换算系数 ÷ 出成率 ⇒ 净料元/克），
           老板不用去档案页心算，也不会把「按斤买」的价当成「按克」的价填。 -->
      <view class="muted spec-hint">{{lines[index].spec_hint || t.matSpecHintEmpty}}</view>
      <!-- round151：跨计量族提示（只提示、不拦截）。参考产品在同样情形下静默算出 ¥6,000,000 无告警 -->
      <view class="warn-hint" wx:if="{{lines[index].unit_warn}}">{{lines[index].unit_warn}}</view>
      <!-- round153：用量 + 单位**同一排** —— 数字与单位是同一个量的两半，拆两行会视觉断句。 -->
      <view class="cell2">
        <text class="lbl">{{t.qty}}</text>
        <view class="qty-wrap">
          <input class="val-input qty-input" type="digit" value="{{lines[index].qty}}" data-idx="{{index}}" bindinput="onQty"  adjust-position="{{true}}" cursor-spacing="20" />
          <picker mode="selector" range="{{qtyUnits}}" data-idx="{{index}}" bindchange="onQtyUnit">
            <view class="picker unit-pick">{{lines[index].qty_unit || baseUnit}}</view>
          </picker>
        </view>
      </view>
    </block>

    <!-- 临时手工录入行（仅本卡生效） -->
    <block wx:else>
      <view class="cell2">
        <text class="lbl">{{t.manualName}}</text>
        <input class="val-input" value="{{lines[index].material_name}}" placeholder="{{t.manualNamePh}}" data-idx="{{index}}" bindinput="onManualName" />
      </view>
      <!-- round151：单价 = 「输入框 + 单位 ▾」并排（对齐参考产品实测布局）。
           改前单位写死在 label 里（「单价（元/克）」）⇒ 老板买 6 元/斤的肉，得先心算 0.012 才敢填。 -->
      <!-- round153：单价 = 「[数字框] ｜ 元/斤」—— 单位格带独立浅底 + 左侧留白，
           把"这是单位、不是数字的一部分"在视觉上切开。改前二者紧挨着，实测被连读成
           「50 克」（老板在疑惑自己是不是在填 50 克的数量）。
           ⚠️ 显示用 t.cur 拼，不写死货币符；单位值仍由 price_unit 驱动。 -->
      <view class="cell2">
        <text class="lbl">{{t.manualUnitPrice}}</text>
        <view class="price-wrap">
          <input class="val-input price-input" type="digit" value="{{lines[index].unit_price_yuan}}" data-idx="{{index}}" bindinput="onManualPrice"  adjust-position="{{true}}" cursor-spacing="20" />
          <picker mode="selector" range="{{priceUnits}}" data-idx="{{index}}" bindchange="onManualPriceUnit">
            <view class="picker unit-pick price-unit">{{t.cur}}/{{lines[index].price_unit || baseUnit}}</view>
          </picker>
        </view>
      </view>
      <view class="cell2">
        <text class="lbl">{{t.manualYield}}</text>
        <input class="val-input" type="digit" value="{{lines[index].yield_rate}}" data-idx="{{index}}" bindinput="onManualYield"  adjust-position="{{true}}" cursor-spacing="20" />
      </view>
      <!-- round153：用量 + 单位同一排（同上，档案行）。 -->
      <view class="cell2">
        <text class="lbl">{{t.qty}}</text>
        <view class="qty-wrap">
          <input class="val-input qty-input" type="digit" value="{{lines[index].qty}}" data-idx="{{index}}" bindinput="onQty"  adjust-position="{{true}}" cursor-spacing="20" />
          <picker mode="selector" range="{{qtyUnits}}" data-idx="{{index}}" bindchange="onQtyUnit">
            <view class="picker unit-pick">{{lines[index].qty_unit || baseUnit}}</view>
          </picker>
        </view>
      </view>
    </block>

    <!-- round150（M3.14）组件类型：**只影响规格试算，不影响这份成本**。
         为什么必须有它：半份菜的「调料不减半」（否则没味）、耗材也不减半 ⇒ 分类错了半份成本就错。 -->
    <view class="kind-row">
      <text class="kind-lbl">{{t.lineKindTitle}}</text>
      <block wx:for="{{kindChips}}" wx:for-item="kc" wx:for-index="ki" wx:key="key">
        <text class="kind-chip {{lines[index].line_kind === kc.key ? 'kind-on' : ''}}" data-idx="{{index}}" data-kind="{{kc.key}}" bindtap="pickKind">{{kc.label}}</text>
      </block>
    </view>
    <!-- round153：删行操作放到**整行的最末尾**并写明语义 —— 它是"删掉这一整行原料"，
         不是"取消某个选项"（改前是行首那排单选旁边的红叉，语义打架）。
         误触保护：只有这行**已经填了东西**才弹确认，空行直接删（见 edit.js::delLine）。 -->
    <view class="del-row" data-idx="{{index}}" bindtap="delLine">{{t.delLine}}</view>
  </view>
  <view class="muted" style="margin:-8rpx 0 12rpx 4rpx;">{{t.qtyUnitHint}}</view>
  <view class="muted" style="margin:-4rpx 0 12rpx 4rpx;">{{t.lineKindHint}}</view>
  <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="addLine">{{t.addLine}}</button>
  <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="goMaterial">{{t.materialArchive}}</button>
  </block>

  <!-- M3.16（批次 C）套餐：子卡选择行（选卡 + 份数）+ 三个显示数 -->
  <block wx:if="{{cardType === '3'}}">
    <view class="combo-box">
      <view class="spec-title">{{t.comboSubCardTitle}}</view>
      <view class="muted" wx:if="{{subCardOptions.length === 0}}">{{t.comboPickEmpty}}</view>
      <block wx:for="{{comboLines}}" wx:for-item="cl" wx:for-index="ci" wx:key="index">
        <view class="combo-row">
          <picker mode="selector" range="{{subCardOptions}}" range-key="label" data-idx="{{ci}}" bindchange="onComboSubCard">
            <view class="picker combo-pick">{{comboLines[ci].sub_card_name || t.comboSubCardPh}}</view>
          </picker>
          <view class="qty-wrap">
            <input class="val-input qty-input" type="number" value="{{comboLines[ci].qty}}" data-idx="{{ci}}" bindinput="onComboQty" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit-pick">{{t.comboSubCardQty}}</text>
          </view>
          <view class="del-row" data-idx="{{ci}}" bindtap="delComboLine">{{t.delLine}}</view>
        </view>
      </block>
      <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="addComboLine">{{t.comboAddSubCard}}</button>

      <!-- 三个显示数：顾客省 / 我少赚 / 成本结构 -->
      <block wx:if="{{comboInsight}}">
        <view class="muted">{{t.comboInsightCustomerSave}}：{{t.cur}}{{comboInsight.customer_save_yuan}}</view>
        <view class="muted" wx:if="{{comboInsight.merchant_lose_neg}}" style="color:#e74c3c;">{{t.comboInsightMerchantLose}}：{{t.cur}}{{comboInsight.merchant_lose_yuan}}（{{t.comboInsightLoseWarn}}）</view>
        <view class="muted" wx:else>{{t.comboInsightMerchantLose}}：{{t.cur}}{{comboInsight.merchant_lose_yuan}}</view>
        <view class="muted">{{t.comboInsightCostShare}}：</view>
        <block wx:for="{{comboInsight.cost_share}}" wx:key="name">
          <view class="muted" style="padding-left:24rpx;">{{item.name}} {{item.share_pct}}%</view>
        </block>
      </block>
    </view>
  </block>

  <!-- 分类 / 标签（后端 cardDoc 已有字段，本次真正传上去） -->
  <!-- 分类：**自由填写**（火锅的锅底/荤菜/素菜、营销栏目"大口吃肉"都选不出来 ⇒ 不能只给下拉）。
       组件用 input + chips 而非 picker 弹层：弹层×键盘在真机上是死结（见 PITFALLS §6）。 -->
  <view class="line">
    <text class="lbl">{{t.category}}</text>
    <input class="cat-input" value="{{category}}" placeholder="{{t.categoryPh}}" bindinput="onCategoryInput" adjust-position="{{true}}" cursor-spacing="20" />
    <view class="chip-row" wx:if="{{catChips.length}}">
      <block wx:for="{{catChips}}" wx:key="*this">
        <view class="chip {{item === category ? 'chip-on' : ''}}" data-cat="{{item}}" bindtap="pickCat">{{item}}</view>
      </block>
    </view>
    <text class="muted">{{t.categoryHint}}</text>
  </view>
  <view class="field">
    <text class="lbl">{{t.tags}}</text>
    <input class="val-input" value="{{tags}}" placeholder="{{t.tagsPh}}" bindinput="onTags" />
    <text class="muted">{{t.tagsHint}}</text>
  </view>

  <!-- 成本参数 -->
  <view class="field">
    <text class="lbl">{{t.lossRate}}</text>
    <input class="val-input" type="digit" value="{{lossRate}}" bindinput="onLoss"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <view class="field">
    <text class="lbl">{{t.auxAmount}}</text>
    <input class="val-input" type="digit" value="{{auxYuan}}" bindinput="onAux"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <view class="field">
    <text class="lbl">{{t.price}}</text>
    <input class="val-input" type="digit" value="{{priceYuan}}" bindinput="onPrice"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <view class="field">
    <text class="lbl">{{t.activityPrice}}</text>
    <input class="val-input" type="digit" value="{{activityPriceYuan}}" bindinput="onActivityPrice"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- R234/J4f：本句 ≥18 字 ⇒ 折叠（完整清点口径下补漏）。 -->
  <view class="hint-fold">
    <view class="hint-fold-head" data-key="ceActPriceHint" bindtap="onToggleHintFold">
      <text class="hint-fold-guide">{{hintFold.ceActPriceHint ? t.hintFoldHide : t.hintFoldShow}}</text>
      <text class="hint-fold-arrow">{{hintFold.ceActPriceHint ? '▾' : '▸'}}</text>
    </view>
    <view class="hint-fold-body" wx:if="{{hintFold.ceActPriceHint}}">{{t.activityPriceHint}}</view>
  </view>

  <!-- 反算售价（R190：单品 / 套餐**都能用** —— 此前套餐点了没反应，规范 v1.2 早定了套餐反算口径） -->
  <view class="reverse">
    <view class="cell">
      <text class="lbl">{{t.targetMargin}}</text>
      <input class="val-input" type="digit" value="{{targetMargin}}" bindinput="onTargetMargin"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="reverseCalc">{{t.reverseTitle}}</button>
    <button class="btn-small" style="min-height:88rpx;margin-left:12rpx;" wx:if="{{reversePriceFen > 0}}" bindtap="applyReverse">{{t.reverseApply}}</button>
    <view class="muted" wx:if="{{reversePriceFen > 0}}">{{t.reverseResult}}：{{t.cur}}{{reverseResultPreview}}</view>
    <view class="muted" wx:if="{{previewCostFen > 0}}">{{t.totalCost}}：<text style="color:#1e3a5f;">{{t.cur}}{{previewCost}}</text></view>
  </view>

  <!-- M3.37（R190）团购到手试算：
       🔴 佣金基数 = **顾客实付的团购价**（原价 188 / 团购价 88 ⇒ 按 88 抽，不是按 188）；
       费率店家自己填、**无默认值**（行业常见 6% 只作 placeholder，R128 同族）。 -->
  <view class="reverse">
    <view class="spec-title">{{t.grouponTitle}}</view>
    <text class="muted">{{t.grouponHint}}</text>
    <view class="cell">
      <text class="lbl">{{t.grouponPrice}}</text>
      <input class="val-input" type="digit" value="{{grouponPriceYuan}}" placeholder="{{t.grouponPricePh}}" bindinput="onGrouponPrice" adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="cell">
      <text class="lbl">{{t.grouponRate}}</text>
      <input class="val-input" type="digit" value="{{grouponRate}}" placeholder="{{t.grouponRatePh}}" bindinput="onGrouponRate" adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="cell">
      <text class="lbl">{{t.grouponPromo}}</text>
      <input class="val-input" type="digit" value="{{grouponPromoYuan}}" bindinput="onGrouponPromo" adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="calcGroupon">{{t.grouponCalc}}</button>
    <block wx:if="{{grouponView}}">
      <view class="muted">{{t.grouponCommission}}：{{t.cur}}{{grouponView.commission}}</view>
      <view class="muted">{{t.grouponNet}}：{{t.cur}}{{grouponView.net}}（{{grouponView.netRate}}%）</view>
      <view class="muted">{{t.grouponProfit}}：{{t.cur}}{{grouponView.profit}}（{{grouponView.profitRate}}%）</view>
      <view class="muted" wx:if="{{grouponView.hasDine && grouponView.vsDineNeg}}" style="color:#e74c3c;">{{t.grouponVsDine}}：{{t.cur}}{{grouponView.vsDine}}</view>
    </block>
  </view>

  <!-- round150（M3.15）规格（大小份）：成本按组件类型缩放后**单独试算**。
       ⚠️ 页面**不抄系数**（系数单源在服务端 SPEC_PRESETS）—— 只送规格键 + 售价，
       试算结果由云端返回（含它是用哪套系数算的）。主成本口径完全不受影响。
       ⚠️ 套餐（引用型卡）无规格概念 ⇒ 仅单品显示。 -->
  <view class="spec-box" wx:if="{{cardType === '1'}}">
    <view class="spec-title">{{t.specTitle}}</view>
    <view class="muted">{{t.specHint}}</view>
    <block wx:for="{{specRows}}" wx:for-item="sp" wx:for-index="si" wx:key="spec_key">
      <view class="spec-row">
        <view class="spec-head">
          <text class="spec-name {{sp.enabled ? 'spec-on' : ''}}" data-spec="{{sp.spec_key}}" bindtap="toggleSpec">{{sp.name}}</text>
          <text class="muted">{{sp.enabled ? t.specEnable : ''}}</text>
        </view>
        <block wx:if="{{sp.enabled}}">
          <view class="cell2">
            <text class="lbl">{{t.specPriceLabel}}<text wx:if="{{sp.spec_key === 'per100g'}}">（元/{{t.specPer100gUnit}}）</text></text>
            <input class="val-input" type="digit" value="{{sp.priceYuan}}" data-spec="{{sp.spec_key}}" bindinput="onSpecPrice"  adjust-position="{{true}}" cursor-spacing="20" />
          </view>
          <view class="muted" wx:if="{{sp.spec_key === 'per100g'}}">{{t.specPer100gNote}}</view>
        </block>
      </view>
    </block>
    <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="calcSpecs">{{t.specCalc}}</button>
    <block wx:for="{{specRows}}" wx:for-item="sp" wx:for-index="si" wx:key="spec_key">
      <view class="spec-res" wx:if="{{sp.enabled && sp.result}}">
        <view class="spec-res-name">{{sp.result.name}}</view>
        <view class="muted">{{t.specCostLabel}}：<text style="color:#1e3a5f;">{{t.cur}}{{sp.result.costYuan}}</text></view>
        <view class="muted" wx:if="{{sp.result.price_fen > 0}}">{{t.specMarginLabel}}：{{sp.result.marginPct}}%</view>
        <view class="muted" wx:if="{{sp.result.suggestYuan}}">{{t.specSuggestLabel}}：{{t.cur}}{{sp.result.suggestYuan}}
          <text class="spec-apply" data-spec="{{sp.spec_key}}" bindtap="useSpecSuggest">（{{t.reverseApply}}）</text>
        </view>
      </view>
    </block>
  </view>

  <view style="height:20rpx;"></view>
  <button class="btn primary" style="margin-top:0;" bindtap="onSave">{{t.save}}</button>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>