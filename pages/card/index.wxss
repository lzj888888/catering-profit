/* pages/card/index.wxss —— M3 成本卡列表 */
.row-ops { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; gap: 8rpx; flex-wrap: wrap; }
.row-ops .btn-small { margin-top: 0; }
.ops-row { display: flex; align-items: center; }
.toolbar { display: flex; align-items: center; gap: 12rpx; margin: 16rpx 0; flex-wrap: wrap; }
.tool-btn { margin-top: 0; }
.batch-bar { display: flex; justify-content: space-between; align-items: center; background: #e8eff7; border-radius: 12rpx; padding: 16rpx 24rpx; margin-bottom: 12rpx; }
.batch-bar .btn-small { margin-top: 0; }
.card-title checkbox { margin-right: 12rpx; }
/* round156：置顶标记 —— 与「核算模式」标签同排，用主色实底区分。
   排序把置顶项排到了最前，界面就必须说清"为什么它在前面"，否则看起来还是乱的。 */
.tag-pin { background: #1e3a5f; color: #fff; margin-left: 12rpx; }
