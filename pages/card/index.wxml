<view class="container safe-bottom">
  <view class="hint">{{t.hintAlways}}</view>

  <!-- R191：顶部只留「找东西」+「新增」。
       跳转按钮（原料库 / 外卖 / 对账）全部撤走 —— 已由 pages/m3/hub 枢纽页承接。
       🔴 为什么必须**先建枢纽页再撤按钮**：直接撤 = 把入口删掉，用户到不了那三块。 -->
  <view class="top-row">
    <view class="inp top-inp"><input value="{{keyword}}" placeholder="{{t.searchPh}}" bindinput="onKeyword" /></view>
    <button class="btn primary top-add" bindtap="goAdd">{{t.addCard}}</button>
  </view>

  <view class="toolbar">
    <picker mode="selector" range="{{marginOptions}}" range-key="label" bindchange="onMarginFilter">
      <view class="tool-btn">{{t.filterMargin}}：{{marginLabel || t.marginAll}}</view>
    </picker>
    <picker mode="selector" range="{{categoryOptions}}" range-key="label" bindchange="onCategoryFilter">
      <view class="tool-btn">{{t.filterCategory}}：{{categoryLabel || t.marginAll}}</view>
    </picker>
    <picker mode="selector" range="{{tagOptions}}" range-key="label" bindchange="onTagFilter">
      <view class="tool-btn">{{t.filterTags}}：{{tagLabel || t.marginAll}}</view>
    </picker>
  </view>

  <!-- 结果计数：筛选后必须回报"找到了多少"，否则看着像没数据；批量同步降级为文字链 -->
  <view class="meta-row">
    <text class="muted">{{t.countPrefix}}{{list.length}}{{t.countSuffix}}</text>
    <text class="link" wx:if="{{!selectMode}}" bindtap="onBatchSyncEnter">{{t.batchSync}}</text>
    <text class="link" wx:if="{{selectMode}}" bindtap="onBatchSyncCancel">{{t.cancel}}</text>
  </view>

  <view wx:if="{{selectMode}}" class="batch-bar">
    <text class="muted">{{t.selectSync}}</text>
    <button class="btn-small" bindtap="onBatchSyncRun">{{t.batchSync}}</button>
  </view>

  <!-- 左侧色条区隔类型（色值走 app.wxss 的 .stripe-*，本页只给边框形态） -->
  <view class="card2 {{item.card_type === 3 ? 'stripe-combo' : 'stripe-dish'}}" wx:for="{{list}}" wx:key="card_code" bindtap="{{selectMode ? 'onSelect' : 'goEdit'}}" data-code="{{item.card_code}}">
    <view class="card-head">
      <view class="card-title card-title-flex">
        <checkbox wx:if="{{selectMode}}" checked="{{selected[item.card_code]}}" data-code="{{item.card_code}}" catchtap="onSelect" />
        {{item.name}}
        <!-- round156：置顶标记（排序会把它们排到最前，但必须"看得出为什么在前面"） -->
        <text class="tag tag-pin" wx:if="{{item.pinned}}">{{t.pinTag}}</text>
        <text class="tag">{{item.calc_mode === 'A' ? t.calcModeA : t.calcModeB}}</text>
        <!-- M3.16（批次 C）：套餐标记 -->
        <text class="tag" wx:if="{{item.card_type === 3}}">{{t.cardTypeCombo}}</text>
      </view>
      <!-- 🔴 R192：此处**不再放「⋯」** —— 收纳过度被判「功能丢了」（李老师 2026-10-03）。
           高频操作下移到 ops-mini 行并**可见**；标题行只留名字 + 标签，扫读更干净。 -->
    </view>
    <!-- M3.16 套餐：我少赚为负 ⇒ 红字提示「这个套餐在拉低你的毛利」 -->
    <view class="muted" wx:if="{{item.card_type === 3 && item.combo_lose_neg}}" style="color:#e74c3c;font-size:28rpx;">{{t.comboInsightLoseWarn}}</view>
    <!-- R191：成本 / 毛利 / 版本 三行压一行 ⇒ 一屏能放的卡数翻倍 -->
    <view class="cell-inline">
      <text class="lbl">{{t.totalCost}}</text>
      <text class="val">{{t.cur}}{{item.total_cost}}</text>
      <text class="dot">·</text>
      <text class="lbl">{{t.grossMargin}}</text>
      <text class="val" style="color:{{item.margin === null ? '#999' : (item.margin >= 60 ? '#22a06b' : (item.margin >= 40 ? '#b45309' : '#e74c3c'))}};">{{item.margin === null ? '—' : (item.margin) + '%'}}</text>
      <text class="dot">·</text>
      <text class="lbl">{{t.version}} {{item.version}}</text>
    </view>

    <!-- 🔴 R192：操作行 —— 「历史版本」「同步最新价」**必须看得见**。
         R191 把 5 个按钮全收进「⋯」⇒ 李老师反馈「最重要的东西丢了」。
         教训：藏起来的功能 = 没有的功能。⇒ 高频两项常驻，⋯ 只收低频/破坏性（置顶 / 复制 / 删除）。
         ⚠️ 三个控件**同一行**（R191 反馈"每个按钮占一行"的根因是块级堆叠，不是按钮本身）。
         ⚠️ 尺寸一律 ≥88rpx（触控硬红线，绝不缩）。 -->
    <view class="ops-mini" wx:if="{{!selectMode}}">
      <button class="btn-small ghost ops-btn" catchtap="goVersion" data-code="{{item.card_code}}">{{t.viewVersion}}</button>
      <button class="btn-small ghost ops-btn" catchtap="onSync" data-code="{{item.card_code}}">{{t.syncShort}}</button>
      <view class="more round" catchtap="onMore" data-code="{{item.card_code}}">⋯</view>
    </view>
  </view>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">{{t.empty}}</view>
  <view wx:if="{{loading}}" class="muted" style="text-align:center;padding:40rpx;">{{t.loading}}</view>

  <view class="ops-row">
    <button class="btn ghost" style="flex:1;margin-top:24rpx;" bindtap="onExport">{{t.export}}</button>
  </view>
</view>
