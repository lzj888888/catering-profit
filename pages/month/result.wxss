/* pages/month/result.wxss —— M1 结果展示页（继承 app.wxss 共享组件） */
.expire-banner { background: #fef3c7; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.expire-ops { display: flex; gap: 16rpx; margin-top: 12rpx; }
.expire-ops .btn-small { flex: 1; }

/* D1：下钻明细面板 */
.drill-head { border-bottom: 1rpx solid #f0f0f0; }
.drill-caret { color: #ff6b35; font-size: 28rpx; }
.drill-body { padding: 12rpx 0 16rpx; }
.drill-row { margin-bottom: 12rpx; }
.drill-gname { font-size: 28rpx; font-weight: 600; color: #333; display: flex; justify-content: space-between; }
.drill-gamt { color: #222; font-weight: 600; }
.drill-sub { display: flex; justify-content: space-between; padding: 6rpx 0 0 16rpx; font-size: 28rpx; color: #666; }
.drill-samt { color: #444; }
