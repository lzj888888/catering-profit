/* pages/month/input.wxss —— M1 收入/费用/消耗录入页 */
.val-input { text-align: right; font-size: 32rpx; width: 320rpx;
  padding: 14rpx 18rpx; border: 2rpx solid #cfdae8; border-radius: 10rpx; background: #fff; }
/* ===== round109（李老师真机）：板块一级区隔 =====
   原话：「整体流程其实很明朗了，可以从头到尾，把主关键词放大，比如收入一个板块、费用一个板块，
   或者用什么方式把每一个板块稍微区隔一下，这样看起来清爽明了」。
   根因（实读样式，不是猜）：一级板块标题（.sec = 收入 / 费用 / 核算方式）原本 30rpx/700，
   与二级标题（.g-label 30rpx/600、.cm-sub 30rpx/600）**同字号、只差 100 字重**
   ⇒ 扫一屏看不出谁归谁，"收入一块费用一块"没有视觉断点。
   方案（对比图拍板）：
     ① 字号 30→40rpx、字重 700→800 —— 与二级标题拉开**量级**，不是只加粗；
     ② 左侧 8rpx 墨蓝渐变竖条（色值取 app.wxss 头部单源：上 #2a4e7c → 下 #162c49）；
     ③ 上方 1rpx 分隔线 + 上间距 28→44rpx —— 三块之间给明确断点。
   ⚠️ 不引入 ①②③ 编号：本页「核算方式」段内已用 ① 食材消耗 / ② 一次性投入，两处编号会打架。
   ⚠️ 只改本页（input.wxss 覆盖全局 .sec）；app.wxss 里的全局 .sec 不动，别的页面照旧。 */
.sec {
  position: relative;
  font-size: 40rpx; font-weight: 800; color: #1e3a5f;
  margin: 44rpx 8rpx 16rpx; padding: 22rpx 0 0 24rpx;
  border-top: 1rpx solid #e3eaf2;
}
/* 左侧渐变竖条：色值取 app.wxss 头部单源（上 #2a4e7c → 下 #162c49），不新造色。 */
.sec::before {
  content: ''; position: absolute; left: 0; top: 28rpx;
  width: 8rpx; height: 36rpx; border-radius: 4rpx;
  background: linear-gradient(180deg, #2a4e7c 0%, #162c49 100%);
}

/* A2：大类组（收入/费用二级细项） */
.group { background: #fff; border-radius: 12rpx; margin-bottom: 16rpx; padding: 8rpx 24rpx; }
.group-head { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; }
.g-label { font-size: 30rpx; font-weight: 600; color: #222; }
.g-toggle { font-size: 28rpx; color: #1e3a5f; }
/* 2026-09-20 改两行：行①细项名 + ×；行②金额（整行宽、带边框）
   原一行三控件时金额框仅 220rpx，点中间数字易误删、边框不明显 —— 李老师真机反馈。 */
.sub-block { padding: 14rpx 0; border-top: 1rpx solid #f5f5f5; }
.sub-line1 { display: flex; align-items: center; gap: 10rpx; }
.sub-item-inp {
  flex: 1; min-width: 0; font-size: 30rpx; color: #222;
  padding: 14rpx 18rpx; background: #f7f9fc; border-radius: 10rpx;
}
/* 预设细项名（不可改）：与可编辑细项同字号同内边距，只是没有输入框底色。
   ⚠️ 别删这条 —— 少了它，固定名与可编辑名会左右错位（2026-09-21）。 */
.sub-item-fixed { flex: 1; min-width: 0; font-size: 30rpx; color: #222; padding: 14rpx 18rpx; }
/* ⚠️ AD 规范（ad-gates G2 硬守）：可点元素 min-height ≥ 88rpx —— **不可下调**。
   2026-09-21 李老师反馈「删除键太大、占地」⇒ 收窄 width + 去掉红底方块：
   视觉上只剩一个 × 字符（不占视觉面积），但**点击热区仍是 88rpx**。
   ⚠️ 守卫只看 min-height 不看 width，所以「视觉小 / 热区够」两者可兼得；
      真把 min-height 调小会让门禁 77/77 转红。 */
.btn-del {
  flex: 0 0 auto; width: 72rpx; min-height: 88rpx; height: 88rpx; line-height: 84rpx;
  padding: 0; margin: 0; font-size: 30rpx; color: #c0392b; background: none;
}
.btn-del::after { display: none; }         /* 去掉小程序 button 默认边框 */
.sub-line2 { display: flex; align-items: center; gap: 14rpx; margin-top: 12rpx; }
.sub-amt-lbl { flex: 0 0 auto; font-size: 28rpx; color: #6b7a8d; }
.sub-line2 .val-input {
  flex: 1; width: auto; text-align: right; font-size: 34rpx;
  padding: 16rpx 20rpx; border: 2rpx solid #cfdae8; border-radius: 10rpx; background: #fff;
}
.group-ops { padding: 8rpx 0 16rpx; }
/* round102：展开态底部的「还没加的有：…」只读提示（点击直开预设面板） */
.preset-hint { margin: 4rpx 0 0; }
.group-ops .btn-small { margin-top: 0; }

/* R85 · 外卖段（规范 §A.11） */
/* 2026-09-22 改两行：行① 字段名 + 粘贴（右端）；行② 金额整行宽。
   原一行三控件时金额框实测仅 181.7px（375 屏 / 容器 327px），李老师真机反馈「金额框预留过小、粘贴框预留过大」。
   ⚠️ 同族病第 3 例：.sub-block(wxss:11, 09-20)、.dine-item(wxml:70, 09-21) 已因同一问题改两行
      —— 新增录入区**不要再写「标签+输入框+按钮」一行三控件**。 */
.tw-detail-row { border-top: 1rpx solid #f5f5f5; padding: 12rpx 0; }
.tw-plat-name { font-size: 30rpx; font-weight: 600; color: #222; margin-bottom: 8rpx; }
.tw-fields { display: flex; flex-direction: column; gap: 8rpx; }
.tw-field { display: flex; flex-direction: column; gap: 4rpx; }
.tw-field-head { display: flex; align-items: center; justify-content: space-between; }
.tw-field-lbl { flex: 1 1 auto; min-width: 0; font-size: 28rpx; color: #555; }
.tw-field .val-input { flex: 1 1 auto; width: auto; font-size: 34rpx; }
/* 粘贴＝轻量按钮：去掉描边与白底重心（视觉不再抢金额框），但**点击热区仍守 AD 规范 ≥88rpx，不可下调** */
.paste-btn { flex: 0 0 auto; min-height: 88rpx; height: 88rpx; line-height: 88rpx; margin: 0; padding: 0 10rpx; font-size: 28rpx; background: #eef3fa; color: #1e3a5f; border: 0; border-radius: 8rpx; }
.paste-btn::after { display: none; }
.tw-subtotal { text-align: right; font-size: 28rpx; color: #888; margin-top: 6rpx; }
/* round109：外卖**折叠态**摘要 —— 折叠时只读「各平台已填金额 + 合计」，点标题行才展开录入。
   （接的是原本那个"假箭头"：标题行的 ▾/▸ 一直有，但内容块压根不读 expanded —— 点了只翻符号。） */
.tw-fold { border-top: 1rpx solid #f5f5f5; padding: 12rpx 0 4rpx; }
.tw-fold-row { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; }
.tw-fold-name { font-size: 28rpx; color: #555; }
.tw-fold-amt { font-size: 30rpx; font-weight: 600; color: #1e3a5f; }
.tw-fold-empty { font-size: 28rpx; color: #8a97a6; padding: 8rpx 0; line-height: 1.6; }
.tw-rec { background: #f7f8fa; border-radius: 12rpx; padding: 16rpx; margin-top: 12rpx; }
.tw-rec-field { display: flex; align-items: center; gap: 10rpx; }
.tw-rec-hint { font-size: 28rpx; color: #888; margin-top: 8rpx; line-height: 1.5; }
.tw-rec-msg { font-size: 28rpx; color: #b45309; background: #fef3c7; border-radius: 8rpx; padding: 10rpx 14rpx; margin-top: 10rpx; line-height: 1.5; }

/* R85 · 费用侧营销项「取数路径」标注 */
.exp-note { font-size: 28rpx; color: #999; padding: 2rpx 0 6rpx 20rpx; line-height: 1.5; }
.exp-note.promo { color: #b45309; }
.promo-path { font-weight: 600; }
.promo-hint { font-size: 28rpx; color: #b45309; margin-top: 4rpx; }

/* R85 · 粘贴面板 */
/* round107：inset 简写（四向归一）在部分 WebView 内核不被 WXSS 支持 ⇒ 遮罩丢失定位（同 amortize.wxss 的 .mask）。
   一律改用四向展开写法。 */
.paste-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,.45); z-index: 99; display: flex; align-items: flex-end; }
.paste-sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx); box-sizing: border-box; }
.paste-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.paste-area { width: 100%; min-height: 200rpx; background: #f7f8fa; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; font-size: 28rpx; }

/* T4b（round97）：预设细项选择面板 —— 复用 paste-mask / paste-sheet 外壳，只加清单本身 */
.preset-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 8rpx 0 4rpx; }
.preset-item { padding: 16rpx 24rpx; background: #f2f4f8; border-radius: 12rpx; font-size: 28rpx; color: #1e3a5f; }
.preset-item.custom { width: 100%; text-align: center; background: #eaf0f8; }

/* T1（round97）· 营销段「分平台佣金小计」（只回显不入库） */
.mk-plat { margin: 8rpx 0 4rpx; padding: 16rpx 20rpx; background: #f2f4f8; border-radius: 12rpx; }
.mk-plat-title { font-size: 28rpx; color: #1e3a5f; font-weight: 600; }
.mk-plat-row { display: flex; align-items: center; margin-top: 10rpx; }
.mk-plat-name { flex: 0 0 160rpx; font-size: 28rpx; color: #1e3a5f; }
.mk-plat-amt { flex: 1 1 auto; min-width: 0; }
.mk-plat-sum { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 28rpx; color: #1e3a5f; }
.mk-plat-sum-val { font-weight: 600; }
.paste-ops { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.paste-ops .btn-small { margin-top: 0; }
.paste-ops .primary-btn { background: linear-gradient(135deg, #2a4e7c 0%, #162c49 100%); color: #fff; }
/* ⚠️ 勿用旧橘黄（app.wxss 头部已声明「旧橘黄已全量下线」，2026-09-20 墨蓝主题 v2）；
   R85 曾误引入一次 ⇒ 由 tools/check_theme_color.js（R115）守。注释里也不写色值字面，免绊倒守卫。 */

/* ===== E2（批次 8c）：填写口径折叠块 + 每类口径句 ===== */
.fill-guide {
  margin: 16rpx 24rpx 8rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fafafa;
  overflow: hidden;
}
.fill-guide-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}
.fg-title { font-size: 28rpx; color: #555; }
.fg-toggle { font-size: 28rpx; color: #999; }
.fill-guide-body {
  border-top: 1rpx solid #ececec;
  padding: 8rpx 24rpx 16rpx;
  background: #fff;
}
.fg-line { font-size: 28rpx; color: #777; line-height: 1.6; padding: 6rpx 0; }
/* 2026-09-21 李老师反馈：口径句原样展开太占地方 ⇒ 收进折叠块，默认只留一行引导语。
   ⚠️ 类名仍叫 .scope（ad-gates G1 按它查字号 ≥28rpx，改名会让那条守卫静默失守）。 */
.scope-fold { padding: 0 0 6rpx; }
.scope-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 8rpx; }
.scope-guide { font-size: 28rpx; color: #1e3a5f; }
.scope-arrow { font-size: 28rpx; color: #1e3a5f; }
.scope { font-size: 28rpx; color: #6b7a8d; line-height: 1.6; padding: 12rpx 16rpx;
  background: #f5f8fc; border-radius: 10rpx; margin: 0 0 12rpx; }

/* ===== 2026-09-21 堂食录入模式（快速 / 分项 · 严格互斥 · 方案 A）=====
   ⚠️ 方案 A：选「分项」时总额由各渠道相加自动算出、不可手填 ⇒ 单一数据源，无需校验。
   ⚠️ 预设渠道名是**固定标签不可编辑**（省出的宽度全给金额框），只有「+ 添加渠道」的自定义行才可编辑。 */
.dm-wrap { padding: 4rpx 0 8rpx; }
.dm-sec { font-size: 28rpx; color: #6b7a8d; padding: 0 0 10rpx 8rpx; }
.dm-opts { display: flex; gap: 12rpx; }
.dm-opt {
  flex: 1; min-width: 0; padding: 16rpx 14rpx; border-radius: 12rpx;
  border: 2rpx solid #e3eaf2; background: #fff;
}
.dm-opt.on { border: 2rpx solid #1e3a5f; background: #e8eff7; }
.dm-h { font-size: 28rpx; font-weight: 600; color: #1e3a5f; }
.dm-d { font-size: 28rpx; color: #6b7a8d; margin-top: 6rpx; }

/* 快速录入：一个总额框 */
.dine-fast { padding: 12rpx 0; border-top: 1rpx solid #f5f5f5; }
.dine-fast-line { display: flex; align-items: center; gap: 14rpx; }
.dine-fast-inp { flex: 1; width: auto; font-size: 34rpx; }

/* 分项渠道：两行（行①渠道名+× / 行②金额整行宽）
   ⚠️ 不要退回「一行三列」：渠道名最长 9 字（个人/单位挂账消费），与金额框抢宽度会被挤成竖排；
      两行后金额框 ≈ 满宽，也解决「输入框太窄、点中间数字容易误删」。 */
.dine-item { padding: 10rpx 0; border-top: 1rpx solid #f5f5f5; }
.dine-line1 { display: flex; align-items: center; }
.dine-name {
  flex: 1 1 auto; min-width: 0; font-size: 30rpx; color: #222; line-height: 1.5;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.dine-name.inp { padding: 12rpx 16rpx; background: #f7f9fc; border-radius: 10rpx; }
.dine-note { font-size: 28rpx; color: #8a97a6; line-height: 1.5; padding: 2rpx 0 6rpx 2rpx; }
.dine-line2 { display: flex; align-items: center; margin-top: 8rpx; }
.dine-line2 .val-input { flex: 1 1 auto; width: auto; text-align: right; font-size: 34rpx; }
.dine-amt { flex: 1 1 auto; width: auto; font-size: 34rpx; text-align: right; }

/* 合计：由各渠道相加自动算出，不可手填 */
.dine-sum {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 8rpx 6rpx; margin-top: 8rpx; border-top: 2rpx solid #e3eaf2;
}
.dine-sum-lbl { font-size: 28rpx; color: #6b7a8d; }
.dine-sum-val { font-size: 34rpx; font-weight: 600; color: #1e3a5f; }
