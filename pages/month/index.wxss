/* pages/month/index.wxss —— M1 月度经营首页（继承 app.wxss 共享组件） */
.tabs { display: flex; margin: 8rpx 0 20rpx; background: #fff; border-radius: 16rpx; padding: 8rpx; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 30rpx; color: #666; border-radius: 12rpx; }
.tab.active { background: #1e3a5f; color: #fff; font-weight: 700; }
/* 修 5：免费用户仅一个 tab 时不满宽（避免像横幅），双 tab 时保持 flex:1 满宽 */
.tabs.single { display: inline-flex; }
.tabs.single .tab { flex: 0 0 auto; min-width: 220rpx; }
.banner.warn { background: #fef3c7; }
.banner .btn-small { width: 160rpx; }

/* ===== R234/J4e · 行内长提示折叠（句级，与月录入页 / M2 / assetEdit / amortize / takeaway 同形）=====
 * body 底色 #f3f7fb 与全局 `.hint` 同色 ⇒ 折叠前后视觉连贯。
 * 🔴 字号一律 ≥28rpx（AD-G1）、头行 min-height ≥88rpx（AD-G2）。
 * ⚠️ **不套外层白卡**（R234/J3 首版自伤教训）：外层只留间距，否则 body 嵌白卡 = 双层圆角。 */
.hint-fold { padding: 0 0 6rpx; }
.hint-fold-head { display: flex; align-items: center; justify-content: space-between;
  min-height: 88rpx; padding: 14rpx 8rpx; }
.hint-fold-guide { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-arrow { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-body { font-size: 28rpx; color: #4a5b70; line-height: 1.6; padding: 16rpx 20rpx;
  background: #f3f7fb; border-radius: 12rpx; margin: 0 0 12rpx; }
