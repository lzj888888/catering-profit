<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- 归档月只读提示 -->
  <view class="archived-bar" wx:if="{{isArchive}}">{{t.archiveReadonly}}</view>

  <!-- 本月摊销合计（分期摊销的当月影响） -->
  <view class="card2">
    <view class="muted">{{t.monthTotal}}</view>
    <view class="result-num">{{t.cur}}{{totalYuan}}</view>
  </view>

  <!-- 口径说明：两类投入都能记 -->
  <view class="hint scope-hint">{{t.scopeHint}}</view>

  <!-- ===== ① 本月一次算清（mode='lump'）===== -->
  <view class="cm-sub">{{t.lumpSectionTitle}}</view>
  <view class="card2">
    <view class="hint">{{t.lumpSectionHint}}</view>

    <view class="lump-row" wx:for="{{lumps}}" wx:key="item_id" wx:for-item="it">
      <view class="lump-name">{{it.name}}</view>
      <view class="lump-amt">{{t.cur}}{{it.amountYuan}}</view>
      <button class="btn-small ghost" catchtap="onEditLump" data-item="{{it}}">{{t.edit}}</button>
    </view>

    <view class="empty-inline" wx:if="{{lumps.length === 0}}">{{t.lumpEmpty}}</view>

    <view class="cell" wx:if="{{lumps.length > 0}}">
      <text class="lbl">{{t.lumpSumLabel}}</text>
      <text class="val" style="color:#1e3a5f;">{{t.cur}}{{lumpTotalYuan}}</text>
    </view>

    <view class="row-ops">
      <button class="btn-small ghost" catchtap="onAddLump">+ {{t.lumpAdd}}</button>
    </view>
  </view>

  <!-- ===== ② 分期摊销（mode='amort'）===== -->
  <view class="cm-sub">{{t.amortSectionTitle}}</view>

  <view class="switch-row">
    <view class="lbl2">{{t.amortSwitchLabel}}</view>
    <switch checked="{{amortizeOn}}" color="#1e3a5f" bindchange="onToggleAmortize" />
  </view>
  <view class="hint">{{t.amortSwitchHint}}</view>

  <view class="card2" wx:for="{{groups}}" wx:key="key" wx:for-item="g">
    <view class="card-title" bindtap="onToggleGroup" data-group="{{g.key}}">
      {{g.name}}
      <text class="tag" wx:if="{{g.multi}}">{{t.batchTotalPrefix}}{{g.count}}{{t.batchTotalSuffix}}</text>
      <text class="tag" wx:if="{{!g.multi && g.batches[0].terminate_month}}">{{t.terminateNow}}</text>
    </view>

    <!-- 组合计（单笔时即为该资产本身） -->
    <view class="cell">
      <text class="lbl">{{t.groupValueLabel}}</text>
      <text class="val">{{t.cur}}{{g.valueYuan}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.monthAmountShort}}</text>
      <text class="val" style="color:#1e3a5f;">{{t.cur}}{{g.monthYuan}}</text>
    </view>

    <!-- round106（F5b）：留存数据（剩余未摊 / 摊完月份）—— 期数与剩余额均由后端引擎算出，前端只格式化 -->
    <view class="prog" wx:if="{{g.progressNote}}">
      <view>{{g.progressNote}}</view>
      <view wx:if="{{g.endNote}}">{{g.endNote}}</view>
    </view>

    <!-- 多笔：展开看每一笔（每笔独立起摊、独立终止） -->
    <view class="batch-head" wx:if="{{g.multi}}" bindtap="onToggleGroup" data-group="{{g.key}}">
      <text class="bh-txt">{{g.expanded ? t.collapseHint : t.expandHint}}</text>
      <text class="bh-arrow">{{g.expanded ? '▾' : '▸'}}</text>
    </view>
    <view class="batch" wx:if="{{g.multi && g.expanded}}" wx:for="{{g.batches}}" wx:key="asset_id" wx:for-item="b">
      <view class="batch-title">
        {{t.batchPrefix}}{{b.batch_seq}}{{t.batchSuffix}}
        <text class="tag" wx:if="{{b.terminate_month}}">{{t.terminateNow}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.value}}</text>
        <text class="val">{{t.cur}}{{b.value}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.startMonth}} / {{t.totalMonths}}</text>
        <text class="val">{{b.start_month}} · {{b.total_months}}{{t.monthUnit}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.monthAmountShort}}</text>
        <text class="val" style="color:#1e3a5f;">{{t.cur}}{{b.amountYuan}}</text>
      </view>
      <!-- round106（F5b）：每一笔各自一行留存数据（多笔组展开后可见） -->
      <view class="prog prog-batch" wx:if="{{b.progressNote}}">
        <view>{{b.progressNote}}</view>
        <view wx:if="{{b.endNote}}">{{b.endNote}}</view>
      </view>
      <view class="row-ops">
        <button class="btn-small ghost" catchtap="onEditAsset" data-asset="{{b}}">{{t.edit}}</button>
        <button class="btn-small ghost" style="color:#e74c3c;border-color:#e74c3c;" catchtap="onTerminate" data-asset="{{b}}">{{t.terminateNow}}</button>
      </view>
    </view>

    <!-- 单笔：明细直接展示 -->
    <block wx:if="{{!g.multi}}">
      <view class="cell">
        <text class="lbl">{{t.startMonth}} / {{t.totalMonths}}</text>
        <text class="val">{{g.batches[0].start_month}} · {{g.batches[0].total_months}}{{t.monthUnit}}</text>
      </view>
      <view class="row-ops">
        <button class="btn-small ghost" catchtap="onEditAsset" data-asset="{{g.batches[0]}}">{{t.edit}}</button>
        <button class="btn-small ghost" style="color:#e74c3c;border-color:#e74c3c;" catchtap="onTerminate" data-asset="{{g.batches[0]}}">{{t.terminateNow}}</button>
      </view>
    </block>

    <!-- H1：同一项支出再投一笔（独立起摊） -->
    <view class="row-ops">
      <button class="btn-small ghost" catchtap="onAppend" data-group="{{g.key}}">+ {{t.appendPurchase}}</button>
    </view>
  </view>

  <view wx:if="{{groups.length === 0}}" class="empty">{{t.empty}}</view>

  <button class="btn primary" bindtap="onAddAmort">{{t.amortAdd}}</button>
</view>

<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
