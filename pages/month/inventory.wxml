<view class="form safe-bottom" wx:if="{{!loading}}">
  <view class="archived-bar" wx:if="{{isArchive}}">
    {{t.archiveReadonly}}<text wx:if="{{inGrace}}"> · {{t.graceNote}}</text>
  </view>

  <view class="field">
    <view class="lbl-col">
      <text class="lbl">{{t.opening}}</text>
      <text class="muted">{{t.openingHint}}</text>
    </view>
    <input class="val-input" type="digit" confirm-type="done" disabled="{{readOnly}}"
      value="{{openingYuan}}" bindinput="onOpening" />
  </view>
  <view class="field">
    <view class="lbl-col">
      <text class="lbl">{{t.purchase}}</text>
      <text class="muted">{{t.purchaseHint}}</text>
    </view>
    <input class="val-input" type="digit" confirm-type="done" disabled="{{readOnly}}"
      value="{{purchaseYuan}}" bindinput="onPurchase" />
  </view>
  <view class="field">
    <view class="lbl-col">
      <text class="lbl">{{t.closing}}</text>
      <text class="muted">{{t.closingHint}}</text>
    </view>
    <input class="val-input" type="digit" confirm-type="done" disabled="{{readOnly}}"
      value="{{closingYuan}}" bindinput="onClosing" />
  </view>

  <view class="hint">{{t.hintFormula}}</view>

  <view style="height:20rpx;"></view>
  <button class="btn primary" style="margin-top:0;" bindtap="onSave" disabled="{{readOnly}}">{{t.save}}</button>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>