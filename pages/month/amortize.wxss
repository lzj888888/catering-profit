/* pages/month/amortize.wxss —— M1「一次性投入」页（本月一次算清清单 + 分期摊销台账） */
.row-ops { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.row-ops .btn-small { margin-top: 0; }

/* ===== round107：底部弹层已整体移除 =====
   原来新增/编辑走「固定定位遮罩 + 底部面板」那套（选择器名就不写了 —— 本仓「注释里不写字面」
   纪律：注释写选择器字面会被守卫当代码扫到）。
   真机截图证明：5 个字段 + 键盘时面板会被键盘整个盖住、输入框浮到卡片上 ⇒ 看不见、存不了。
   表单已搬去 pages/month/assetEdit（独立页），本文件**不再保留任何 fixed 底部弹层样式**。
   ⚠️ 同时纠正 round106 的误判：那次的「透明窗口」**不是**底色问题，主因是遮罩用了 inset 简写 ——
   WXSS 在部分较旧的 WebView 内核上不支持它 ⇒ 整条声明被丢弃 ⇒ position:fixed 四向偏移全为 auto
   ⇒ 遮罩退回文档流静态位置，既没有全屏深色遮罩、面板又叠在白卡片上。
   ⚠️ 全仓同款的只剩 input.wxss 的粘贴遮罩，也已改为四向展开（top/right/bottom/left）。 */

/* ===== H1（批次 8c）：同一资产多次投入 —— 分组明细样式 ===== */
.scope-hint { padding: 0 24rpx 16rpx; }
.batch { border-top: 1rpx dashed #eee; padding-top: 8rpx; margin-top: 4rpx; }
.batch-title { font-size: 28rpx; color: #666; padding: 12rpx 0 4rpx; }
.batch-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0; border-top: 1rpx solid #f0f0f0;
}
.bh-txt { font-size: 28rpx; color: #888; }
.bh-arrow { font-size: 28rpx; color: #999; }

/* ===== round106（F5b）：留存数据行（剩余未摊 / 摊完月份）—— 纯展示，数值全由后端算 ===== */
.prog {
  font-size: 28rpx; color: #4a5b70; background: #f3f7fb; border-radius: 12rpx;
  padding: 14rpx 20rpx; margin-top: 12rpx; line-height: 1.7;
}
.prog .strong { color: #1e3a5f; font-weight: 600; }
.prog-batch { margin-top: 8rpx; }

/* ===== round107：本月一次算清清单 ===== */
.lump-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; gap: 16rpx;
}
.lump-name { flex: 1; font-size: 30rpx; color: #222; }
.lump-amt { font-size: 30rpx; font-weight: 600; color: #222; }
.empty-inline { font-size: 28rpx; color: #999; padding: 20rpx 0; }

/* ===== round109：收尾区 =====
   本页是「月度录入 → 库存盘点 → 一次性投入」的最后一步 ⇒ 填完必须给出明确的下一步，
   不再让人去按手机最上面的返回键一层层退（李老师真机反馈）。
   一条 1rpx 分隔线把「登记区」与「收尾区」分开：上面是记账，下面是「记完了去哪」。 */
.finish-zone { margin-top: 44rpx; padding-top: 28rpx; border-top: 1rpx solid #e3e9f2; }
.finish-hint {
  font-size: 28rpx; color: #4a5b70; background: #f3f7fb; border-radius: 12rpx;
  padding: 16rpx 20rpx; margin-bottom: 20rpx; line-height: 1.6;
}
.finish-zone .btn { margin-top: 16rpx; }
.finish-zone .btn.primary { margin-top: 0; }
