/* pages/takeaway/index.wxss —— M3.17 外卖单均试算页。色沿用主色系 #1e3a5f / #e8eff7，不新增品牌色。 */

/* 顶层 tab（单均测算 / 账单导入） */
.tab-bar { display: flex; background: #eef2f7; border-radius: 12rpx; padding: 6rpx; margin-bottom: 16rpx; }
.tab-item { flex: 1; text-align: center; font-size: 28rpx; color: #6b7a90; min-height: 88rpx; line-height: 88rpx; border-radius: 10rpx; }
.tab-item.on { background: #1e3a5f; color: #fff; font-weight: 600; }
.hint { font-size: 28rpx; color: #6b7a90; line-height: 1.5; margin: 8rpx 4rpx 16rpx; }

/* 口径切换 */
.mode-switch { display: flex; background: #eef2f7; border-radius: 12rpx; padding: 6rpx; margin-bottom: 10rpx; }
.mode-tab { flex: 1; text-align: center; font-size: 28rpx; color: #6b7a90; min-height: 88rpx; line-height: 88rpx; border-radius: 10rpx; }
.mode-tab.on { background: #1e3a5f; color: #fff; font-weight: 600; }
.mode-desc { font-size: 28rpx; color: #6b7a90; line-height: 1.5; margin: 6rpx 4rpx 12rpx; }
.base-note { font-size: 28rpx; color: #b45309; line-height: 1.5; margin: 0 4rpx 16rpx; padding: 10rpx 16rpx; background: #fdf6ec; border-radius: 10rpx; }

/* 区块标题 */
.sec { font-size: 30rpx; color: #1e3a5f; font-weight: 600; margin: 24rpx 0 10rpx; }

/* 行（菜品 / 包材） */
.row { display: flex; align-items: center; margin-bottom: 10rpx; }
.pick-grow { flex: 1; }
.pick { padding: 0 24rpx; background: #fff; border: 1rpx solid #e8eff7; border-radius: 10rpx; color: #1e3a5f; font-size: 28rpx; min-height: 88rpx; line-height: 88rpx; }
.qty-input, .price-input { width: 160rpx; margin-left: 12rpx; padding: 0 16rpx; background: #fff; border: 1rpx solid #e8eff7; border-radius: 10rpx; min-height: 88rpx; font-size: 28rpx; }
.del { margin-left: 12rpx; color: #e74c3c; font-size: 40rpx; min-width: 88rpx; min-height: 88rpx; line-height: 88rpx; text-align: center; }

/* 字段 */
.field { display: flex; align-items: center; margin-bottom: 12rpx; flex-wrap: wrap; }
.lbl { font-size: 28rpx; color: #1e3a5f; width: 220rpx; flex-shrink: 0; }
.val-input { flex: 1; padding: 0 20rpx; background: #fff; border: 1rpx solid #e8eff7; border-radius: 10rpx; min-height: 88rpx; font-size: 28rpx; }
.mode-group { display: flex; }
.mode-item { margin-right: 24rpx; font-size: 28rpx; color: #333; display: flex; align-items: center; }
.payer-pick { padding: 0 24rpx; background: #e8eff7; border-radius: 10rpx; color: #1e3a5f; font-size: 28rpx; min-height: 88rpx; line-height: 88rpx; margin-left: 12rpx; }

/* 结果 */
.cell { display: flex; justify-content: space-between; padding: 12rpx 4rpx; border-bottom: 1rpx solid #eef2f7; }
.val { font-size: 30rpx; color: #1e3a5f; }
.val.strong { font-weight: 700; }
.warn { font-size: 28rpx; color: #e74c3c; line-height: 1.5; margin: 10rpx 4rpx; }

.btn { margin-top: 12rpx; }

/* ===== R234/J4d · 行内长提示折叠（句级，与月录入页 / M2 / assetEdit / amortize 同形）=====
 * 本页折 2 处（importPickHint 22 字 / importShapeCHint 20 字）；
 * `importPickPlatformHint`（17 字）**故意保持平铺** —— 它是确认按钮紧下方的操作提示。
 * body 底色 #f3f7fb 与全局 `.hint` 同色 ⇒ 折叠前后视觉连贯。
 * 🔴 字号一律 ≥28rpx（AD-G1）、头行 min-height ≥88rpx（AD-G2）。 */
.hint-fold { padding: 0 0 6rpx; }
.hint-fold-head { display: flex; align-items: center; justify-content: space-between;
  min-height: 88rpx; padding: 14rpx 8rpx; }
.hint-fold-guide { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-arrow { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-body { font-size: 28rpx; color: #4a5b70; line-height: 1.6; padding: 16rpx 20rpx;
  background: #f3f7fb; border-radius: 12rpx; margin: 0 0 12rpx; }
