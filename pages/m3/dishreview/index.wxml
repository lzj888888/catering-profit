<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- 付费未开通态：只留提示 + 事后复盘口径（点返回后 onShow 会重试） -->
  <block wx:if="{{locked}}">
    <view class="card2">
      <view class="muted">{{t.reviewAfterFact}}</view>
    </view>
  </block>

  <block wx:else>
    <!-- 事后复盘口径（v1.2 §M3.35 原文，落 card 命名空间） -->
    <view class="afterfact">{{t.reviewAfterFact}}</view>

    <!-- ===== R301：统计期间（**必须先于任何数字**）=====
         为什么放最上面：在此之前本榜是**跨月累计**却按"当前月"呈现 ⇒ 老板会以为"这道菜这个月卖过"
         （真样本就是 7 天表，"一段"冒充"整月"）。**期间口径决定下面每个数怎么读**，不能埋在末尾。
         · 月份选择用系统 `<picker fields="month">`（零新术语、零新数据源）
         · 期间文案来自云端回的 `range`（`rangeText`），**前端不猜** -->
    <view class="field">
      <text class="lbl">{{t.reviewMonthPick}}</text>
      <picker mode="date" fields="month" value="{{month}}" bindchange="onMonth">
        <view class="val-input">{{month}}</view>
      </picker>
    </view>
    <view class="muted">{{rangeText}}</view>

    <!-- ===== R299：数据截断的**可见降级** =====
         云函数出参 `truncated`（`dataAdapter.js::listAll` 的契约要求"必须透传到出参、可见降级"），
         复盘 / 成本卡 / 账单三次读取任一命中 ⇒ 屏幕上看到的可能不全。
         🔴 放在最上方：这是"整页数字还准不准"的前提，不能折进「更多分析」里。 -->
    <view class="muted warn-line" wx:if="{{truncated}}">{{t.dataTruncated}}</view>

    <!-- ===== R281 O2：顶部红色待办条（未匹配菜品）=====
         原来未匹配区埋在 21 行堂食榜 + 一长串清单之后 ⇒ 老板进来看不到"还有活没干"。
         ⇒ 顶部红条 + 「去挂」直达（滚到下方未匹配区）；详情仍在下方，**不删只提提示**。 -->
    <view class="todo-bar" wx:if="{{unmatched.length}}">
      <text class="todo-txt">{{t.reviewTodoPre}}{{unmatched.length}}{{t.reviewTodoSuf}}</text>
      <button class="btn-small todo-btn" bindtap="gotoUnmatched">{{t.reviewTodoBtn}}</button>
    </view>

    <!-- ===== R281 O2：「更多分析」折叠入口（覆盖率 / C 档 / 自助餐 / 阈值）=====
         🔴 只**折层级、不删**（守 R264/R272）；入口行上仍带覆盖率摘要 ⇒ 折了也不算"藏了"。 -->
    <view class="more-bar" bindtap="toggleMore">
      <text class="more-t">{{t.reviewMoreTitle}}</text>
      <text class="more-sum" wx:if="{{coverageCount}}">{{coverageText}}</text>
      <text class="more-act">{{moreOpen ? t.reviewMoreClose : t.reviewMoreOpen}}</text>
    </view>
    <block wx:if="{{moreOpen}}">

    <!-- ===== R264：覆盖率明示 =====
         真机实证：外卖 51 道菜、店里 3 张成本卡 ⇒ 界面只说「未匹配 51 道」，
         用户看不到"已经算出几道"、也无从判断"先建哪道最划算" ⇒ 面对长清单无从下手。
         🔴 覆盖率按**金额**算（不按行数：0 元的口味询问类 SKU 会把分母稀释）。 -->
    <block wx:if="{{coverageCount}}">
      <view class="afterfact">{{coverageText}}</view>
      <view class="muted">{{t.reviewCoverageHint}}</view>
    </block>

    <!-- ===== R272：覆盖率 C 档（制作类 + 自助 / 剔除零售转售）=====
         为什么单列：A 档分母含零售转售（烟/酒/饮料）与自助餐，会稀释真实烹饪业务的覆盖率；
         C 档分母 = 制作类 + 自助餐营收、剔除零售转售，才是"你会做的菜的毛利覆盖了多少"。 -->
    <block wx:if="{{coverageCount}}">
      <view class="afterfact">{{coverageCText}}</view>
      <view class="muted">{{t.reviewCoverageCHint}}</view>
    </block>

    <!-- ===== R272c：自助餐（快餐=随便吃）人均食材成本 · 上移到顶部，避免在 21 行堂食榜 + 244 行未匹配的长页面里被埋 =====
         自助餐不建单品成本卡，改走「人均食材成本 = 本月自助线食材消耗 ÷ 售出份数」口径；
         消耗总额由店铺设置录入（单位：分），未填则提示去设置页填写。 -->
    <block wx:if="{{buffet_meals > 0}}">
      <view class="section-title highlight">{{t.reviewBuffetTitle}}</view>
      <view class="card2">
        <view class="cell"><text class="lbl">{{t.reviewBuffetRevenue}}</text><text class="val">{{t.cur}}{{buffet_revenueText}}</text></view>
        <view class="cell"><text class="lbl">{{t.reviewBuffetMeals}}</text><text class="val">{{buffet_meals}} 份</text></view>
        <view class="cell"><text class="lbl">{{t.reviewBuffetPerCapitaPrice}}</text><text class="val">{{t.cur}}{{buffet_perCapitaPriceText}}</text></view>
        <view class="cell"><text class="lbl">{{t.reviewBuffetPerCapitaCost}}</text>
          <text class="val" wx:if="{{buffet_hasCostInput}}">{{t.cur}}{{buffet_perCapitaCostText}}</text>
          <text class="val" wx:else>{{t.reviewBuffetNoCost}}</text>
        </view>
        <view class="cell" wx:if="{{buffet_hasCostInput}}"><text class="lbl">{{t.reviewBuffetGrossMargin}}</text><text class="val">{{buffet_grossMarginText}}</text></view>
        <!-- R272b：行业基准带（网上平均数据）-->
        <view class="subtitle">{{t.reviewBuffetBenchTitle}}</view>
        <view class="cell"><text class="lbl">{{t.reviewBuffetBenchLow}}</text><text class="val">{{t.cur}}{{buffet_benchLowText}} <text class="muted">（成本率{{buffet_rateLowPct}}%）</text></text></view>
        <view class="cell"><text class="lbl">{{t.reviewBuffetBenchMid}}</text><text class="val">{{t.cur}}{{buffet_benchMidText}} <text class="muted">（成本率{{buffet_rateMidPct}}%）</text></text></view>
        <view class="cell"><text class="lbl">{{t.reviewBuffetBenchHigh}}</text><text class="val">{{t.cur}}{{buffet_benchHighText}} <text class="muted">（成本率{{buffet_rateHighPct}}%）</text></text></view>
        <view class="cell" wx:if="{{buffet_hasCostInput && buffet_actualRateText}}"><text class="lbl">{{t.reviewBuffetActual}}</text><text class="val {{buffet_flagClass}}">{{buffet_actualRateText}}</text></view>
      </view>
      <view class="muted">{{t.reviewBuffetHint}}</view>
      <view class="muted">{{t.reviewBuffetBenchHint}}</view>
    </block>

    <!-- 毛利率标红阈值（用户自定义，默认占位值，非警戒线） -->
    <view class="field">
      <text class="lbl">{{t.reviewThreshold}}</text>
      <input class="val-input" type="digit" value="{{thresholdInput}}" bindinput="onThreshold" adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="muted">{{t.reviewThresholdHint}}</view>
    <!-- ▲ 关闭「更多分析」折叠区（覆盖率 / C 档 / 自助餐 / 阈值 都在这里面，只是折起来） -->
    </block>

    <!-- 空态 -->
    <view class="card2" wx:if="{{empty}}">
      <view class="muted">{{t.reviewEmpty}}</view>
    </view>

    <!-- 堂食榜（两来源分开呈现；外卖空态另列，不混榜） -->
    <view class="section-title">{{t.reviewDineIn}} · {{t.reviewRankTitle}}</view>
    <view class="card2" wx:if="{{dineIn.length}}">
      <view class="row head">
        <text class="c-name">{{t.reviewDish}}</text>
        <text class="c-qty">{{t.reviewQty}}</text>
        <text class="c-num">{{t.reviewRevenue}}</text>
        <text class="c-num">{{t.reviewGross}}</text>
        <text class="c-num">{{t.reviewMargin}}</text>
      </view>
      <view class="row {{item.below ? 'below' : ''}}" wx:for="{{dineIn}}" wx:key="name">
        <view class="c-name">
          <text>{{item.name}}</text>
          <text class="snap" wx:if="{{item.snapshotNote}}">{{item.snapshotNote}}</text>
        </view>
        <text class="c-qty">{{item.qty}}</text>
        <text class="c-num">{{t.cur}}{{item.revenueText}}</text>
        <text class="c-num">{{t.cur}}{{item.grossText}}</text>
        <text class="c-num">{{item.marginText}}</text>
      </view>
    </view>

    <!-- 汇总（**全渠道合计** = 堂食 + 各外卖平台，见 cloudfunctions/getDishReview/index.js:101 mergeTotals）
         🔴 R299-Q（豆包评审采纳）：这张卡此前**没有标题**，而它夹在「堂食榜」与「外卖榜」之间
         ⇒ 老板极易读成「堂食小计」（读错一次就误判堂食盈利）。术语 `reviewTotals` 自引入起
         从未被渲染（死键）⇒ 借它补上标题（零新增键），并把口径写进键值「汇总（堂食+外卖）」。
         ⚠️ 卡片**位置**下移到外卖榜之后属**版式调整**（需老板拍板）⇒ 本轮只补标题、不动位置（已登记）。 -->
    <view class="section-title">{{t.reviewTotals}}</view>
    <view class="card2" wx:if="{{totals}}">
      <view class="cell"><text class="lbl">{{t.reviewTotalQty}}</text><text class="val">{{totals.qty}}</text></view>
      <view class="cell"><text class="lbl">{{t.reviewTotalRevenue}}</text><text class="val">{{t.cur}}{{totals.revenueText}}</text></view>
      <view class="cell"><text class="lbl">{{t.reviewTotalCost}}</text><text class="val">{{t.cur}}{{totals.costText}}</text></view>
      <view class="cell"><text class="lbl">{{t.reviewTotalGross}}</text><text class="val">{{t.cur}}{{totals.grossText}}</text></view>
    </view>

    <!-- R272c：自助餐块已上移到覆盖率 C 档之后（页面顶部），此处不再重复渲染。 -->

    <!-- 外卖榜（v1.7 实态：按平台分块；无数据 ⇒ 空态，红线 18 不默认 0） -->
    <block wx:if="{{takeaway}}">
      <!-- R259：外卖毛利率的**口径说明**（李老师 2026-10-10 裁定：指标名保持「毛利率」，
           不叫"食材毛利率" ⇒ 防误导靠**同屏把差在哪讲清**，不靠改名）。
           为什么必须有：复盘毛利 = 销量表金额 − 销量×卡内成本，而**外卖侧那个金额是
           平台侧金额（顾客实付/商品原价）、不是商家到手** ⇒ 佣金与配送被算进了毛利
           （实测锚点：规范 v1.2 §1.1 外卖到手率仅 66.67%）⇒ 不说明就是让用户拿虚高数定价。
           ⚠️ 只放外卖区块：堂食侧那个金额就是售价，`售价 − 食材成本` 叫毛利率没毛病。 -->
      <view class="muted">{{t.reviewTakeawayMarginNote}}</view>
      <block wx:for="{{takeaway}}" wx:key="platform">
        <view class="section-title">{{t.reviewTakeaway}} · {{item.platformName}}</view>
        <view class="card2" wx:if="{{item.ranked.length}}">
          <view class="row head">
            <text class="c-name">{{t.reviewDish}}</text>
            <text class="c-qty">{{t.reviewQty}}</text>
            <text class="c-num">{{t.reviewRevenue}}</text>
            <text class="c-num">{{t.reviewGross}}</text>
            <text class="c-num">{{t.reviewMargin}}</text>
          </view>
          <view class="row {{it.below ? 'below' : ''}}" wx:for="{{item.ranked}}" wx:for-item="it" wx:key="name">
            <view class="c-name">
              <text>{{it.name}}</text>
              <text class="snap" wx:if="{{it.snapshotNote}}">{{it.snapshotNote}}</text>
              <text class="zero" wx:if="{{it.zeroAmount}}">{{t.reviewZeroAmount}}</text>
            </view>
            <text class="c-qty">{{it.qty}}</text>
            <text class="c-num">{{t.cur}}{{it.revenueText}}</text>
            <text class="c-num">{{t.cur}}{{it.grossText}}</text>
            <text class="c-num">{{it.marginText}}</text>
          </view>
        </view>
        <!-- 🔴 R251：平台小结（份数 / 营收 / 未匹配项数）+ **空榜成因**。
             此前：① 后端算好的 `totals` **一次都没渲染过** ⇒ 用户看不到「到底导进来多少」；
                   ② `ranked` 为空时本块**只留一个光标题** ⇒ 看着像混进了脏数据。
             成因由 `item.emptyReason` 给出（账单级 / 全未匹配，两种措辞，见 terms.js 注释）。 -->
        <view class="card2">
          <view class="muted" wx:if="{{item.emptyReason}}">{{item.emptyReason}}</view>
          <view class="cell"><text class="lbl">{{t.reviewTotalQty}}</text><text class="val">{{item.totals.qty}}</text></view>
          <view class="cell"><text class="lbl">{{t.reviewTotalRevenue}}</text><text class="val">{{t.cur}}{{item.totals.revenueText}}</text></view>
          <view class="cell" wx:if="{{item.unmatchedCount}}"><text class="lbl">{{t.reviewUnmatched}}</text><text class="val">{{item.unmatchedCount}}</text></view>
        </view>
      </block>
    </block>
    <block wx:else>
      <view class="section-title">{{t.reviewTakeaway}}</view>
      <view class="card2">
        <view class="muted">{{t.reviewTakeawayEmpty}}</view>
      </view>
    </block>

    <!-- 未匹配菜品（红线 17：不静默归零，单列 + 去映射入口）
         🔴 R281 O2：加 id 作为顶部待办条「去挂」的滚动锚点（不新增页面）。 -->
    <view class="section-title" id="unmatched" wx:if="{{unmatched.length}}">{{t.reviewUnmatched}}</view>
    <view class="card2" wx:if="{{unmatched.length}}">
      <view class="muted">{{t.reviewUnmatchedHint}}</view>
      <!-- ===== R262：**卡不够挂** 的显式引导 =====
           真机实证：店里 3 张成本卡 vs 外卖 51 道菜 ⇒ 每行 picker 只有这 3 张可选。
           界面既没显示"没卡"（cardOptions 非空）、也没提示"卡不够" ⇒ 用户只能盲目关联，
           而**挂错卡 = 食材成本算错**，比"暂时不算"更坏（用户会信那个错数）。
           ⇒ 缺口 > 0 时明说还差几道菜，并给「新建成本卡」入口。 -->
      <block wx:if="{{shortCardGap > 0}}">
        <view class="snap">{{shortCardText}}</view>
        <view class="field-save">
          <button class="btn-small ghost" bindtap="goMap">{{t.reviewGoCard}}</button>
        </view>
      </block>
      <view class="row" wx:for="{{unmatched}}" wx:key="name">
        <view class="c-name">
          <text>{{item.name}}</text>
          <!-- 🔴 R251：来源平台（跨平台合并后否则看不出这菜来自哪）+ 口味询问类 SKU 标记 -->
          <text class="plat" wx:if="{{item.platformText}}">{{item.platformText}}</text>
          <text class="zero" wx:if="{{item.zeroAmount}}">{{t.reviewZeroAmount}}</text>
          <!-- R255：映射**写了却没生效**（挂到的卡被删了 / platform 不匹配）时用户看到的仍是未匹配，
               最容易困惑 ⇒ 把已关联的卡名显示出来，提示"挂过但没生效"。 -->
          <text class="snap" wx:if="{{item.mappedCardName}}">{{t.reviewMapLinked}}{{item.mappedCardName}}</text>
          <!-- R260：批量模式下本机已选（尚未提交）+ "这是建议"标记 -->
          <text class="snap" wx:if="{{batchMode && item.selLabel}}">{{t.reviewMapLinked}}{{item.selLabel}}</text>
          <text class="plat" wx:if="{{batchMode && item.suggestHow}}">{{t.reviewBatchSuggest}}</text>
        </view>
        <text class="c-qty">{{item.qty}}</text>
        <text class="c-num">{{t.cur}}{{item.amountText}}</text>
        <!-- R255：关联到成本卡。用 <picker>（系统选择器，**不触发键盘**）
             ⇒ 避开「弹层 × 键盘 = 死结」；也无需新增页面/弹层。
             R260：批量模式下换成 `onPickLocal` —— **只改本机状态**，
                   不调云函数、也不重载整页（这才是"批量"省下来的东西）。 -->
        <block wx:if="{{batchMode}}">
          <picker wx:if="{{cardOptions.length}}" range="{{cardOptions}}" value="{{item.pickIdx}}"
                  data-idx="{{index}}" bindchange="onPickLocal" disabled="{{batchSaving}}">
            <view class="btn-small ghost">{{item.selLabel || t.reviewMapPick}}</view>
          </picker>
          <view class="del" wx:if="{{item.selCode}}" data-idx="{{index}}" bindtap="onClearLocal">×</view>
        </block>
        <block wx:else>
          <picker wx:if="{{cardOptions.length}}" range="{{cardOptions}}"
                  data-idx="{{index}}" bindchange="onPickCard" disabled="{{mappingBusy}}">
            <view class="btn-small ghost">{{t.reviewMapPick}}</view>
          </picker>
        </block>
        <!-- R264：行内「去建卡」—— 带着这道菜名跳建卡页并预填（免手打，打错字就白建一张）。
             卡不够时（见上方引导）这是**唯一**该点的按钮。 -->
        <button class="btn-small ghost" data-name="{{item.name}}" bindtap="goNewCard">{{t.reviewNewCard}}</button>
      </view>
      <view class="muted" wx:if="{{!cardOptions.length}}">{{t.reviewMapNoCard}}</view>
      <!-- ===== R260：批量关联（规范 v1.9）=====
           「一道菜一次 picker + 选完整页重算」在 51 道外卖菜 / 270 行堂食菜上太慢
           ⇒ 先在本机把选择攒起来，点一次「保存全部关联」再提交（分块 ≤ BATCH_CHUNK）。
           ⚠️ 建议标记（`suggestHow`）只表示"系统按名字猜的预选"，**必须人工核对**：
              归一化匹配会误判（如"来点辣椒?吗"这类口味询问 SKU 本就不该匹配任何菜）。 -->
      <!-- 🔴 R264 P1-B：**卡不够时不再给「批量关联」主按钮**。
           卡数 < 未匹配数 ⇒ 必然有菜挂不上，而批量模式会按名字**猜**一批预选
           ⇒ 猜错的被一次性写进库，成本算错且毛利照常出数（用户会信那个数），
           比"暂时算不出"坏得多 ⇒ 此时只留上方「新建成本卡」一条路。 -->
      <block wx:if="{{cardOptions.length && shortCardGap <= 0}}">
        <view class="field-save">
          <button class="btn-small ghost" bindtap="onToggleBatch" disabled="{{mappingBusy || batchSaving}}">
            {{batchMode ? t.reviewBatchExit : t.reviewBatchEnter}}
          </button>
        </view>
        <block wx:if="{{batchMode}}">
          <view class="muted">{{t.reviewBatchHint}}</view>
          <view class="field-save">
            <button class="btn primary" bindtap="onSaveBatch" disabled="{{batchSaving || !batchCount}}">
              {{t.reviewBatchSave}} · {{batchCount}}
            </button>
          </view>
        </block>
      </block>
      <view class="field-save">
        <button class="btn-small ghost" bindtap="goMap">{{t.reviewGoMap}}</button>
      </view>
    </view>

    <!-- ===== R281 O2：「数据设置」折叠区（已关联 / 已导入账单）=====
         🔴 R255 解除入口、R252 已导入账单清除 **都在里面，只是折起来，不是删掉**；
            首屏因此只剩「未匹配待办条 + 堂食榜 + 外卖榜」，信息密度降下来。 -->
    <view class="more-bar" bindtap="toggleData">
      <text class="more-t">{{t.reviewDataTitle}}</text>
      <text class="more-act">{{dataOpen ? t.reviewMoreClose : t.reviewMoreOpen}}</text>
    </view>
    <block wx:if="{{dataOpen}}">

    <!-- ===== R255：已关联菜品（**解除入口**）=====
         为什么必须有这一块：关联成功后该菜会从上方的未匹配清单里消失（变 ranked），
         若没有独立的解除入口 ⇒ 用户**既改不了也删不掉** ⇒ 挂错一次卡就是死结。
         platform 为空 = 跨所有平台生效 ⇒ 不显示平台名（不为此新增文案）。 -->
    <view class="section-title">{{t.reviewMapTitle}}</view>
    <view class="card2">
      <view class="muted">{{t.reviewMapHint}}</view>
      <view class="muted" wx:if="{{!mappings.length}}">{{t.reviewMapEmpty}}</view>
      <view class="row" wx:for="{{mappings}}" wx:key="dishKey">
        <view class="c-name">
          <text>{{item.dishKey}}</text>
          <text class="plat" wx:if="{{item.platformText}}">{{item.platformText}}</text>
          <text class="snap">{{t.reviewMapLinked}}{{item.cardName}}</text>
        </view>
        <button class="btn-small ghost" data-idx="{{index}}" bindtap="onUnlinkMap"
                disabled="{{mappingBusy}}">{{t.reviewMapUnlink}}</button>
      </view>
    </view>

    <!-- ===== R252：已导入账单（查看 + 清除）=====
         补 R251 报障第 ④ 问的真缺口：`external_sales_daily` 原先只有写入没有删除
         ⇒ 导错了看不见也删不掉。此处列出该店导过的账单（一平台一天一条），可单条或全部清除。 -->
    <view class="section-title">{{t.reviewBillsTitle}}</view>
    <view class="card2">
      <view class="muted">{{t.reviewBillsHint}}</view>

      <view class="muted" wx:if="{{!bills.length}}">{{t.reviewBillsEmpty}}</view>

      <block wx:if="{{bills.length}}">
        <view class="row" wx:for="{{bills}}" wx:key="bill_id">
          <view class="c-name">
            <text>{{item.platformText}}</text>
            <text class="plat">{{item.bizDate}} · {{item.kindText}}</text>
            <text class="plat">{{item.rowCount}}{{t.reviewBillsRows}} · {{item.qtyText}}{{t.reviewBillsQty}} · {{t.cur}}{{item.amountText}}</text>
            <text class="zero" wx:if="{{item.cleared}}">{{t.reviewBillsCleared}}</text>
          </view>
          <button class="btn-small ghost" wx:if="{{!item.cleared}}"
                  data-idx="{{index}}" bindtap="onClearBill" disabled="{{clearing}}">{{t.reviewBillsClear}}</button>
        </view>
        <view class="field-save">
          <button class="btn-small ghost" bindtap="onClearAllBills" disabled="{{clearing}}">{{t.reviewBillsClearAll}}</button>
        </view>
      </block>
    </view>
    <!-- ▲ 关闭「数据设置」折叠区 -->
    </block>
  </block>
</view>
