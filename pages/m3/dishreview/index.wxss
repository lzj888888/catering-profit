/* pages/m3/dishreview/index.wxss —— M3.33 单品毛利复盘页。字号 ≥28rpx、触控 ≥88rpx（AD 门禁）。 */
.afterfact { font-size: 28rpx; color: #776C5E; line-height: 1.6; background: #FFFDF8; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.field { display: flex; align-items: center; margin-bottom: 8rpx; }
.lbl { font-size: 28rpx; color: #1e3a5f; width: 300rpx; flex-shrink: 0; }
.val-input { flex: 1; padding: 0 20rpx; background: #FFFDF8; border: 1rpx solid #F5EBD8; border-radius: 10rpx; min-height: 88rpx; font-size: 28rpx; }
.field-save { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.muted { font-size: 28rpx; color: #776C5E; line-height: 1.5; }

/* R689（M3 优化 A）：四象限 —— 2×2 格子。
 * 配色刻意**中性**（不用红/黄/绿）：四象限只说明"相对你自己店里其他菜的位置"，
 * 不是健康评级 —— 用红色会把"卖得少"渲染成"有危险"，而本项目没有任何行业基准支撑这种判断。
 * 数量用主色 #1e3a5f 突出（老板第一眼要看的是"每类各有几道"）。 */
.quad-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.quad-cell { border: 1rpx solid #F0E9DC; border-radius: 12rpx; padding: 16rpx; background: #FFFDF9; }
.quad-hd { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6rpx; }
.quad-name { font-size: 26rpx; font-weight: 600; color: #3A332B; }
.quad-count { font-size: 32rpx; font-weight: 700; color: #1e3a5f; font-variant-numeric: tabular-nums; }
.quad-hint { font-size: 22rpx; color: #776C5E; margin-bottom: 10rpx; }
.quad-names { font-size: 24rpx; color: #4A4238; line-height: 1.5; }
.quad-nm { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quad-more { display: block; font-size: 22rpx; color: #776C5E; }
.quad-none { color: #8A8073; }
.quad-note { margin-top: 16rpx; font-size: 22rpx; }
/* R299：`.warn-line`（数据截断可见降级）定义在**全局 app.wxss**（多页共用，色值单源），此处不复制第二份。 */
.section-title { font-size: 30rpx; color: #1e3a5f; font-weight: 600; margin: 24rpx 4rpx 12rpx; }
/* R272c：自助餐块上移到顶部，标题高亮便于在长页面一眼看到 */
.section-title.highlight { color: #b8430e; border-left: 8rpx solid #e8743b; padding-left: 16rpx; background: #fff6f0; border-radius: 0 10rpx 10rpx 0; }

/* 排名表：自定义行（不复用全局 .row —— 那是「间隔卡」语义，这里是表行） */
.row { display: flex; align-items: center; padding: 20rpx 8rpx; border-bottom: 1rpx solid #F0E9DC; font-size: 28rpx; }
.row.head { color: #6B6157; font-size: 28rpx; border-bottom: 2rpx solid #F0E9DC; font-weight: 600; }
.c-name { flex: 2.2; min-width: 0; display: flex; flex-direction: column; }
.c-qty { flex: 0.9; text-align: center; }
.c-num { flex: 1.4; text-align: right; }
.below { background: #fdf0ee; }
.below .c-num { color: #c0392b; font-weight: 600; }
.snap { font-size: 28rpx; color: #9A5B00; margin-top: 4rpx; }
.zero { font-size: 28rpx; color: #776C5E; margin-top: 4rpx; }
/* R251：未匹配菜品的「来源平台」标签（跨平台合并后标明出处；中性色，不与 .snap 的告警橙混用） */
.plat { font-size: 28rpx; color: #776C5E; margin-top: 4rpx; }

.cell { display: flex; justify-content: space-between; padding: 12rpx 4rpx; border-bottom: 1rpx solid #F0E9DC; }
.val { font-size: 30rpx; color: #1e3a5f; }
/* R272b：自助餐行业基准带子标题 + 实际成本率标色（偏高=红/偏低=橙）*/
.subtitle { font-size: 28rpx; color: #1e3a5f; font-weight: 600; margin: 12rpx 4rpx 4rpx; }
.val.warn { color: #c0392b; font-weight: 600; }
.val.note { color: #9A5B00; }
/* 🔴 R281 O2：首屏重构 —— 顶部红色待办条 + 两个折叠区入口行
   守本仓 UI 下限：字号 ≥28rpx、按钮触控高度 ≥88rpx；告警红沿用既有 #e74c3c（同 .val.warn），不引入新色。 */
.todo-bar { display: flex; align-items: center; justify-content: space-between; background: #fdecea; border-left: 8rpx solid #e74c3c; border-radius: 8rpx; padding: 16rpx 20rpx; margin: 12rpx 0; }
.todo-txt { flex: 1; font-size: 28rpx; color: #b03024; line-height: 1.5; }
.todo-btn { min-height: 88rpx; line-height: 88rpx; font-size: 28rpx; color: #b03024; background: transparent; padding: 0 12rpx; }
.more-bar { display: flex; align-items: center; padding: 20rpx 4rpx; border-top: 1rpx solid #F0E9DC; border-bottom: 1rpx solid #F0E9DC; margin-top: 12rpx; }
.more-t { font-size: 30rpx; color: #1e3a5f; font-weight: 600; }
.more-sum { flex: 1; margin-left: 16rpx; font-size: 28rpx; color: #776C5E; }
.more-act { font-size: 28rpx; color: #2a4e7c; }

/* ===== R615 M3 决策台：该动哪道菜 =====
   字号与既有列表一致（正文 28rpx / 标题 30rpx），不新增视觉层级、不抢榜单的位置。 */
.dec { background: #FFFDF8; border-radius: 16rpx; padding: 24rpx; margin: 8rpx 0 20rpx; }
.dec-hd { display: flex; flex-direction: column; }
.dec-title { font-size: 30rpx; color: #1e3a5f; font-weight: 600; }
.dec-sub { font-size: 28rpx; color: #776C5E; line-height: 1.5; margin-top: 6rpx; }
.dec-median { font-size: 28rpx; color: #2a4e7c; margin-top: 12rpx; }
.dec-ins { font-size: 28rpx; color: #776C5E; line-height: 1.5; margin-top: 12rpx; }
.dec-row { display: flex; align-items: baseline; padding: 18rpx 0; border-top: 1rpx solid #F0E9DC; }
.dec-kind { font-size: 28rpx; line-height: 1.4; padding: 2rpx 12rpx; border-radius: 8rpx; margin-right: 12rpx; flex-shrink: 0; }
.dec-cut { background: #fdecea; color: #b03024; }
.dec-raise { background: #fff4e5; color: #a8630a; }
.dec-bundle { background: #eef4ff; color: #2a4e7c; }
.dec-push { background: #eaf7ee; color: #1a7d55; }
.dec-name { font-size: 28rpx; color: #1e3a5f; font-weight: 600; margin-right: 12rpx; flex-shrink: 0; }
.dec-text { font-size: 28rpx; color: #6B6157; line-height: 1.5; flex: 1; }
.dec-free { font-size: 28rpx; color: #a8630a; line-height: 1.5; margin-top: 12rpx; }
