<view class="container safe-bottom sb-page">
  <!-- R192：hero 不再是两行小字，而是**整块渐变头图** —— 页面一进来就有主体，不再是"四张白卡飘在灰底上" -->
  <view class="hub-hero">
    <text class="hub-title">{{t.title}}</text>
    <text class="hub-sub">{{t.subtitle}}</text>
  </view>

  <!-- ===== R299：数据截断的**可见降级** =====
       本页「共 N 张」是**精确计数**（`hub.wxml` 计数行），而 `getCostCard` 命中 LIST_TOTAL_CAP
       时会截断 ⇒ 那个数是偏小的精确数（老板会以为卡丢了）。见 utils/dataHealth.js 头注。 -->
  <view class="warn-line" wx:if="{{truncated}}">{{t.dataTruncated}}</view>

  <!-- ===== R263：三步走（回答「能做什么 / 怎么做 / 结果去哪看」）=====
       🔴 必须排在**第一张卡之前**：老板一进来先看到"流程"，再看到"入口"。
       守卫 `check_hub_guide` G4 盯这个位置 —— 挪到卡片后面 = 还是先看到一堆卡 = 没解决懵。 -->
  <view class="hub-flow">
    <text class="hub-flow-t">{{t.flowTitle}}</text>
    <!-- 🔴 R281 O3：三步走**线性化** —— 每步带完成态（✓ / ○），由 hub.js 的三个免费只读接口判定。
         守 G1-1：`wx:for="{{t.flowSteps}}"` 必须保留（守卫据此认定"真渲染了三步走"）。 -->
    <view class="hub-flow-step" wx:for="{{t.flowSteps}}" wx:key="*this">
      <text class="hub-flow-flag {{stepFlags[index] ? 'on' : ''}}">{{stepFlags[index] ? '✓' : '○'}}</text>
      <text class="hub-flow-txt">{{item}}</text>
    </view>
    <!-- 未完成的第一步给直达按钮（老板不用在下面 5 张卡里猜该点哪个）；
         nextStep < 0 = 三步都完成 ⇒ 改显示「都做完了」，不再给按钮。 -->
    <button class="btn primary hub-flow-btn" wx:if="{{nextStep >= 0}}" bindtap="goStep" data-step="{{nextStep}}">{{t.flowBtns[nextStep]}}</button>
    <text class="hub-flow-tip" wx:if="{{nextStep >= 0}}">{{t.flowNextHint}}</text>
    <text class="hub-flow-tip" wx:if="{{nextStep < 0}}">{{t.flowAllDone}}</text>
  </view>

  <!-- 🔴 P0#6：快捷操作 —— 最常用的「建成本卡」做成顶部主按钮，一步到位（空状态已有同等 CTA，故仅在有卡时显示） -->
  <button class="btn primary hub-quick" wx:if="{{cardCount > 0}}" bindtap="goCard">{{t.quickAdd}}</button>

  <!-- ===== R263：空状态（卡数 === 0）—— 只给**一件事**做，不给 5 张卡 =====
       ⚠️ 判据必须是 `cardCount === 0`（真读到 0），**不能**写 `cardCount <= 0`：
          `-1` 是"没读到"（fail-closed 不显示数量），拿它当空状态 ⇒ 网络一抖动就误报"你还没有卡"。
       守卫 G2 盯这个严格相等。 -->
  <view class="hub-empty" wx:if="{{cardCount === 0}}">
    <text class="hub-empty-t">{{t.emptyTitle}}</text>
    <text class="hub-empty-d">{{t.emptyDesc}}</text>
    <button class="btn primary hub-empty-btn" bindtap="goCard">{{t.emptyBtn}}</button>
    <text class="hub-empty-tpl">{{t.emptyTplHint}}</text>
  </view>

  <!-- ===== 第一层：先做（主链路）===== -->
  <view class="hub-sec">{{t.secStart}}</view>

  <view class="hub-card" bindtap="goCard">
    <view class="hub-ico hub-ico-card">{{t.icoCard}}</view>
    <view class="hub-main">
      <text class="hub-name">{{t.cardTitle}}</text>
      <text class="hub-desc">{{t.cardSub}}</text>
      <text class="hub-count" wx:if="{{cardCount >= 0}}">{{t.countPrefix}}{{cardCount}}{{t.countSuffix}}</text>
    </view>
    <view class="hub-go">›</view>
  </view>

  <view class="hub-card" bindtap="goMaterial">
    <view class="hub-ico hub-ico-material">{{t.icoMaterial}}</view>
    <view class="hub-main">
      <text class="hub-name">{{t.materialTitle}}</text>
      <text class="hub-desc">{{t.materialSub}}</text>
    </view>
    <view class="hub-go">›</view>
  </view>

  <!-- ===== 第二层：有成本卡之后（顺序 = 三步走的 ②③：先导入，再看榜，最后进阶对账）===== -->
  <view class="hub-sec">{{t.secAfter}}</view>

  <view class="hub-card" bindtap="goTakeaway">
    <view class="hub-ico hub-ico-takeaway">{{t.icoTakeaway}}</view>
    <view class="hub-main">
      <text class="hub-name">{{t.takeawayTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.takeawaySub}}</text>
    </view>
    <view class="hub-go">›</view>
  </view>

  <view class="hub-card" bindtap="goReview">
    <view class="hub-ico hub-ico-review">{{t.icoReview}}</view>
    <view class="hub-main">
      <text class="hub-name">{{t.reviewTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.reviewSub}}</text>
    </view>
    <view class="hub-go">›</view>
  </view>

  <view class="hub-card" bindtap="goRecon">
    <view class="hub-ico hub-ico-recon">{{t.icoRecon}}</view>
    <view class="hub-main">
      <text class="hub-name">{{t.reconTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.reconSub}}</text>
    </view>
    <view class="hub-go">›</view>
  </view>
</view>
