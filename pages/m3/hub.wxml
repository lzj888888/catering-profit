<view class="container safe-bottom sb-page">
  <!-- R192：hero 不再是两行小字，而是**整块渐变头图** —— 页面一进来就有主体，不再是"四张白卡飘在灰底上" -->
  <view class="hub-hero">
    <text class="hub-title">{{t.title}}</text>
    <text class="hub-sub">{{t.subtitle}}</text>
  </view>

  <!-- ===== R299：数据截断的**可见降级** =====
       本页「共 N 张」是**精确计数**（`hub.wxml` 计数行），而 `getCostCard` 命中 LIST_TOTAL_CAP
       时会截断 ⇒ 那个数是偏小的精确数（老板会以为卡丢了）。见 utils/dataHealth.js 头注。 -->
  <view class="warn-line" wx:if="{{truncated}}">{{t.dataTruncated}}</view>

  <!-- ===== R706：三步走不再是**独立引导块**，而是卡片名称前的**序号徽章** =====
       为什么删（李老师 2026-11-11）：
         原来这里是一整块「三步走」：标题 + 3 行步骤 + 1 个直达按钮 + 1 行提示，
         下面还有一个全局「＋ 新建菜品成本卡」按钮 —— 而它们指向的**正是下面那 8 张卡**
         （① =「进货原料价表」卡、② =「菜品成本毛利」卡、③ =「销量表导入」卡）。
         李老师原话：「它俩功能是一样的对吧」「整篇都是字…上下都是字」。
       ⇒ 引导块 + 快捷按钮全部删除，只保留"第几步 / 做完没有"这一个信息，
         把它压缩成卡名前的 1 个字（`①` 未做 / `✓` 已完成）。
         引导信息一个字没丢，但页面少 7 行字、少 1 个按钮、不再有两套入口。
       🔴 完成态仍由 hub.js 用三个**免费**只读接口判定（getMaterial / getCostCard / getSalesBills），
          fail-closed：读失败 = 未完成（绝不拿"没读到"冒充"已完成"骗老板）。
       ⚠️ 守卫 check_hub_guide G1/G4 已同步改写：现在守的是「步骤徽章必须在第一张卡之前出现」
          + 「页内不许再出现第二套入口」。 -->

  <!-- ===== R263：空状态（卡数 === 0）—— 只给**一件事**做，不给 5 张卡 =====
       ⚠️ 判据必须是 `cardCount === 0`（真读到 0），**不能**写 `cardCount <= 0`：
          `-1` 是"没读到"（fail-closed 不显示数量），拿它当空状态 ⇒ 网络一抖动就误报"你还没有卡"。
       守卫 G2 盯这个严格相等。 -->
  <view class="hub-empty" wx:if="{{cardCount === 0}}">
    <text class="hub-empty-t">{{t.emptyTitle}}</text>
    <text class="hub-empty-d">{{t.emptyDesc}}</text>
    <button class="btn primary hub-empty-btn" bindtap="goCard">{{t.emptyBtn}}</button>
    <text class="hub-empty-tpl">{{t.emptyTplHint}}</text>
  </view>

  <!-- ===== 第一层：先做（主链路）===== -->
  <view class="hub-sec">{{t.secStart}}</view>

  <!-- 🔴 R704（李老师：「现在都是一行一行的」）：单列 8 张卡改**两列宫格** ⇒ 8 行压到 4 行。
       为什么必须配 *Short 而不是复用原长描述：宫格每列内容宽 ≈155px，原描述 25~38 字
       会撑成 3~4 行、同排两张高度对不齐（见 terms 里 cardShort 段注释）。
       ⚠️ 卡片类名**仍是 hub-card，不许加第二个类** ——
          check_hub_guide S2 用精确匹配 hub-card 数卡数（改成多类名会数到 0 ⇒ 误报丢卡）。
          宫格样式靠父容器 `.hub-grid .hub-card` 覆盖，不靠额外类名。
       ⚠️ 宫格里**不写 `.hub-go`「›」**：两列宽度下它只会挤标题，且整张卡可点已经够明显。 -->
  <view class="hub-grid">
    <!-- ① 原料必须先有价，否则后面配料的成本是空的 ⇒ 排在最前 -->
    <view class="hub-card" bindtap="goMaterial" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-material">{{t.icoMaterial}}</view>
      <text class="hub-name"><text class="hub-step {{stepFlags[0] ? 'on' : ''}}">{{stepFlags[0] ? '✓' : '①'}}</text>{{t.materialTitle}}</text>
      <text class="hub-desc">{{t.materialShort}}</text>
    </view>

    <!-- ② 配菜算出成本 -->
    <view class="hub-card" bindtap="goCard" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-card">{{t.icoCard}}</view>
      <text class="hub-name"><text class="hub-step {{stepFlags[1] ? 'on' : ''}}">{{stepFlags[1] ? '✓' : '②'}}</text>{{t.cardTitle}}</text>
      <!-- R706：卡数**始终显示**（未做时是"你现在有几张"，做完后是"这些都在里面"），
           不跟完成态切换 —— 切了会让老板以为数字跳变。fail-closed：-1 不渲染。 -->
      <text class="hub-count" wx:if="{{cardCount >= 0}}">{{t.countPrefix}}{{cardCount}}{{t.countSuffix}}</text>
      <text class="hub-desc">{{t.cardShort}}</text>
    </view>
  </view>

  <view class="hub-sec">{{t.secAfter}}</view>

  <view class="hub-grid">
    <!-- ③ 有成本卡之后才谈得上"销量 × 毛利" -->
    <view class="hub-card" bindtap="goImport" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-import">{{t.icoImport}}</view>
      <text class="hub-name"><text class="hub-step {{stepFlags[2] ? 'on' : ''}}">{{stepFlags[2] ? '✓' : '③'}}</text>{{t.importTitle}}</text>
      <text class="hub-desc">{{t.importShort}}</text>
    </view>

    <view class="hub-card" bindtap="goTakeaway" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-takeaway">{{t.icoTakeaway}}</view>
      <text class="hub-name">{{t.takeawayTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.takeawayShort}}</text>
    </view>

    <view class="hub-card" bindtap="goGroupon" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-groupon">{{t.icoGroupon}}</view>
      <text class="hub-name">{{t.grouponTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.grouponShort}}</text>
    </view>

    <view class="hub-card" bindtap="goReview" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-review">{{t.icoReview}}</view>
      <text class="hub-name">{{t.reviewTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.reviewShort}}</text>
    </view>

    <view class="hub-card" bindtap="goRevenue" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-revenue">{{t.icoRevenue}}</view>
      <text class="hub-name">{{t.revenueTitle}}</text>
      <text class="hub-desc">{{t.revenueShort}}</text>
    </view>

    <view class="hub-card" bindtap="goRecon" hover-class="hub-card-tap">
      <view class="hub-ico hub-ico-recon">{{t.icoRecon}}</view>
      <text class="hub-name">{{t.reconTitle}}</text>
      <text class="hub-pay">{{t.payTag}}</text>
      <text class="hub-desc">{{t.reconShort}}</text>
    </view>
  </view>
</view>
