/* pages/m3/hub.wxss —— M3 枢纽页布局（R191 建页 · R192 重做视觉）
   ⚠️ 色值一律走 app.wxss 的 `.hub-hero / .hub-ico-* / .hub-go`（色值单源），本文件只写布局与中性字色。
   ⚠️ 字号全部 ≥28rpx、卡片触控高度 >88rpx（本仓 AD 硬红线）。
   🔴 R192 教训：只给卡片加一条 8rpx 左侧色条 = 「像括号、前面立体、整体廉价」——
      体积感必须由**整块**（阴影 + 图标块 + 圆角）共同给出，不能靠单条边。 */
.hub-head { padding: 8rpx 8rpx 20rpx; }
.hub-title { display: block; font-size: 36rpx; font-weight: 700; color: #222; }
.hub-sub { display: block; font-size: 28rpx; color: #888; margin-top: 8rpx; }

.hub-card {
  display: flex; align-items: center; background: #fff; border-radius: 20rpx;
  padding: 28rpx 24rpx; margin-bottom: 20rpx;
  /* 🔴 整卡阴影 = 「整块立体」的关键（R191 版缺这一条，只有左边框有色 ⇒ 廉价）
     两层：近距细影压边 + 远距大影托起，比单层更"厚实"（单层浅影看着像浮在纸上的白块） */
  box-shadow: 0 4rpx 8rpx rgba(30, 58, 95, 0.06), 0 12rpx 28rpx rgba(30, 58, 95, 0.12);
}
.hub-main { flex: 1; min-width: 0; }
.hub-name { display: block; font-size: 32rpx; font-weight: 700; color: #222; }
.hub-desc { display: block; font-size: 28rpx; color: #888; margin-top: 8rpx; line-height: 1.5; }
.hub-count { display: block; font-size: 28rpx; color: #1e3a5f; margin-top: 8rpx; }
/* 🔴 P0#6：付费小字徽标（行内小药丸，不抢视觉；仅标在付费域卡上） */
.hub-pay {
  display: inline-block; font-size: 28rpx; line-height: 1; color: #b45309;
  background: #fdf2e0; border: 1rpx solid #f0d9b0; border-radius: 8rpx;
  padding: 4rpx 10rpx; margin-top: 8rpx;
}
/* 🔴 P0#6：快捷操作主按钮（有卡时常驻，一步建卡） */
.hub-quick { margin: 4rpx 0 24rpx; min-height: 88rpx; font-weight: 600; }

/* ===== R263：三步走 / 分层标题 / 空状态 =====
   ⚠️ 字号一律 ≥28rpx（本仓 AD 硬红线）；色值走 app.wxss 的品牌色，本文件只写中性字色。 */
.hub-flow {
  background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 8rpx rgba(30, 58, 95, 0.06), 0 12rpx 28rpx rgba(30, 58, 95, 0.10);
}
.hub-flow-t { display: block; font-size: 28rpx; font-weight: 700; color: #1e3a5f; margin-bottom: 12rpx; }
.hub-flow-step { display: flex; align-items: flex-start; font-size: 28rpx; color: #555; line-height: 1.7; }
/* 🔴 R281 O3：三步走完成态（✓ 已完成 / ○ 待完成）+ 未完成步的直达按钮。
   守本仓 UI 下限：字号 ≥28rpx、按钮触控高度 ≥88rpx；完成态用品牌墨蓝 #1e3a5f，不引入新色。 */
.hub-flow-flag { display: inline-block; width: 44rpx; font-size: 28rpx; color: #9aa5b1; }
.hub-flow-flag.on { color: #1e3a5f; font-weight: 700; }
.hub-flow-txt { flex: 1; font-size: 28rpx; }
.hub-flow-btn { margin-top: 16rpx; min-height: 88rpx; line-height: 88rpx; font-size: 30rpx; }
.hub-flow-tip { display: block; margin-top: 8rpx; font-size: 28rpx; color: #7a8794; }

.hub-sec { display: block; font-size: 28rpx; font-weight: 700; color: #1e3a5f; margin: 8rpx 8rpx 16rpx; }

.hub-empty {
  background: #fff; border-radius: 20rpx; padding: 32rpx 24rpx; margin-bottom: 24rpx;
  border: 2rpx dashed #c8d4e4;
}
.hub-empty-t { display: block; font-size: 32rpx; font-weight: 700; color: #222; }
.hub-empty-d { display: block; font-size: 28rpx; color: #888; margin-top: 10rpx; line-height: 1.6; }
.hub-empty-btn { margin-top: 24rpx; }
/* 🔴 R319：空态里的模板提示 —— 字号必须 ≥28rpx（AD-G1 红线），弱化只靠颜色。 */
.hub-empty-tpl { display: block; font-size: 28rpx; color: #8a97a8; margin-top: 14rpx; }
