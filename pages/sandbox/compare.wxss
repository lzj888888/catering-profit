.page { padding: 24rpx 24rpx 60rpx; background: #f6f7fb; min-height: 100vh; box-sizing: border-box; }
.head { margin: 8rpx 0 20rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1a1a1a; }
.empty { text-align: center; color: #999; font-size: 28rpx; margin: 80rpx 0; }
.card { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.plan-row { display: flex; align-items: center; }
.check { width: 36rpx; height: 36rpx; border: 2rpx solid #bbb; border-radius: 50%; margin-right: 18rpx; }
.check.on { background: #2b7fff; border-color: #2b7fff; }
.pname { font-size: 30rpx; color: #222; flex: 1; }
.pmeta { font-size: 24rpx; color: #e2533a; }
.btn-primary { background: #2b7fff; color: #fff; font-size: 32rpx; border-radius: 12rpx; margin: 16rpx 0; }
.cmp-tbl { display: flex; flex-direction: column; }
.tr { display: flex; border-bottom: 1rpx solid #eee; }
.tr.th { background: #f5f6fa; }
.tr.red .td { color: #e2533a; }
.td { flex: 1; padding: 16rpx 8rpx; font-size: 24rpx; color: #333; text-align: center; }
.tr.th .td { font-weight: 600; color: #222; }
.verdict { margin-top: 20rpx; font-size: 28rpx; color: #07b36b; line-height: 1.5; }
.nav-row { margin-top: 24rpx; }
.btn-ghost { background: #fff; color: #555; font-size: 28rpx; border: 1rpx solid #ddd; border-radius: 12rpx; }
