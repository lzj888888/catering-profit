<view class="container safe-bottom" wx:if="{{!loading}}">

  <!-- M2v1.2：我的方案入口（标题栏右侧常驻按钮） -->
  <view class="entry-bar">
    <text class="entry-link" bindtap="onSaveEntry">{{t.savePlanEntry}}</text>
  </view>

  <!-- M2v1.1 双 Tab：正向测算 / 目标反推（两套输入区独立缓存，切换互不覆盖） -->
  <view class="tab-bar">
    <view class="tab-item {{mode === 'forward' ? 'on' : ''}}" data-mode="forward" bindtap="onTab">{{t.tabForward}}</view>
    <view class="tab-item {{mode === 'reverse' ? 'on' : ''}}" data-mode="reverse" bindtap="onTab">{{t.tabReverse}}</view>
  </view>

  <!-- 0 · 前提：城市层级 + 经营类型（决定下面用的「行业参考带」是哪一套） -->
  <view class="card2">
    <view class="sel-row">
      <text class="sel-lbl">{{t.cityLabel}}</text>
      <picker class="sel-pk" range="{{t.cityTiers}}" range-key="name" value="{{cityIdx}}" bindchange="onCity">
        <view class="sel-val">{{cityName}} ▾</view>
      </picker>
    </view>
    <view class="sel-row">
      <text class="sel-lbl">{{t.bizLabel}}</text>
      <picker class="sel-pk" range="{{t.bizTypes}}" range-key="name" value="{{bizIdx}}" bindchange="onBiz">
        <view class="sel-val">{{bizName}} ▾</view>
      </picker>
    </view>
    <view class="hint">{{t.autoHint}}</view>
    <!-- R193：草稿提示行 + 清空重填（M2 此前算完即丢，退出重进要全部重填） -->
    <view class="draft-bar" wx:if="{{draftRestored || dirty}}">
      <text class="draft-note">{{draftRestored ? t.draftRestored : ''}}</text>
      <button class="btn-small ghost draft-btn" bindtap="onClearDraft">{{t.clearDraft}}</button>
    </view>
  </view>

  <!-- M2v1.3 · L1 小白（必填 5 项：业态预设 / 面积 / 月租金 / 员工数 / 目标利润）-->
  <view class="card2" id="l1l2">
    <view class="sec">{{t.l1Title}}</view>
    <view class="sel-row">
      <text class="sel-lbl">{{t.presetLabel}}</text>
      <picker class="sel-pk" range="{{presetOptions}}" range-key="name" value="{{presetIdx}}" bindchange="onPreset">
        <view class="sel-val">{{presetName || t.presetNone}} ▾</view>
      </picker>
    </view>
    <view class="hint" wx:if="{{presetPicked}}">{{t.presetPickedPre}}{{presetName}}{{t.presetPickedSuf}}</view>
    <view class="row">
      <text class="row-name">{{t.areaLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{areaNum}}" bindinput="onArea" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.areaUnit}}</text>
      </view>
    </view>
    <view class="row">
      <text class="row-name">{{t.rentLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{rentYuan}}" bindinput="onRent" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.yuanUnit}}</text>
      </view>
    </view>
    <view class="row">
      <text class="row-name">{{t.headcountLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="number" value="{{headcountNum}}" bindinput="onHeadcount" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.headcountUnit}}</text>
      </view>
    </view>
    <!-- L2 更多设置 -->
    <view class="fold-toggle" bindtap="onToggleL2">{{t.l2Toggle}}{{showL2 ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{showL2}}">
      <view class="row">
        <text class="row-name">{{t.avgPriceLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{avgPriceYuan}}" bindinput="onAvgPrice" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row">
        <text class="row-name">{{t.laborUnitLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{laborUnitYuan}}" bindinput="onLaborUnit" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
    </view>
    <!-- L3 专业参数 -->
    <view class="fold-toggle" bindtap="onToggleL3">{{t.l3Toggle}}{{showL3 ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{showL3}}" id="l3-pro">
      <view class="row">
        <text class="row-name">{{t.openDaysLabel2}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="number" value="{{openDaysNum}}" bindinput="onOpenDays2" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.dayUnit}}</text>
        </view>
      </view>
      <view class="row">
        <text class="row-name">{{t.pixelEffLabel2}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{pixelEffYuan}}" bindinput="onPixelEff" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row">
        <text class="row-name">{{t.turnLabel2}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{turnNum}}" bindinput="onTurn" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.pctUnit}}</text>
        </view>
      </view>
      <view class="row" wx:for="{{feeRows}}" wx:key="key">
        <text class="row-name">{{item.label}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{item.pct}}" data-key="{{item.key}}" bindinput="onFeePct" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.pctUnit}}</text>
        </view>
      </view>
    </view>
    <!-- 本次测算底层假设（默认折叠可展开） -->
    <view class="fold-toggle" bindtap="onToggleAssumptions">{{t.assumptionsTitle}}{{showAssumptions ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{showAssumptions}}">
      <view class="asm" wx:for="{{presetAssumptions}}" wx:key="label">
        <text class="asm-lbl">{{item.label}}</text>
        <text class="asm-input">{{item.val}}</text>
        <text class="asm-src" wx:if="{{presetPicked}}">{{item.src}}</text>
      </view>
      <view class="hint">{{t.assumptionsHint}}</view>
    </view>
  </view>

  <!-- ⓪ 行业参考区间 + 参考金额（round113 立 · round114 加"预计月营业额"锚点）
       —— 用户"还没填"时就知道该填多少量级；填了预计营业额后，每项再给出参考金额（起点）。
       ⚠️ 参考金额只是灰字起点（在下面各输入框的 placeholder 里），**不会自动填值**。 -->
  <view class="card2" wx:if="{{bands.length}}">
    <view class="sec">{{t.bandPreviewTitle}}</view>
    <view class="hint">{{t.bandPreviewNote}}</view>
    <view class="row">
      <text class="row-name">{{t.expectRevLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" placeholder="{{t.expectRevPh}}" value="{{expectYuan}}" bindinput="onExpect" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">元</text>
      </view>
    </view>
    <view class="hint">{{t.expectRevNote}}</view>
    <view class="bp-grid">
      <view class="bp-item" wx:for="{{bands}}" wx:key="key">
        <text class="bp-name">{{item.name}}</text>
        <view class="bp-right">
          <text class="bp-band">{{item.band}}</text>
          <text class="bp-amt" wx:if="{{item.amt}}">{{t.refAmtCard}}{{item.amt}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ① 开店投入（一次性）—— 按年限摊到每月 -->
  <view class="card2">
    <view class="sec">{{t.secBuild}}</view>
    <view class="hint">{{t.buildNote}}</view>
    <view class="rw" wx:for="{{buildRows}}" wx:key="key">
      <view class="row">
        <text class="row-name">{{item.name}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" placeholder="{{t.buildPh}}" value="{{item.yuan}}" data-idx="{{index}}" bindinput="onBuildYuan" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">元</text>
        </view>
        <view class="row-in-wrap yr">
          <input class="row-in" type="number" value="{{item.years}}" data-idx="{{index}}" bindinput="onBuildYears" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yearsSuffix}}</text>
        </view>
        <text class="row-del" data-idx="{{index}}" bindtap="onDelBuild">{{t.delItem}}</text>
      </view>
      <view class="row-note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view class="add-row" wx:if="{{buildRows.length < 4}}" bindtap="onAddBuild">{{t.addItem}}</view>
  </view>

  <!-- ② 每月固定支出（反推 Tab 下房租行隐藏 —— 房租由目标租金率自动导出，不误填） -->
  <view class="card2">
    <view class="sec">{{t.secFixed}}</view>
    <view class="hint">{{t.fixedNote}}</view>
    <view class="hint" wx:if="{{mode === 'reverse'}}">{{t.revRentHint}}</view>
    <view class="rw" wx:for="{{fixedRows}}" wx:key="key" wx:if="{{mode === 'forward' || item.key !== 'rent'}}">
      <view class="row">
        <text class="row-name">{{item.name}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" placeholder="{{item.ph}}" value="{{item.yuan}}" data-idx="{{index}}" bindinput="onFixedYuan" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">元</text>
        </view>
        <text class="row-del" data-idx="{{index}}" bindtap="onDelFixed">{{t.delItem}}</text>
      </view>
      <view class="row-note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view class="add-row" wx:if="{{fixedRows.length < 5}}" bindtap="onAddFixed">{{t.addItem}}</view>
  </view>

  <!-- ③ 菜品毛利率（滑杆：拖动只改数字，松手才重算） -->
  <view class="card2">
    <view class="sec">{{t.secMargin}}</view>
    <view class="mg-top">
      <text class="mg-val">{{marginPct}}%</text>
      <text class="mg-sub">{{t.marginSub}}</text>
    </view>
    <slider min="0" max="100" step="1" value="{{marginPct}}" activeColor="#1e3a5f" block-size="22"
            bindchanging="onMarginChanging" bindchange="onMarginChange" />
    <view class="hint">{{t.marginTip}}</view>
    <view class="hint" wx:if="{{marginBand}}">{{t.marginBandLabel}} {{marginBand}}</view>
  </view>

  <!-- ④ 跟营业额挂钩的费用（是"率"不是"额"：流水越高，这笔钱越多） -->
  <view class="card2">
    <view class="sec">{{t.secVar}}</view>
    <view class="hint">{{t.varNote}}</view>
    <view class="rw" wx:for="{{varRows}}" wx:key="key">
      <view class="row">
        <text class="row-name">{{item.name}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{item.pct}}" data-idx="{{index}}" bindinput="onVarPct" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">%</text>
        </view>
        <text class="row-del" data-idx="{{index}}" bindtap="onDelVar">{{t.delItem}}</text>
      </view>
      <view class="row-note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view class="add-row" wx:if="{{varRows.length < 4}}" bindtap="onAddVar">{{t.addItem}}</view>
  </view>

  <!-- ⑤ 目标月利润 -->
  <view class="card2">
    <view class="sec">{{t.secTarget}}</view>
    <view class="row">
      <text class="row-name">{{t.targetRow}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{targetYuan}}" bindinput="onTarget" adjust-position="{{true}}" cursor-spacing="20" />
      </view>
    </view>
  </view>

  <!-- ⑥ M2v1.1 反推输入（仅反推 Tab） -->
  <view class="card2" wx:if="{{mode === 'reverse'}}">
    <view class="sec">{{t.tabReverse}}</view>
    <view class="row">
      <text class="row-name">{{t.revPrice}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{revPriceYuan}}" bindinput="onRevPrice" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">元</text>
      </view>
    </view>
    <view class="row">
      <text class="row-name">{{t.revSeats}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="number" value="{{revSeats}}" bindinput="onRevSeats" adjust-position="{{true}}" cursor-spacing="20" />
      </view>
    </view>
    <view class="row">
      <text class="row-name">{{t.revOpenDays}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="number" value="{{revOpenDays}}" bindinput="onRevOpenDays" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">天</text>
      </view>
    </view>
    <view class="row">
      <text class="row-name">{{t.revRentRate}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{revRentRate}}" bindinput="onRevRentRate" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">%</text>
      </view>
    </view>
    <view class="row">
      <text class="row-name">{{t.revPixelEff}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{revPixelEff}}" bindinput="onRevPixelEff" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">元</text>
      </view>
    </view>
  </view>

  <view class="err-hint" wx:if="{{calcError}}">{{calcError}}</view>
  <button class="btn primary calc-btn" bindtap="onCalc">{{t.calc}}</button>

  <!-- M2v1.2：保存沙盘（底部主按钮） -->
  <button class="btn ghost save-sandbox-btn" bindtap="onOpenSave">{{t.savePlanBtn}}</button>

  <!-- M2v1.1 反推结果（仅反推 Tab；全部来自云端 reverse 块） -->
  <block wx:if="{{mode === 'reverse' && reverseResult}}">
    <view class="card2" wx:if="{{reverseResult.red_alert}}">
      <view class="result-num" style="color:#e74c3c;font-size:36rpx;">{{t.redAlert}}</view>
      <view class="hint">{{t.redAlertHint}}</view>
    </view>
    <view class="card2" wx:if="{{!reverseResult.red_alert}}">
      <view class="sec">{{t.secResult}}</view>
      <view class="cell big"><text class="lbl">{{t.revRevenue}}</text><text class="val keynum">{{t.cur}}{{reverseResult.target_monthly}}</text></view>
      <view class="cell"><text class="lbl">{{t.revRentCap}}</text><text class="val">{{t.cur}}{{reverseResult.rent_cap}}</text></view>
      <view class="cell"><text class="lbl">{{t.revTraffic}}</text><text class="val">{{reverseResult.monthly_traffic}}</text></view>
      <view class="cell"><text class="lbl">{{t.revDailyTraffic}}</text><text class="val">{{reverseResult.daily_traffic}}</text></view>
      <view class="cell"><text class="lbl">{{t.revTurnRate}}</text><text class="val">{{reverseResult.turn_rate}}</text></view>
      <view class="cell" wx:if="{{reverseResult.area_cap_sqm != null}}">
        <text class="lbl">{{t.revAreaCap}}</text><text class="val">{{reverseResult.area_cap_sqm}} ㎡</text>
      </view>
      <view class="hint" wx:if="{{reverseResult.warn_turn_high}}" style="color:#b45309;">{{t.revWarnTurnHigh}}</view>
    </view>
  </block>

  <!-- 结果（后端返回值，仅展示） -->
  <view class="card2" wx:if="{{mode === 'forward' && result && result.red_alert}}">
    <view class="result-num" style="color:#e74c3c;font-size:36rpx;">{{t.redAlert}}</view>
    <view class="hint">{{t.redAlertHint}}</view>
  </view>

  <block wx:if="{{mode === 'forward' && result && !result.red_alert}}">
    <view class="card2">
      <view class="sec">{{t.secResult}}</view>
      <view class="cell"><text class="lbl">{{t.buildTotal}}</text><text class="val">{{t.cur}}{{result.build_total}}</text></view>
      <view class="cell"><text class="lbl">{{t.amortMonthly}}</text><text class="val">{{t.cur}}{{result.build_amort}}</text></view>
      <view class="cell"><text class="lbl">{{t.fixedTotal}}</text><text class="val">{{t.cur}}{{result.fixed_total}}</text></view>
      <view class="cell"><text class="lbl">{{t.marginName}}</text><text class="val">{{result.margin_rate}}%</text></view>
      <view class="cell"><text class="lbl">{{t.varTotal}}</text><text class="val">{{result.platform_pct}}%</text></view>
    </view>

    <view class="card2">
      <view class="cell big"><text class="lbl">{{t.resBreakMonthly}}</text><text class="val keynum">{{t.cur}}{{result.break_even_monthly}}</text></view>
      <view class="cell"><text class="lbl">{{t.resBreakDaily}}</text><text class="val">{{t.cur}}{{result.break_even_daily}}</text></view>
      <view class="cell big"><text class="lbl">{{t.resTargetMonthly}}</text><text class="val keynum">{{t.cur}}{{result.target_monthly}}</text></view>
      <view class="cell"><text class="lbl">{{t.resTargetDaily}}</text><text class="val">{{t.cur}}{{result.target_daily}}</text></view>
      <view class="cell" wx:if="{{result.payback_months}}">
        <text class="lbl">{{t.resPayback}}</text><text class="val">{{result.payback_months}}{{t.paybackUnit}}</text>
      </view>
    </view>
  </block>

  <!-- 餐饮指标对照（待下面 payback 卡前） -->
  <view class="card2" wx:if="{{mode === 'forward' && payback}}">
    <view class="sec">{{t.paybackTitle}}</view>
    <view class="cell">
      <text class="lbl">{{t.paybackInvest}}</text>
      <text class="val {{payback.investDefault ? 'keynum' : ''}}">{{payback.hasData ? ((payback.invest != null ? payback.invest : '—') + t.months) : '—'}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.paybackCash}}</text>
      <text class="val {{!payback.investDefault ? 'keynum' : ''}}">{{payback.hasData ? ((payback.cash != null ? payback.cash : '—') + t.months) : '—'}}</text>
    </view>
    <view class="hint" wx:if="{{!payback.hasData}}">{{t.paybackNull}}</view>
    <view class="hint payback-disclaimer">{{t.paybackDisclaimer}}</view>
    <button class="btn ghost payback-m3-btn" bindtap="onGoM3">{{t.paybackSeeM3}}</button>
  </view>

  <!-- 餐饮指标对照 -->
  <view class="card2" wx:if="{{indicators.length}}">
    <view class="sec">{{t.secIndicators}}</view>
    <view class="tab-row">
      <view class="tab {{indTab === 'break' ? 'on' : ''}}" data-tab="break" bindtap="onIndTab">{{t.indByBreak}}</view>
      <view class="tab {{indTab === 'target' ? 'on' : ''}}" data-tab="target" bindtap="onIndTab">{{t.indByTarget}}</view>
    </view>
    <view class="ind-row ind-head">
      <text class="ind-c1"> </text>
      <text class="ind-c2">{{t.indMine}}</text>
      <text class="ind-c3">{{t.indBand}}</text>
      <text class="ind-c4"> </text>
    </view>
    <view class="ind-row" wx:for="{{indicators}}" wx:key="key">
      <text class="ind-c1">{{item.name}}</text>
      <text class="ind-c2">{{item.mine}}</text>
      <text class="ind-c3">{{item.band}}</text>
      <text class="ind-c4 lv-{{item.level}}">{{item.levelName}}</text>
    </view>
  </view>

  <view class="muted empty-tip" wx:if="{{!result}}">{{t.noCalc}}</view>

  <!-- M2v1.2：保存沙盘弹窗（收方案名 + 类型） -->
  <view class="mask" wx:if="{{showSave}}">
    <view class="sheet">
      <view class="sheet-title">{{t.savePlanModalTitle}}</view>
      <view class="sheet-row">
        <text class="sheet-lbl">{{t.planNameLabel}}</text>
        <input class="sheet-in" type="text" value="{{planName}}" placeholder="{{t.planNamePh}}" bindinput="onSaveName" />
      </view>
      <view class="sheet-row">
        <text class="sheet-lbl">{{t.planTypeLabel}}</text>
        <view class="type-chips">
          <view class="chip {{planType === 'site_select' ? 'on' : ''}}" data-type="site_select" bindtap="onSaveType">{{t.planTypeSite}}</view>
          <view class="chip {{planType === 'biz_sim' ? 'on' : ''}}" data-type="biz_sim" bindtap="onSaveType">{{t.planTypeBiz}}</view>
        </view>
      </view>
      <view class="sheet-btns">
        <button class="btn ghost" catchtap="onCancelSave">{{t.cancel}}</button>
        <button class="btn primary" catchtap="onSavePlan" disabled="{{planSaving}}">{{planSaving ? t.planSaving : t.savePlanBtn}}</button>
      </view>
    </view>
  </view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
