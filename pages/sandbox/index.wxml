<view class="container safe-bottom {{stickKpi ? 'has-stick' : ''}}" wx:if="{{!loading}}">

  <!-- M2v1.2：我的方案入口（标题栏右侧常驻按钮） -->
  <view class="entry-bar">
    <text class="entry-link" bindtap="onSaveEntry">{{t.savePlanEntry}}</text>
  </view>

  <!-- M2v1.1 双 Tab（R234 改名：按**用户此刻的处境**命名，不再用「正向/反推」这种算法词） -->
  <view class="tab-bar">
    <!-- 🔴 R323：本页恒为「已有铺面」⇒ 高亮写死；「寻找铺面」是**跳转入口**，永不在此页高亮。 -->
    <view class="tab-item on" data-mode="forward" bindtap="onTab">
      <text class="tab-main">{{t.tabForward}}</text>
      <text class="tab-sub">{{t.tabForwardSub}}</text>
    </view>
    <view class="tab-item" data-mode="reverse" bindtap="onTab">
      <text class="tab-main">{{t.tabReverse}}</text>
      <text class="tab-sub">{{t.tabReverseSub}}</text>
    </view>
  </view>

  <!-- 0 · 前提：城市层级 + 业态大类（决定下面用的「行业参考带」是哪一套） -->
  <view class="card2">
    <view class="sel-row">
      <text class="sel-lbl">{{t.cityLabel}}</text>
      <picker class="sel-pk" range="{{t.cityTiers}}" range-key="name" value="{{cityIdx}}" bindchange="onCity">
        <view class="sel-val">{{cityName}} ▾</view>
      </picker>
    </view>
    <!-- 🔴 行业标准（= 打算开什么店 / 品类）：选了系统自动带出行规参考带（房租/人工/毛利率等）；选项按美团大类分组，末尾「通用餐饮」兜底 -->
    <view class="sel-row">
      <text class="sel-lbl">{{t.presetLabel}}</text>
      <picker class="sel-pk" range="{{presetOptions}}" range-key="name" value="{{presetIdx}}" bindchange="onPreset">
        <view class="sel-val">{{presetName || t.presetNone}} ▾</view>
      </picker>
    </view>
    <view class="hint" wx:if="{{presetPicked}}">{{t.presetPickedPre}}{{presetName}}{{t.presetPickedSuf}}</view>
    <!-- R193：草稿提示行 + 清空重填（M2 此前算完即丢，退出重进要全部重填） -->
    <view class="draft-bar" wx:if="{{draftRestored || dirty}}">
      <text class="draft-note">{{draftRestored ? t.draftRestored : ''}}</text>
      <button class="btn-small ghost draft-btn" bindtap="onClearDraft">{{t.clearDraft}}</button>
    </view>
  </view>

  <!-- M2v1.3 · L1 小白（必填 5 项：打算开什么店 / 面积 / 月租金 / 员工数 / 目标利润）-->
  <view class="card2" id="l1l2">
    <view class="sec">{{mode === 'reverse' ? t.l1TitleRev : t.l1Title}}</view>
    <view class="hint l1-guide">{{mode === 'reverse' ? t.l1GuideRev : t.l1Guide}}</view>
    <view class="row">
      <text class="row-name">{{t.areaLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{areaNum}}" bindinput="onArea" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.areaUnit}}</text>
      </view>
    </view>
    <view class="row-hint">{{t.areaHint}}</view>
    <view class="row">
      <text class="row-name">{{t.rentLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{rentYuan}}" bindinput="onRent" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.yuanUnit}}</text>
      </view>
    </view>
    <view class="row-hint">{{t.rentHint}}</view>
    <view class="row">
      <text class="row-name">{{mode === 'reverse' ? t.headcountLabelRev : t.headcountLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="number" value="{{headcountNum}}" bindinput="onHeadcount" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.headcountUnit}}</text>
      </view>
    </view>
    <view class="row-hint">{{mode === 'reverse' ? t.headcountHintRev : t.headcountHint}}</view>
    <!-- 🔴 round279b · 目标利润归位 L1：原散落在底部「⑤ 目标月利润」卡，与 L1 标注的
         「必填5项：…目标利润」断开 —— 老手视角下「想赚多少」属开店身份，应与
         业态/面积/房租/人数并排作为 5 个首答问题（先答5个问题再填成本明细）。 -->
    <view class="row">
      <text class="row-name">{{t.targetRow}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" value="{{targetYuan}}" bindinput="onTarget" adjust-position="{{true}}" cursor-spacing="20" />
      </view>
    </view>
    <!-- L2 更多设置 -->
    <view class="fold-toggle" bindtap="onToggleL2">{{t.l2Toggle}}{{showL2 ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{showL2}}">
      <!-- 🔴 R237：输入口径由「座位数」改为「桌数 + 单桌座位数」（李老师 2026-10-08：
           「餐饮老板算账都是按桌数来算……桌数只能推论或者顾客自己选填最准」）。
           ⚠️ 座位数 = 桌数 × 单桌座位数，换算只在 index.js::seatsNow() 一处做 ⇒ 引擎零改动。 -->
      <view class="row">
        <text class="row-name">{{t.tablesLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="number" placeholder="{{t.tablesPh}}" value="{{tablesNum}}" bindinput="onTables" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.tableUnit}}</text>
        </view>
      </view>
      <view class="row-note">{{t.tablesNote}}</view>
      <view class="row">
        <text class="row-name">{{t.seatsPerTableLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="number" placeholder="{{t.seatsPerTablePh}}" value="{{seatsPerTableNum}}" bindinput="onSeatsPerTable" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.headcountUnit}}</text>
        </view>
      </view>
      <!-- 🔴 R246：供给侧口径说明（防被读成"桌均实际来客人数"）——由 t.seatsPerTableNote 供给，页面零硬编码 -->
      <view class="row-note">{{t.seatsPerTableNote}}</view>
      <view class="row">
        <text class="row-name">{{t.avgPriceLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{avgPriceYuan}}" bindinput="onAvgPrice" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row">
        <text class="row-name">{{t.laborTotalLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{laborTotalYuan}}" bindinput="onLaborTotal" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row-note">{{t.laborTotalNote}}</view>
      <!-- 🔴 R296 拍3（李老师 2026-10-14）：水/电/燃气拆成三项 —— 有店的填实数，找店的留空走参考值。
           ⚠️ 引擎侧仍是单个 `utility` 键（FIXED_KEYS 零改）⇒ 装配时三数求和进一个键（零部署）。 -->
      <view class="row">
        <text class="row-name">{{t.waterFee}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{waterYuan}}" bindinput="onWater" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row">
        <text class="row-name">{{t.elecFee}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{electricYuan}}" bindinput="onElectric" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row">
        <text class="row-name">{{t.gasFee}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{gasYuan}}" bindinput="onGas" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row-note">{{t.utilitySplitNote}}</view>
      <!-- 🔴 R296 拍2（李老师 2026-10-14）：管理费**可选填** —— 普通单店通常没有，留空=不评（不虚高）。 -->
      <view class="row">
        <text class="row-name">{{t.manageOptLabel}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{manageYuan}}" bindinput="onManage" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yuanUnit}}</text>
        </view>
      </view>
      <view class="row-note">{{t.manageOptNote}}</view>
    </view>
    <!-- L3 专业参数 -->
    <view class="fold-toggle" bindtap="onToggleL3">{{t.l3Toggle}}{{showL3 ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{showL3}}" id="l3-pro">
        <!-- 🔴 R361（李老师 2026-10-19）：「每月营业天数」那行**整行删除**。
          理由：① 它自 R290 起就是只读值（固定 30），摆在一堆"可填费率"里会让人以为这里能改；
                ② 同一事实已在底部「本次测算底层假设」卡由 `buildAssumptions()` 输出
                   （`preset.params.openDays` = 30，来源 P）⇒ 两处重复、措辞还不同。
          `openDaysNum` 状态**保留**（草稿回读 / 发参 `|| 30` 仍在用，见 index.js:1508），
          只是不再渲染。术语键 `openDaysLabel2/openDaysNote2` 一并留档，不再映射到 `t`。 -->
      <!-- 🔴 R234-实测移除：坪效 / 翻台率 两个输入框。
           依据李老师原话「这些本身是咱们计算出来的，不是让客户自己填出来的」。
           实测两条硬事实：
             · 翻台率 `turnNum` 引擎**根本不收** ⇒ 填了触发重算却零影响 = 纯死输入；
             · 坪效 `pixelEffYuan` 唯一下游 `area_cap_sqm` 因坪效不让问而恒 null ⇒ 一并移除。
           引擎**输出**的翻台率（reverseResult.turn_rate）照常展示 —— 那是算出来的，不是填的。 -->
      <view class="row" wx:for="{{feeRows}}" wx:key="key">
        <text class="row-name">{{item.label}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" value="{{item.pct}}" data-key="{{item.key}}" bindinput="onFeePct" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.pctUnit}}</text>
        </view>
      </view>
    </view>
    <!-- 本次测算底层假设（默认折叠可展开） -->
    <view class="fold-toggle" bindtap="onToggleAssumptions">{{t.assumptionsTitle}}{{showAssumptions ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{showAssumptions}}">
      <view class="asm" wx:for="{{presetAssumptions}}" wx:key="label">
        <text class="asm-lbl">{{item.label}}</text>
        <text class="asm-input">{{item.val}}</text>
        <text class="asm-src" wx:if="{{presetPicked}}">{{item.src}}</text>
      </view>
      <view class="hint-fold">
        <view class="hint-fold-head" data-key="sbAssumptionsHint" bindtap="onToggleHintFold">
          <text class="hint-fold-guide">{{hintFold.sbAssumptionsHint ? t.hintFoldHide : t.hintFoldShow}}</text>
          <text class="hint-fold-arrow">{{hintFold.sbAssumptionsHint ? '▾' : '▸'}}</text>
        </view>
      <view class="hint-fold-body" wx:if="{{hintFold.sbAssumptionsHint}}">{{t.assumptionsHint}}</view>
      </view>
    </view>
  </view>

  <!-- ⓪ 行业参考区间 + 参考金额（round113 立 · round114 加"预计月营业额"锚点）
       —— 用户"还没填"时就知道该填多少量级；填了预计营业额后，每项再给出参考金额（起点）。
       ⚠️ 参考金额只是灰字起点（在下面各输入框的 placeholder 里），**不会自动填值**。 -->
  <view class="card2" wx:if="{{bands.length}}">
    <view class="sec">{{t.bandPreviewTitle}}</view>
    <!-- 🔴 round276：通用兜底业态提示 —— 选「其他/通用餐饮」时出现，明确"通用经验区间、未细分行业、仅供粗估" -->
    <view class="hint-fold warn-note" wx:if="{{bizIsOther}}">
      <view class="hint-fold-head" data-key="sbOtherBandNote" bindtap="onToggleHintFold">
        <text class="hint-fold-guide">{{hintFold.sbOtherBandNote ? t.hintFoldHide : t.hintFoldShow}}</text>
        <text class="hint-fold-arrow">{{hintFold.sbOtherBandNote ? '▾' : '▸'}}</text>
      </view>
      <view class="hint-fold-body" wx:if="{{hintFold.sbOtherBandNote}}">{{t.otherBandNote}}</view>
    </view>
    <view class="hint-fold">
      <view class="hint-fold-head" data-key="sbBandPreviewNote" bindtap="onToggleHintFold">
        <text class="hint-fold-guide">{{hintFold.sbBandPreviewNote ? t.hintFoldHide : t.hintFoldShow}}</text>
        <text class="hint-fold-arrow">{{hintFold.sbBandPreviewNote ? '▾' : '▸'}}</text>
      </view>
    <view class="hint-fold-body" wx:if="{{hintFold.sbBandPreviewNote}}">{{t.bandPreviewNote}}</view>
    </view>
    <!-- 🔴 实际月营业额输入框已移至页面底部「选填」卡片（不参与保本计算，只用于人效/坪效/指标对比） -->
    <!-- 🔴 R234：下面这张 6 项占比网格（`bp-grid`）**整块删除**。
         理由：结果区「你的经营指标对照」表**已经有同名的 6 项 + 行业参考列 + 评级**
         （ `grossMargin/rent/labor/energy/manage/mkt` 完全同名同项）⇒ 两张卡重复。
         占比类在这个页面只该出现**一次**，位置就是结果区那里。
         ⚠️ `bands` 数据本身**仍要算**（`rentRateDefault()` 要从中取房租行规上限），
           只是不再渲染 —— 所以上面的 `wx:if="{{bands.length}}"` 判据保留，不作改动。 -->
  </view>

  <!-- ① 开店投入（一次性）—— 按年限摊到每月 -->
  <view class="card2">
    <view class="sec">{{t.secBuild}}</view>
    <view class="hint-fold">
      <view class="hint-fold-head" data-key="sbBuildNote" bindtap="onToggleHintFold">
        <text class="hint-fold-guide">{{hintFold.sbBuildNote ? t.hintFoldHide : t.hintFoldShow}}</text>
        <text class="hint-fold-arrow">{{hintFold.sbBuildNote ? '▾' : '▸'}}</text>
      </view>
    <view class="hint-fold-body" wx:if="{{hintFold.sbBuildNote}}">{{t.buildNote}}</view>
    </view>
    <view class="rw" wx:for="{{buildRows}}" wx:key="key">
      <view class="row">
        <text class="row-name">{{item.name}}</text>
        <view class="row-in-wrap">
          <input class="row-in" type="digit" placeholder="{{t.buildPh}}" value="{{item.yuan}}" data-idx="{{index}}" bindinput="onBuildYuan" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">元</text>
        </view>
        <view class="row-in-wrap yr">
          <input class="row-in" type="number" value="{{item.years}}" data-idx="{{index}}" bindinput="onBuildYears" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="row-unit">{{t.yearsSuffix}}</text>
        </view>
        <text class="row-del" data-idx="{{index}}" bindtap="onDelBuild">{{t.delItem}}</text>
      </view>
      <view class="row-note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view class="add-row" wx:if="{{buildRows.length < 5}}" bindtap="onAddBuild">{{t.addItem}}</view>
  </view>

  <!-- 🔴 R296 拍1（李老师 2026-10-14）：「每月固定支出」明细表**整块删除**。
       为什么删：它是早期 AI 自加的输入项 —— 界面自证"已计入"，实则 preset 态下根本不进引擎
       （信任陷阱，R294-C 登记）；且与主字段重复（房租在 L1、人工改由 L2「人工每月总额」直填）。
       固定成本改由**结构化输入**承载：房租(L1) / 人工总额(L2) / 水电气(L2) / 管理费(L2)；
       「其他固定」的小项（网费/垃圾清运/油烟清洗/收银年费…）挂在各输入行的 note 里，不漏又不啰嗦。 -->

  <!-- ③ 菜品毛利率（滑杆：拖动只改数字，松手才重算） -->
  <view class="card2">
    <view class="sec">{{t.secMargin}}</view>
    <view class="mg-top">
      <text class="mg-val">{{marginPct}}%</text>
      <text class="mg-sub">{{t.marginSub}}</text>
    </view>
    <slider min="0" max="100" step="1" value="{{marginPct}}" activeColor="#1e3a5f" block-size="22"
            bindchanging="onMarginChanging" bindchange="onMarginChange" />
    <view class="hint-fold">
      <view class="hint-fold-head" data-key="sbMarginTip" bindtap="onToggleHintFold">
        <text class="hint-fold-guide">{{hintFold.sbMarginTip ? t.hintFoldHide : t.hintFoldShow}}</text>
        <text class="hint-fold-arrow">{{hintFold.sbMarginTip ? '▾' : '▸'}}</text>
      </view>
    <view class="hint-fold-body" wx:if="{{hintFold.sbMarginTip}}">{{t.marginTip}}</view>
    </view>
    <view class="hint" wx:if="{{marginBand}}">{{t.marginBandLabel}} {{marginBand}}</view>
  </view>

  <!-- 🔴 R330：做活动会怎样 —— 打折对毛利率与保本线的影响。
       🔴 只算单价影响，不算活动带来的新客：客流增量算不了，编一个就是假精确。
       两个选择器都是纯本地重算，不请求云端。 -->
  <!-- 🔴 R296b 「渠道佣金」（原 #12 多渠道毛利率**改造** · 豆包评审定案）：
       老板只填「各渠道占比 + 抽点」（他知道的数），系统自动算**加权挂钩费率**进计算公式。
       🔴 **绝不揉进毛利率** —— 老板认知里毛利率是"菜赚不赚钱"，偷偷扣平台佣金会被当成软件算错。
       ⚠️ 默认关（不计佣金，与改造前 100% 一致）；外卖占比≥40% / 薄利品类 / 团购>10% 的店建议开。 -->
  <view class="card2">
    <view class="sec">{{t.channelSwitch}}</view>
    <view class="switch-row">
      <text class="switch-label">{{t.channelNote}}</text>
      <switch checked="{{channel.on}}" bindchange="onToggleChannel" color="#1e3a5f" />
    </view>
    <block wx:if="{{channel.on}}">
      <view class="hint">{{t.channelSample}}</view>
      <view class="rw">
        <view class="row">
          <text class="row-name">{{t.channelTakeawayRatio}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.takeawayRatio}}" data-field="takeawayRatio" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row">
          <text class="row-name">{{t.channelPlatformRate}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.platformRate}}" data-field="platformRate" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row">
          <text class="row-name">{{t.channelPackRate}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.packRate}}" data-field="packRate" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row">
          <text class="row-name">{{t.channelGroupRatio}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.groupRatio}}" data-field="groupRatio" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row">
          <text class="row-name">{{t.channelGroupPlatform}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.groupPlatformRate}}" data-field="groupPlatformRate" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row">
          <text class="row-name">{{t.channelDiscountRate}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.discountRate}}" data-field="discountRate" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row">
          <text class="row-name">{{t.channelCardRate}}</text>
          <view class="row-in-wrap">
            <input class="ipt-num" type="number" value="{{channel.cardRate}}" data-field="cardRate" bindinput="onChannelInput" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit">{{t.channelPct}}</text>
          </view>
        </view>
        <view class="row row-strong"><text class="row-name">{{t.channelTotal}}</text><text class="row-val">{{channel.total}}{{t.channelPct}}</text></view>
      </view>
      <view class="hint">{{t.channelTotalNote}}</view>
    </block>
  </view>


  <!-- 🔴 R323（P0-2）：原「寻找铺面」反推卡已删 —— 它挂在 `wx:if="{{mode === 'reverse'}}"` 上，
       而本页 `data.mode` **恒为 'forward'**（点反推 Tab 直接跳矩阵页）⇒ 整块**永远不渲染**。
       找店的口径与档位在 `pages/sandbox/matrix` 里（那里有独立的 mode，且 R322 已做小白降维）。 -->

  <view class="err-hint" wx:if="{{calcError}}">{{calcError}}</view>
  <!-- 🔴 R297 第四轮（审计 B11）：原 `bindtap="onCalc"` 会把**事件对象**当 isFirst 传进去（恒真）
       ⇒ 每次点按钮整页 loading 重绘、滚动位置丢失。改走 `onCalcBtn`（显式传 false）。 -->
  <button class="btn primary calc-btn" bindtap="onCalcBtn">{{t.calc}}</button>

  <!-- M2v1.2：保存沙盘（底部主按钮） -->
  <button class="btn ghost save-sandbox-btn" bindtap="onOpenSave">{{t.savePlanBtn}}</button>

  <!-- 🔴 R297 第四轮（审计 B12）：结果区**唯一锚点**。原先把 `id="m2result"` 挂在两张结果卡上
       （反推卡 + 主结论卡），而主结论卡带 `verdict.level !== 'na'` 条件 ⇒ 无判定时锚点整块不存在，
       `onStickTap` 的 `pageScrollTo('#m2result')` 静默失效（点吸底条没反应）。
       现改为**无条件**锚点、两张卡上的 id 一律卸掉（同页重复 id 也是隐患）。 -->
  <view id="m2result"></view>

  <!-- M2v1.1 反推结果（仅反推 Tab；全部来自云端 reverse 块） -->
  <block wx:if="{{mode === 'reverse' && reverseResult}}">
    <view class="card2" wx:if="{{reverseResult.red_alert}}">
      <view class="result-num" style="color:#e74c3c;font-size:36rpx;">{{t.redAlert}}</view>
      <!-- R234/J4f：26 字（≥18）⇒ 折叠。⚠️ 同页 L353 也用了同一文案（正推 Tab 的红牌卡）——
           **必须用两个独立 key**（sbRedAlertRev / sbRedAlertFwd）：两处虽互斥显示，
           但若共用一个 key，用户在正推里点开、切到反推会发现「没点它也开着」= 状态串台。 -->
      <view class="hint-fold">
        <view class="hint-fold-head" data-key="sbRedAlertRev" bindtap="onToggleHintFold">
          <text class="hint-fold-guide">{{hintFold.sbRedAlertRev ? t.hintFoldHide : t.hintFoldShow}}</text>
          <text class="hint-fold-arrow">{{hintFold.sbRedAlertRev ? '▾' : '▸'}}</text>
        </view>
        <view class="hint-fold-body" wx:if="{{hintFold.sbRedAlertRev}}">{{t.redAlertHint}}</view>
      </view>
    </view>
    <view class="card2" wx:if="{{!reverseResult.red_alert}}">
      <view class="sec">{{t.secResult}}</view>
      <view class="cell big"><text class="lbl">{{t.revRevenue}}</text><text class="val keynum">{{t.cur}}{{reverseResult.target_monthly}}</text></view>
      <view class="cell"><text class="lbl">{{t.revRentCap}}</text><text class="val">{{t.cur}}{{reverseResult.rent_cap}}</text></view>
      <view class="cell"><text class="lbl">{{t.revTraffic}}</text><text class="val">{{reverseResult.monthly_traffic}}</text></view>
      <view class="cell"><text class="lbl">{{t.revDailyTraffic}}</text><text class="val">{{reverseResult.daily_traffic}}</text></view>
      <!-- 🔴 R296 拍4（李老师 2026-10-14）：**删除反推结果里的翻台率展示**。
           理由原话：「翻台率可以删除 —— 有店铺的商家自己在收银软件上能自动出，咱们出这个一是
           不好出，也出不准」。⇒ 反推结果只留 目标营业额 / 房租上限 / 月客流 / 日均客流。
           ⚠️ 引擎仍照常算 `turn_rate`（契约字段不动），只是**不再向用户展示**。 -->
    </view>
  </block>

  <!-- 结果（后端返回值，仅展示） -->
  <view class="card2" wx:if="{{mode === 'forward' && result && result.red_alert}}">
    <view class="result-num" style="color:#e74c3c;font-size:36rpx;">{{t.redAlert}}</view>
    <!-- R234/J4f：同上（26 字）⇒ 折叠。key 与反推那处**不同**（见上方说明）。 -->
    <view class="hint-fold">
      <view class="hint-fold-head" data-key="sbRedAlertFwd" bindtap="onToggleHintFold">
        <text class="hint-fold-guide">{{hintFold.sbRedAlertFwd ? t.hintFoldHide : t.hintFoldShow}}</text>
        <text class="hint-fold-arrow">{{hintFold.sbRedAlertFwd ? '▾' : '▸'}}</text>
      </view>
      <view class="hint-fold-body" wx:if="{{hintFold.sbRedAlertFwd}}">{{t.redAlertHint}}</view>
    </view>
  </view>

  <!-- R234 · 主结论卡「这个铺子租金贵不贵」=====
       为什么要有它：小白看完「保本营业额 18 万」不知道下一步干什么 —— 他脑子里只有一个问题
       「**这个铺子值不值得拿**」。⇒ **先给判定，再给数字**，而不要让用户自己在表格里找结论。
       🔴 判定**不自造**：`verdict.level` 直接读引擎 indicators 里 rent 那行的 level，
          前端只做 key → 中文映射（见 index.js::verdictOf）。
       放在结果区**第一位**：结论要在用户往下翻之前就看到。 -->
  <view class="card2 verdict-card" wx:if="{{mode === 'forward' && verdict && verdict.level !== 'na'}}">
    <view class="verdict-head">
      <text class="verdict-title">{{t.verdictHealthTitle}}</text>
      <text class="verdict-lv lv-{{verdict.level}}">{{verdict.levelName}}</text>
    </view>
    <view class="verdict-row">
      <text class="verdict-lbl">{{verdict.itemName}}</text>
      <text class="verdict-val">{{verdict.mine}}（参考 {{verdict.band}}）{{verdict.levelName}}</text>
    </view>
    <view class="verdict-note">{{verdict.note}}</view>
    <view class="verdict-health">
      <text class="vh-cap">{{t.verdictHealthStrip}}</text>
      <view class="vh-item" wx:for="{{verdict.summary}}" wx:key="key">
        <text class="vh-name">{{item.name}}</text>
        <text class="vh-pct">{{item.pct == null ? '—' : item.pct + '%'}}</text>
        <text class="vh-lv lv-{{item.level}}">{{item.level}}</text>
      </view>
    </view>
  </view>

  <!-- 🔴 R367（李老师 2026-10-19）：「想月赚 X，要怎么做」—— 目标反推。
       两个数是**各自单算**（只动这一项就够），所以下面明写"不要叠加"。
       口径已逐项对过引擎：固定总额含摊销、毛利率要先加回渠道费率。 -->
  <view class="card2 tgt-back-card" wx:if="{{mode === 'forward' && targetReverse}}">
    <block wx:if="{{targetReverse.has}}">
      <view class="sec">{{targetReverse.title}}</view>
      <view class="cell" wx:for="{{targetReverse.rows}}" wx:key="key">
        <text class="lbl tgt-back-line">{{item.text}}</text>
      </view>
      <view class="hint">{{targetReverse.note}}</view>
    </block>
    <view class="hint" wx:else>{{targetReverse.tip}}</view>
  </view>

  <block wx:if="{{mode === 'forward' && result && !result.red_alert}}">
    <view class="card2">
      <view class="sec">{{t.secResult}}</view>
      <view class="cell"><text class="lbl">{{t.buildTotal}}</text><text class="val">{{t.cur}}{{result.build_total}}</text></view>
      <view class="cell"><text class="lbl">{{t.amortMonthly}}</text><text class="val">{{t.cur}}{{result.build_amort}}</text></view>
      <view class="cell"><text class="lbl">{{t.fixedTotal}}</text><text class="val">{{t.cur}}{{result.fixed_total}}</text></view>
      <view class="cell"><text class="lbl">{{t.marginName}}</text><text class="val">{{result.margin_rate}}%</text></view>
      <view class="cell"><text class="lbl">{{t.varTotal}}</text><text class="val">{{result.platform_pct}}%</text></view>
    </view>

    <!-- 🔴 R342：固定费用构成 —— 老板能核对「这 2.16 万人工怎么来的」。
         前端用 assembleItems 同源重算，与引擎 fixed_ex_amort 对账；差 >1 元就整块不显示（fail-closed）。 -->
    <view class="card2" wx:if="{{fixedBreak}}">
      <view class="cell big"><text class="lbl">{{t.fixedBreakTitle2}}</text></view>
      <view class="cell" wx:for="{{fixedBreak}}" wx:key="key">
        <text class="lbl">{{item.name}}</text><text class="val">{{t.cur}}{{item.text}}</text>
      </view>
      <view class="cell"><text class="lbl">{{t.fixedBreakNote2}}</text></view>
    </view>

    <view class="card2">
      <view class="cell big"><text class="lbl">{{t.resBreakMonthly}}</text><text class="val keynum">{{t.cur}}{{result.break_even_monthly}}</text></view>
      <view class="cell"><text class="lbl">{{t.resBreakDaily}}</text><text class="val">{{t.cur}}{{result.break_even_daily}}</text></view>
      <!-- 🔴 R343：现金保本 —— 与账面保本并排，让老板看到"不算折旧，房租工资付得起要卖多少"。
           无摊销时 js 返回 null，这里自动不渲染（两个数相同没意义）。 -->
      <view class="cell" wx:if="{{result.break_even_cash}}">
        <text class="lbl">{{t.beCashLabel2}}</text><text class="val">{{t.cur}}{{result.break_even_cash}}</text>
      </view>
      <view class="cell" wx:if="{{result.break_even_cash}}">
        <text class="lbl">{{t.beCashNote2}}</text>
      </view>
      <!-- 🔴 R340：目标利润没填时，目标月营收 == 保本营收（引擎口径），两行并排会让老板以为算错了。
           所以整组只在「填了目标」时出现；没填时给一句引导，不编一个目标值。 -->
      <block wx:if="{{result.has_target}}">
        <view class="cell big"><text class="lbl">{{t.resTargetMonthly}}</text><text class="val keynum">{{t.cur}}{{result.target_monthly}}</text></view>
        <view class="cell"><text class="lbl">{{t.resTargetDaily}}</text><text class="val">{{t.cur}}{{result.target_daily}}</text></view>
        <!-- 🔴 R338：安全垫 —— 与 M1 同一句话（同一个老板两个模块说法必须一致）。 -->
        <view class="cell" wx:if="{{result.cushion_text}}">
          <text class="lbl">{{t.safeMargin}}</text><text class="val">{{result.cushion_text}}</text>
        </view>
        <view class="cell" wx:if="{{result.payback_months}}">
          <text class="lbl">{{t.resPayback}}</text><text class="val">{{result.payback_months}}{{t.paybackUnit}}</text>
        </view>
      </block>
      <view class="cell" wx:else>
        <text class="lbl">{{t.targetEmptyHint}}</text>
      </view>
    </view>

    <!-- 🔴 R327：正推表 —— 做到这么多营业额能赚多少。
         M2 原先只有倒推（要赚 X 需要卖多少），老板紧接着会问「我大概能做到 15 万，能赚多少」。
         以保本线为基准取 4 档，不写死 8万/10万 —— 每个店保本线不同，绝对档位对多数店无意义。 -->
    <view class="card2" wx:if="{{mode === 'forward' && profitLadder}}">
      <view class="sec">{{t.profitLadderTitle}}</view>
      <view class="hint">{{t.profitLadderSub}}</view>
      <view class="pl-row pl-head">
        <text class="pl-c1">{{t.profitColRev}}</text>
        <text class="pl-c2">{{t.profitColResult}}</text>
      </view>
      <view class="pl-row" wx:for="{{profitLadder}}" wx:key="key">
        <text class="pl-c1">{{item.revText}}</text>
        <text class="pl-c2 {{item.gain ? 'pl-ok' : (item.loss ? 'pl-warn' : '')}}">{{item.resultText}}</text>
      </view>
    </view>

    <!-- 🔴 round273 · A 区（已有铺面）补齐 round223 §3.1 定案的两项指标：**每天来多少人 / 一天翻几台**。
         定案原文 A 输出 = 每天卖多少够本 / 每天来多少人 / 一天翻几台 / 房租占营业额 X%（附行业对比）/ 几年回本
         —— 后三项界面上早就有，**前两项一直缺**（只有「寻找铺面」Tab 有客流与翻台）。
         ⚠️ 由前端 `crowdOf()` 派生（正向引擎不出这两个数），引擎零改动。
         为什么放这个位置：先答「每月要卖多少钱」，紧接着答老板的下一句「那得来多少人」。
         fail-closed：人均消费或桌数没填 ⇒ crowd=null ⇒ 整块不渲染，**不给假数**。 -->
    <view class="card2" wx:if="{{mode === 'forward' && crowd}}">
      <view class="sec">{{t.fwdCrowdTitle}}</view>
      <view class="cell"><text class="lbl">{{t.fwdCrowdBreakLbl}}</text><text class="val">{{crowd.breakPeople}}{{t.fwdCrowdUnit}}</text></view>
      <view class="cell"><text class="lbl">{{t.fwdCrowdTargetLbl}}</text><text class="val keynum">{{crowd.targetPeople}}{{t.fwdCrowdUnit}}</text></view>
      <view class="hint">{{t.fwdCrowdHintPre}}{{crowd.price}}{{t.fwdCrowdHintMid}}{{crowd.seatCount}}{{t.fwdCrowdHintSuf}}</view>
    </view>

    <!-- 🔴 round276 · A 区补齐 round223 §3.1 定案**遗漏**的「坪效 / 人效」（翻台 round273 已补）。
         为什么放这里：老板的提问顺序是「每月要卖多少」→「要来多少人」→「**我现在这家店用得值不值**」。
         分子 = 用户填的**实际月营业额**（A 区＝已发生流水；拿保本额当分子算的是"保本坪效"，不是他要的数）。
         🔴 两项**都不挂行业区间**：仓内 BANDS 只有毛利率/房租占比/人工占比/能耗/管理/推广六项，
            **没有坪效、没有人效** —— R223 §3.2 红线＝不得编造分位数 ⇒ 只出数值，留给老板自家横比。
         fail-closed：没填实际营业额 ⇒ eff=null ⇒ 整块不渲染；面积/人数缺哪个就少哪一行。 -->
    <view class="card2" wx:if="{{mode === 'forward' && eff}}">
      <view class="sec">{{t.fwdEffTitle}}</view>
      <view class="cell" wx:if="{{eff.pixel}}"><text class="lbl">{{t.fwdPixelEffLbl}}</text><text class="val">{{t.cur}}{{eff.pixel}}{{t.fwdPixelEffUnit}}</text></view>
      <view class="cell" wx:if="{{eff.perHead}}"><text class="lbl">{{t.fwdPerHeadLbl}}</text><text class="val keynum">{{t.cur}}{{eff.perHead}}{{t.fwdPerHeadUnit}}</text></view>
      <view class="hint">{{t.fwdEffHint}}</view>
    </view>

    <view class="card2 calc-basis" wx:if="{{result.valid_days}}">
      <view class="sec">{{t.calcBasisTitle}}</view>
      <view class="cell"><text class="lbl">{{t.fixedTotal}}</text><text class="val">{{t.cur}}{{result.fixed_total}}</text></view>
      <view class="cell"><text class="lbl">{{t.marginName}}</text><text class="val">{{result.margin_rate}}%</text></view>
      <view class="cell"><text class="lbl">{{t.calcBasisDays}}</text><text class="val">{{result.valid_days}} 天</text></view>
      <view class="hint calc-basis-formula">{{t.calcBasisFormula}}</view>
    </view>
  </block>

  <!-- 餐饮指标对照（待下面 payback 卡前） -->
  <view class="card2" wx:if="{{mode === 'forward' && payback}}">
    <view class="sec">{{t.paybackTitle}}</view>
    <view class="cell">
      <text class="lbl">{{t.paybackInvest}}</text>
      <text class="val {{payback.investDefault ? 'keynum' : ''}}">{{payback.hasData ? ((payback.invest != null ? payback.invest : '—') + t.months) : '—'}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.paybackCash}}</text>
      <text class="val {{!payback.investDefault ? 'keynum' : ''}}">{{payback.hasData ? ((payback.cash != null ? payback.cash : '—') + t.months) : '—'}}</text>
    </view>
    <!-- 🔴 round279e · A：初始总投入（非必填）。填后按「总投入 ÷ (目标利润+建店月摊)」派生回本月数，覆盖转让费/加盟费等真实总投入 -->
    <view class="row">
      <text class="row-name">{{t.initialInvestLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" placeholder="{{t.initialInvestPh}}" value="{{initialInvestYuan}}" bindinput="onInitialInvest" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">{{t.yuanUnit}}</text>
      </view>
    </view>
    <view class="cell" wx:if="{{payback.userPaybackMonths}}">
      <text class="lbl">{{t.paybackByInvest}}</text>
      <text class="val keynum">{{payback.userPaybackMonths}}{{t.paybackUnit}}</text>
    </view>
    <view class="hint" wx:if="{{!payback.hasData}}">{{t.paybackNull}}</view>
    <view class="hint payback-disclaimer">{{t.paybackDisclaimer}}</view>
    <button class="btn ghost payback-m3-btn" bindtap="onGoM3">{{t.paybackSeeM3}}</button>
  </view>

  <!-- 🔴 #8（P1，round272）：全局测算边界免责声明 —— 与 paybackDisclaimer 互补，点明结果仅参考 -->
  <view class="hint m2-disclaimer" wx:if="{{mode === 'forward'}}">{{t.m2Disclaimer}}</view>

  <!-- 🔴 round279c · #10 敏感度：毛利率 ±5% 看保本额变化（前端派生，引擎零改） -->
  <view class="card2" wx:if="{{mode === 'forward'}}">
    <view class="fold-toggle" bindtap="onToggleSens">{{t.sensTitle}}{{sens.open ? ' ▾' : ' ▸'}}</view>
    <view wx:if="{{sens.open}}">
      <view class="hint">{{t.sensSub}}</view>
      <view class="hint" wx:if="{{sens.disabled}}">{{t.sensHint}}</view>
      <view class="sens-loading" wx:elif="{{sens.loading}}">{{t.sensLoading}}</view>
      <block wx:elif="{{sens.rows}}">
        <view class="cell" wx:for="{{sens.rows}}" wx:key="key">
          <text class="lbl">{{item.label}}</text>
          <text class="val">{{item.breakMonthly != null ? item.breakMonthly + t.cur : '—'}}</text>
          <text class="sens-delta {{item.deltaPct > 0 ? 'up' : (item.deltaPct < 0 ? 'down' : '')}}" wx:if="{{item.deltaText}}">{{item.deltaText}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 🔴 选填·本月实际营业额：人效/坪效与指标对比的唯一输入；明确不参与保本计算（保本只看房租/人工/毛利率/目标利润） -->
  <view class="card2">
    <view class="sec">{{mode === 'reverse' ? t.expectRevTitleRev : t.expectRevTitle}}</view>
    <view class="row">
      <text class="row-name">{{mode === 'reverse' ? t.expectRevLabelRev : t.expectRevLabel}}</text>
      <view class="row-in-wrap">
        <input class="row-in" type="digit" placeholder="{{t.expectRevPh}}" value="{{expectYuan}}" bindinput="onExpect" adjust-position="{{true}}" cursor-spacing="20" />
        <text class="row-unit">元</text>
      </view>
    </view>
    <!-- 🔴 R296b：口径提示（豆包）—— 老板普遍把"平台打款净额"当收入；此处明确填**总流水**、佣金系统自动扣 -->
    <view class="hint">{{t.revGrossHint}}</view>
    <view class="hint-fold">
      <view class="hint-fold-head" data-key="sbExpectRevNote" bindtap="onToggleHintFold">
        <text class="hint-fold-guide">{{hintFold.sbExpectRevNote ? t.hintFoldHide : t.hintFoldShow}}</text>
        <text class="hint-fold-arrow">{{hintFold.sbExpectRevNote ? '▾' : '▸'}}</text>
      </view>
    <view class="hint-fold-body" wx:if="{{hintFold.sbExpectRevNote}}">{{mode === 'reverse' ? t.expectRevNoteRev : t.expectRevNote}}</view>
    </view>
  </view>

  <!-- 餐饮指标对照 -->
  <view class="card2" wx:if="{{indicators.length}}">
    <view class="sec">{{t.secIndicators}}</view>
    <view class="tab-row">
      <view class="tab {{indTab === 'break' ? 'on' : ''}}" data-tab="break" bindtap="onIndTab">{{t.indByBreak}}</view>
      <view class="tab {{indTab === 'target' ? 'on' : ''}}" data-tab="target" bindtap="onIndTab">{{t.indByTarget}}</view>
    </view>
    <view class="ind-row ind-head">
      <text class="ind-c1"> </text>
      <text class="ind-c2">{{t.indMine}}</text>
      <text class="ind-c3">{{t.indBand}}</text>
      <text class="ind-c4"> </text>
    </view>
    <view class="ind-row" wx:for="{{indicators}}" wx:key="key">
      <text class="ind-c1">{{item.name}}</text>
      <text class="ind-c2">{{item.mine}}</text>
      <text class="ind-c3">{{item.band}}</text>
      <text class="ind-c4 lv-{{item.level}}">{{item.levelName}}</text>
    </view>
  </view>

  <!-- 🔴 R364（李老师「整个版面一坨」）：试验台 —— 做活动默认**收起**。
       它问的是"如果"，不是老板要填的事实；收起时只给一句结论（打几折要多卖多少），
       位置也从"第 6 个参数"移到结果之后 ⇒ 独立成台，但仍吃同一份基准数据。 -->
  <view class="card2 trial-card" wx:if="{{mode === 'forward'}}">
    <view class="fold-toggle" bindtap="onTogglePromo">{{t.promoTitle}}{{showPromo ? ' ▾' : ' ▸'}}</view>
    <view class="hint" wx:if="{{!showPromo}}">
      <block wx:if="{{promoRes && !promoRes.bad}}">{{promoRes.gaText}} · {{promoRes.dropText}}</block>
      <block wx:elif="{{promoRes && promoRes.bad}}">{{promoRes.text}}</block>
      <block wx:else>{{t.promoNeedCalc}}</block>
    </view>
    <block wx:if="{{showPromo}}">

    <view class="hint">{{t.promoSub}}</view>
    <view class="promo-row">
      <text class="promo-lb">{{t.promoDiscountLabel}}</text>
      <view class="promo-chips">
        <view class="chip {{!promoRealPct && promoDIdx === index ? 'on' : ''}}" wx:for="{{t.promoDiscountOpts}}" wx:key="index" data-idx="{{index}}" bindtap="onPromoD">{{item}}</view>
      </view>
    </view>
    <!-- 🔴 R350：活动形态不止打折。满减/代金券/团购/第二份半价 全都能折成"每 100 实收多少"，
         填这里就优先于上面的折扣档；留空则按折扣档算。 -->
    <view class="promo-row">
      <text class="promo-lb">{{t.promoRealLabel}}</text>
      <input class="promo-real-inp" type="digit" value="{{promoRealPct}}" bindinput="onPromoRealInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.promoRealPh}}" />
      <text class="promo-real-unit">{{t.promoRealUnit}}</text>
    </view>
    <view class="hint">{{t.promoRealNote}}</view>
    <view class="promo-row">
      <text class="promo-lb">{{t.promoWeightLabel}}</text>
      <view class="promo-chips">
        <view class="chip {{promoWIdx === index ? 'on' : ''}}" wx:for="{{t.promoWeightOpts}}" wx:key="index" data-idx="{{index}}" bindtap="onPromoW">{{item}}</view>
      </view>
    </view>
    <block wx:if="{{promoRes}}">
      <view class="cell" wx:if="{{!promoRes.bad}}"><text class="lbl">{{t.promoGaLabel}}</text><text class="val">{{promoRes.gaText}} · {{promoRes.dropText}}</text></view>
      <view class="cell" wx:if="{{!promoRes.bad}}"><text class="lbl">{{t.promoBeLabel}}</text><text class="val">{{promoRes.beText}}</text></view>
      <view class="cell big" wx:if="{{!promoRes.bad}}"><text class="lbl">{{t.promoTrafficLabel}}</text><text class="val keynum">{{promoRes.trafficText}}</text></view>
      <!-- 🔴 R344：与正推表同基准（日常保本 ×1.2），让老板看到"同样卖这么多，做活动少赚多少"。
           这是**代价**；能不能靠多来的客人补回，看上一条"打平要多来 X%"。 -->
      <view class="cell" wx:if="{{!promoRes.bad && promoRes.sameRevText}}">
        <text class="lbl">{{promoRes.sameRevText}}</text>
      </view>
      <view class="hint" wx:if="{{!promoRes.bad && promoRes.sameRevText}}">{{t.promoSameRevNote}}</view>
      <view class="warn" wx:if="{{promoRes.bad}}">{{promoRes.text}}</view>
    </block>
    <view class="hint" wx:if="{{!promoRes}}">{{t.promoNeedCalc}}</view>
    <!-- 🔴 R337（M2-A1）：口径声明必须留在结果区 ——
         页面问的是「几成订单用券」（单数口径），公式算的是营业额占比；
         只有客单价接近时两者才相等，不说这句就是静默近似。 -->
    <view class="hint">{{t.promoApproxNote}}</view>
    </block>
  </view>

  <!-- M2 G1/G2（2026-10-11 改造）：场景矩阵生成器 / 多方案对比 入口 -->
  <view class="entry-row">
    <button class="btn ghost entry-btn" bindtap="goMatrix">{{t.matrixEntry}}</button>
    <button class="btn ghost entry-btn" bindtap="goCompare">{{t.compareEntry}}</button>
  </view>

  <view class="muted empty-tip" wx:if="{{!result}}">{{t.noCalc}}</view>

  <!-- M2v1.2：保存沙盘弹窗（收方案名 + 类型） -->
  <view class="mask" wx:if="{{showSave}}">
    <view class="sheet">
      <view class="sheet-title">{{t.savePlanModalTitle}}</view>
      <view class="sheet-row">
        <text class="sheet-lbl">{{t.planNameLabel}}</text>
        <input class="sheet-in" type="text" value="{{planName}}" placeholder="{{t.planNamePh}}" bindinput="onSaveName" />
      </view>
      <view class="sheet-row">
        <text class="sheet-lbl">{{t.planTypeLabel}}</text>
        <view class="type-chips">
          <view class="chip {{planType === 'site_select' ? 'on' : ''}}" data-type="site_select" bindtap="onSaveType">{{t.planTypeSite}}</view>
          <view class="chip {{planType === 'biz_sim' ? 'on' : ''}}" data-type="biz_sim" bindtap="onSaveType">{{t.planTypeBiz}}</view>
        </view>
      </view>
      <view class="sheet-btns">
        <button class="btn ghost" catchtap="onCancelSave">{{t.cancel}}</button>
        <button class="btn primary" catchtap="onSavePlan" disabled="{{planSaving}}">{{planSaving ? t.planSaving : t.savePlanBtn}}</button>
      </view>
    </view>
  </view>
  <!-- P0#5：结果吸底条（测算出数后常驻屏幕底部，老板滚长表单也一直看得见核心数；点开看完整测算） -->
  <!-- 🔴 R364：结论条 = 保本 + 月赚（按实际营业额）+ 评级。原来只给「保本」一个数，
       老板滚到哪都知道"要卖多少"，却不知道"能赚多少"。 -->
  <view class="stick-bar" wx:if="{{stickKpi}}" bindtap="onStickTap">
    <view class="stick-row">
      <view class="stick-l"><text class="stick-lbl">{{stickBeLbl}}</text><text class="stick-val">{{stickVal}}</text></view>
      <view class="stick-m" wx:if="{{stickProfit}}"><text class="stick-lbl">{{t.stickProfitLbl}}</text><text class="stick-val2">{{stickProfit}}</text></view>
    </view>
    <view class="stick-row2">
      <text class="stick-lv" wx:if="{{stickLvl}}">{{stickLvl}}</text>
      <text class="stick-go">{{t.stickTap}}</text>
    </view>
  </view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
