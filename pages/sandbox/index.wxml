<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- 输入区 -->
  <view class="card2">
    <view class="card-title">{{t.inputTitle}}</view>
    <view class="field">
      <text class="lbl">{{t.rent}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{rentYuan}}" bindinput="onRent"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.property}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{propertyYuan}}" bindinput="onProperty"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.labor}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{laborYuan}}" bindinput="onLabor"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.other}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{otherYuan}}" bindinput="onOther"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="switch-row">
      <view class="lbl2">{{t.includeAmort}}</view>
      <switch checked="{{includeAmort}}" color="#1e3a5f" bindchange="onIncludeAmort" />
    </view>
    <view class="field" wx:if="{{includeAmort}}">
      <text class="lbl">{{t.simAmort}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{simAmortYuan}}" bindinput="onSimAmort"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.varFood}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{varFoodPct}}" bindinput="onVarFood"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.varMkt}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{varMktPct}}" bindinput="onVarMkt"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.varOther}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{varOtherPct}}" bindinput="onVarOther"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="field">
      <text class="lbl">{{t.targetProfit}}</text>
      <input class="val-input" type="digit" confirm-type="done" value="{{targetProfitYuan}}" bindinput="onTargetProfit"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <button class="btn primary" style="margin-top:24rpx;" bindtap="onCalc">{{t.calc}}</button>
  </view>

  <!-- 结果区（后端返回值，仅展示） -->
  <view class="card2" wx:if="{{result && result.red_alert}}">
    <view class="result-num" style="color:#e74c3c;font-size:36rpx;">{{t.redAlert}}</view>
    <view class="hint">{{t.redAlertHint}}</view>
  </view>

  <view class="card2" wx:if="{{result && !result.red_alert}}">
    <view class="concl" wx:if="{{targetProfitYuan}}">{{t.conclusionPrefix}}<text class="hl">{{t.cur}}{{targetProfitYuan}}</text>{{t.conclusionSuffix}}</view>
    <view class="cell">
      <text class="lbl">{{t.fixedTotal}}</text>
      <text class="val">{{t.cur}}{{result.fixed_total}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.compositeVar}}</text>
      <text class="val">{{result.composite_var}}%</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.marginRate}}</text>
      <text class="val">{{result.margin_rate}}%</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.breakEvenMonthly}}</text>
      <text class="val">{{t.cur}}{{result.break_even_monthly}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.breakEvenDaily}}</text>
      <text class="val">{{t.cur}}{{result.break_even_daily}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.targetMonthly}}</text>
      <text class="val">{{t.cur}}{{result.target_monthly}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.targetDaily}}</text>
      <text class="val">{{t.cur}}{{result.target_daily}}</text>
    </view>
  </view>

  <view class="muted" wx:if="{{!result}}" style="text-align:center;padding:30rpx;">{{t.noCalc}}</view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>