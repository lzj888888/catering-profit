<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- R234/J4e：本句 ≥18 字 ⇒ 折叠（R234 完整清点口径：剥注释 + 含复合 class）。 -->
  <view class="hint-fold">
    <view class="hint-fold-head" data-key="swSwitchHint" bindtap="onToggleHintFold">
      <text class="hint-fold-guide">{{hintFold.swSwitchHint ? t.hintFoldHide : t.hintFoldShow}}</text>
      <text class="hint-fold-arrow">{{hintFold.swSwitchHint ? '▾' : '▸'}}</text>
    </view>
    <view class="hint-fold-body" wx:if="{{hintFold.swSwitchHint}}">{{t.switchHint}}</view>
  </view>

  <!-- R208：一行 = 名字区（点击切店）+ 右侧「改名」/「删除」两个**显式按钮**。
       🔴 为什么把原来行尾的「⋯」actionSheet 换掉：李老师实测**没找到**删除入口，以为「店铺只能改名」
          （低频 ≠ 可藏，见 R192 红线）。现在两个动作直接摊在行内，零隐藏层级。
       🔴 bindtap 仍**不**绑在整卡上：按钮与名字区同卡，绑整卡会让点「删除」先触发切换
          （页面 navigateBack，确认弹窗还没弹就跳走了）⇒ 名字区独立绑, 按钮侧用 catchtap 阻断冒泡。 -->
  <view class="card2" wx:for="{{list}}" wx:key="shop_id">
    <!-- 常态行 -->
    <view class="shop-row" wx:if="{{!(mode === 'rename' && editingId === item.shop_id)}}">
      <view class="shop-main" data-id="{{item.shop_id}}" bindtap="onSelect">
        <view class="card-title shop-name">
          <text class="nm">{{item.name}}</text>
          <text class="tag" wx:if="{{item.shop_id === currentShopId}}">{{t.currentShop}}</text>
        </view>
      </view>
      <!-- R210：再加一个「清空」——比「删除店铺」轻得多的第二条出口（只清月度账，店还在）。
           三个动作一行平铺，破坏力从左到右递增：改名 → 清空 → 删除。 -->
      <view class="row-ops">
        <button class="ops-btn" catchtap="onRenameTap" data-id="{{item.shop_id}}">{{t.renameShort}}</button>
        <button class="ops-btn warn" catchtap="onResetTap" data-id="{{item.shop_id}}">{{t.resetShort}}</button>
        <button class="ops-btn danger" catchtap="onDeleteTap" data-id="{{item.shop_id}}">{{t.deleteShort}}</button>
      </view>
    </view>

    <!-- R194：就地重命名（**不跳页、不弹层** —— 弹层 × 键盘是死结，见 PITFALLS §8） -->
    <view class="edit-row" wx:else>
      <input class="edit-inp" value="{{editName}}" maxlength="{{nameMax}}"
             placeholder="{{t.namePh}}" bindinput="onEditName" />
      <button class="btn btn-small primary edit-btn" catchtap="onRenameSave" disabled="{{busy}}">{{t.save}}</button>
      <button class="btn btn-small ghost edit-btn" catchtap="onEditCancel">{{t.cancel}}</button>
    </view>
  </view>

  <!-- R208：删空后会自动展开下面的新建输入框 ⇒ 此时不再叠一条「还没有店铺」空态 -->
  <view wx:if="{{list.length === 0 && mode !== 'create'}}" class="empty">{{t.noShopHint}}</view>

  <!-- R194：新建店铺 —— 就地输入。
       此前这里跳 `shop/setting`，而设置页走 saveShopSetting（只更新**当前**店）
       ⇒ 用户以为在建店，实际把当前店改名了。 -->
  <view class="card2" wx:if="{{mode === 'create'}}">
    <input class="edit-inp edit-inp-block" value="{{editName}}" maxlength="{{nameMax}}"
           placeholder="{{t.namePh}}" bindinput="onEditName" />
    <view class="edit-row fill">
      <button class="btn btn-small primary edit-btn" bindtap="onCreate" disabled="{{busy}}">{{t.createOk}}</button>
      <button class="btn btn-small ghost edit-btn" bindtap="onEditCancel">{{t.cancel}}</button>
    </view>
  </view>
  <button class="btn ghost" wx:else bindtap="onAdd">{{addShopLabel}}</button>

  <view class="more-hint">{{t.moreHint}}</view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
