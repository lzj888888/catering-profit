/* subpkg/biz/revenue/manual/index.wxss —— 手填页样式
   字号一律 ≥ 28rpx（AD-G1），触控区 ≥ 88rpx（AD-G2）—— 老板多半在店里、手上有油。 */
.mn { padding: 24rpx 24rpx 60rpx; }

.mn-month { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; margin-bottom: 20rpx; }
.mn-lbl { font-size: 30rpx; color: #26303f; margin-right: 24rpx; }
.mn-pick { font-size: 32rpx; color: #2b6cd4; padding: 12rpx 24rpx; background: #f0f5ff; border-radius: 12rpx; }

.mn-tip { font-size: 28rpx; color: #5a6678; line-height: 1.7; padding: 0 8rpx 20rpx; }

.mn-group { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx 20rpx; margin-bottom: 20rpx; }
.mn-gh { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.mn-gt { font-size: 32rpx; color: #1a2233; font-weight: 600; }
.mn-gx { font-size: 28rpx; color: #8792a3; }
.mn-ghint { display: block; font-size: 28rpx; color: #8792a3; line-height: 1.55; margin-bottom: 12rpx; }

.mn-item { padding: 16rpx 0 8rpx; border-top: 1rpx solid #f0f2f5; }
.mn-il { font-size: 30rpx; color: #26303f; }
.mn-in { font-size: 34rpx; color: #1a2233; height: 88rpx; line-height: 88rpx; border-bottom: 1rpx solid #e6e9ef; }
.mn-ih { display: block; font-size: 28rpx; color: #8792a3; line-height: 1.55; margin-top: 8rpx; }

.mn-save { margin-top: 32rpx; }
.mn-note { display: block; font-size: 28rpx; color: #8792a3; line-height: 1.6; margin-top: 20rpx; text-align: center; }
