/* subpkg/biz/diag/result.wxss —— R612 · 深度诊断结论页
   只补 app.wxss 没有的类；.card2 / .muted / .btn / .hint 全部继承全局，不重复定义
   （重复定义 = 两处改一处就漂，本仓已因同类问题吃过亏）。
   配色沿用全局：主蓝 #1e3a5f / 绿 #22a06b / 橙 #e8a33d·#92610a / 红 #c0392b / 灰 #999。 */
.page { padding: 24rpx 24rpx 60rpx; }
.center { text-align: center; padding: 80rpx 0; }

/* ---------- ① 结论卡 ---------- */
.dg-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(30, 58, 95, 0.06);
}
/* 左侧 8rpx 色条标等级：一眼看到"红/橙/蓝/绿"，不用读字 */
.dg-card.lv-good { border-left: 8rpx solid #22a06b; }
.dg-card.lv-watch { border-left: 8rpx solid #1e3a5f; }
.dg-card.lv-warn { border-left: 8rpx solid #e8a33d; }
.dg-card.lv-critical { border-left: 8rpx solid #c0392b; }
.dg-card.lv-insufficient { border-left: 8rpx solid #ccc; }

.dg-hd { display: flex; align-items: center; justify-content: space-between; }
.dg-badge {
  font-size: 30rpx; font-weight: 700; color: #fff;
  background: #1e3a5f; border-radius: 10rpx; padding: 6rpx 20rpx;
}
.lv-good .dg-badge { background: #22a06b; }
.lv-warn .dg-badge { background: #e8a33d; }
.lv-critical .dg-badge { background: #c0392b; }
.lv-insufficient .dg-badge { background: #999; }

.dg-score { font-size: 56rpx; font-weight: 700; color: #1e3a5f; margin-top: 12rpx; }
.dg-concl { font-size: 30rpx; color: #333; line-height: 1.65; margin-top: 8rpx; }

.dg-sig {
  margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 12rpx;
  background: #fdf3d8; border-left: 8rpx solid #e8a33d;
}
.dg-sig.none { background: #f3f7fb; border-left-color: #1e3a5f; font-size: 28rpx; color: #4a5b70; }
.dg-sig-hd { font-size: 26rpx; color: #92610a; margin-bottom: 6rpx; }
.dg-sig-tx { font-size: 30rpx; font-weight: 600; color: #333; line-height: 1.6; }

/* ---------- ② 11 项拆解 ---------- */
.dg-sec-hd { font-size: 32rpx; font-weight: 700; color: #1e3a5f; margin-bottom: 8rpx; }
.ind { padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.ind:last-child { border-bottom: none; }
.ind-hd { display: flex; justify-content: space-between; align-items: center; }
.ind-lbl { font-size: 30rpx; color: #333; }
.ind-sc { font-size: 30rpx; font-weight: 700; }
.sc-good { color: #22a06b; }
.sc-watch { color: #1e3a5f; }
.sc-warn { color: #c0392b; }
.sc-na { color: #999; font-weight: 400; font-size: 26rpx; }

.bar { height: 12rpx; background: #f0f2f5; border-radius: 6rpx; margin: 10rpx 0 6rpx; overflow: hidden; }
.bar-in { height: 100%; border-radius: 6rpx; }
.bar-good { background: #22a06b; }
.bar-watch { background: #2a4e7c; }
.bar-warn { background: #c0392b; }
.bar-na { background: transparent; }
.ind-note { font-size: 24rpx; }

/* ---------- ③ 缺项引导 ---------- */
.miss-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 30rpx;
}
.miss-row:last-of-type { border-bottom: none; }
.miss-lbl { color: #333; }

/* ---------- ④ 依据 + 免责 ---------- */
.basis-line { padding: 4rpx 0; }
.dg-disclaimer {
  font-size: 24rpx; color: #999; line-height: 1.7;
  padding: 8rpx 8rpx 0; text-align: justify;
}

/* ---------- 数据截止 + 近几月利润明细 ---------- */
.dg-asof { font-size: 24rpx; padding: 0 4rpx 12rpx; }
.bm-hd { padding: 14rpx 0 6rpx; }
.bm {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f5f5f5;
}
.bm:last-child { border-bottom: none; }
.bm-m { color: #666; }
.bm-v { font-weight: 600; }
/* 亏损 = 红（中国经营语境：亏是坏事，不是股市跌绿红涨那套；这里是账，不是行情） */
.bm-v.neg { color: #c0392b; }
.bm-v.pos { color: #22a06b; }

/* 🔴 R614 补丁：账本不足引导块。
   刻意与页底深色 banner 区分：这里是「信息 + 一条出路」，用浅底 + 左侧琥珀色条，
   不用深色（深色留给"去体检"那个 CTA，避免页面上出现两个同等重量的暗块）。 */
.dg-mm {
  margin-top: 20rpx;
  padding: 22rpx 22rpx 18rpx;
  background: #f7f9fc;
  border-left: 6rpx solid #d9a441;
  border-radius: 12rpx;
}
.dg-mm-t { font-size: 28rpx; color: #2b3a4d; line-height: 1.6; }
.dg-mm-h { margin-top: 8rpx; font-size: 28rpx; color: #6b7a8d; line-height: 1.6; }
.dg-mm-a { margin-top: 14rpx; font-size: 28rpx; color: #2a4e7c; font-weight: 600; }
