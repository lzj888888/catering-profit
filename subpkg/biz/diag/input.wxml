<!-- subpkg/biz/diag/input.wxml —— A20（2026-11-05）· 深度诊断 · 补录页
     🔴 所有输入框的 value 只绑**用户自己填的**字段（不预填系统参考值），placeholder 只做提示。
     🔴 picker 显示中文、提交只送 key（见 js buildFacts）。 -->
<view class="page">
  <view class="hd">{{t.title}}</view>
  <view class="hint">{{t.hint}}</view>

  <view class="card">
    <!-- 🔴 R614：这里原来是「去年同期客流（人次）」输入框，已删除。
         那个数老板填不出来（收银系统只有单数/营业额），问出来的只能是估值，
         拿估值算同比会得出"客流在流失"这种错误判断。改问三档，他一定答得出。 -->
    <view class="field">
      <text class="lbl">{{t.revenueFeel}}</text>
      <picker mode="selector" range="{{t.revenueFeelOpts}}" value="{{feelIdx < 0 ? 0 : feelIdx}}"
        bindchange="onPickFeel">
        <view class="val-pick">{{feelIdx < 0 ? t.pending : t.revenueFeelOpts[feelIdx]}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="lbl">{{t.rating}}</text>
      <input class="val-input" type="digit" confirm-type="done"
        placeholder="{{t.ratingPh}}" value="{{rating}}"
        bindinput="onRating" adjust-position="{{true}}" cursor-spacing="20" />
    </view>

    <view class="field">
      <text class="lbl">{{t.reviewTrend}}</text>
      <picker mode="selector" range="{{t.trendOpts}}" value="{{trendIdx < 0 ? 0 : trendIdx}}"
        bindchange="onPickTrend">
        <view class="val-pick">{{trendIdx < 0 ? t.pending : t.trendOpts[trendIdx]}}</view>
      </picker>
    </view>
    <view class="hint small">{{t.reviewTrendHint}}</view>

    <view class="field">
      <text class="lbl">{{t.district}}</text>
      <picker mode="selector" range="{{t.districtOpts}}" value="{{districtIdx < 0 ? 0 : districtIdx}}"
        bindchange="onPickDistrict">
        <view class="val-pick">{{districtIdx < 0 ? t.pending : t.districtOpts[districtIdx]}}</view>
      </picker>
    </view>
    <view class="hint small">{{t.districtHint}}</view>

    <view class="field">
      <text class="lbl">{{t.leaseMonths}}</text>
      <input class="val-input" type="number" confirm-type="done"
        placeholder="{{t.leaseMonthsPh}}" value="{{leaseMonths}}"
        bindinput="onLeaseMonths" adjust-position="{{true}}" cursor-spacing="20" />
    </view>

    <!-- R612：续租涨幅 —— R6「租约断崖」三条件之一，缺它这条永远判不了 -->
    <view class="field">
      <text class="lbl">{{t.renewIncrease}}</text>
      <input class="val-input" type="digit" confirm-type="done"
        placeholder="{{t.renewIncreasePh}}" value="{{renewIncrease}}"
        bindinput="onRenewIncrease" adjust-position="{{true}}" cursor-spacing="20" />
    </view>

    <view class="field">
      <text class="lbl">{{t.debt}}</text>
      <picker mode="selector" range="{{t.debtOpts}}" value="{{debtIdx < 0 ? 0 : debtIdx}}"
        bindchange="onPickDebt">
        <view class="val-pick">{{debtIdx < 0 ? t.pending : t.debtOpts[debtIdx]}}</view>
      </picker>
    </view>
    <view class="hint small">{{t.debtHint}}</view>

    <!-- R612：重大食安 —— **只问一个**，不拆档（李老师拍板，见 terms 注释） -->
    <view class="field">
      <text class="lbl">{{t.foodSafety}}</text>
      <picker mode="selector" range="{{t.foodSafetyOpts}}" value="{{foodIdx < 0 ? 0 : foodIdx}}"
        bindchange="onPickFood">
        <view class="val-pick">{{foodIdx < 0 ? t.pending : t.foodSafetyOpts[foodIdx]}}</view>
      </picker>
    </view>
    <view class="hint small">{{t.foodSafetyHint}}</view>

    <!-- 🔴 R614：会员销售**占比**（原来录入页让填金额，老板还得自己算比例）。
         收银系统一般能导出「会员消费额 ÷ 总营业额」，直接填百分比。 -->
    <view class="field">
      <text class="lbl">{{t.memberRatio}}</text>
      <input class="val-input" type="digit" confirm-type="done"
        placeholder="{{t.memberRatioPh}}" value="{{memberRatio}}"
        bindinput="onMemberRatio" adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="hint small">{{t.memberRatioHint}}</view>

    <view class="field">
      <text class="lbl">{{t.cash}}</text>
      <input class="val-input" type="digit" confirm-type="done"
        value="{{cashYuan}}" bindinput="onCash"
        adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <view class="hint small">{{t.cashHint}}</view>
  </view>

  <button class="btn primary" bindtap="onSave" disabled="{{saving}}">{{t.save}}</button>
</view>
