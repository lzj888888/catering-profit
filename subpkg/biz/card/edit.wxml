<view class="form safe-bottom" wx:if="{{!loading}}">
  <!-- 🔴 R547（M5）：编辑态读不到这张卡 ⇒ **显式错误页**，且下面整块表单与两个保存按钮都不渲染。
       改前是「空白表单 + 保存照常可用」⇒ 老板一点保存就把有内容的卡存成空白版本（静默、不可见）。 -->
  <block wx:if="{{loadMissing}}">
    <view class="sec-lite">{{t.loadMissingTitle}}</view>
    <view class="warn-note">{{t.loadMissingBody}}</view>
    <button class="btn primary" bindtap="onRetryLoad">{{t.loadRetry}}</button>
    <button class="btn ghost" bindtap="backToList">{{t.loadBack}}</button>
  </block>
  <block wx:else>
  <!-- R426（队列 #32）：金额栏读不成数字时的横幅。只提醒、不改数；点保存会被硬拦（edit.js::onSave）。 -->
  <view class="warn-note" wx:if="{{badAmountCount > 0}}">{{t.amountBadTip}}</view>
  <!-- R547（M8）：模式 B 没填「这批出多少份」⇒ 引擎按 1 份算（整批料钱当一道菜）。单独一条，免得改错格。 -->
  <view class="warn-note" wx:if="{{badQtyCount > 0}}">{{t.batchOutputBadTip}}</view>
  <view class="warn-note" wx:if="{{badUsageCount > 0}}">{{t.usageBadTip}}</view>

  <!-- 🔴 R708：补价模式横幅。为什么要有它：
       精简态把 20+ 控件收起来了，若不说一句，老板会以为「功能少了 / 草稿没带过来」。
       这句话同时回答了三个问题：① 这是什么模式 ② 我该做什么 ③ 做完去哪。
       逃生口放在同一块里 —— 就在他可能想找东西的位置，不用滚到底。 -->
  <view class="lean-bar" wx:if="{{patchMode}}">
    <view class="lean-head">
      <text class="lean-tag">{{t.leanTitle}}</text>
      <text class="lean-fold" bindtap="onLeanToggle">{{patchFull ? t.leanFoldBtn : t.leanFullBtn}}</text>
    </view>
    <text class="lean-desc" wx:if="{{!patchFull}}">{{t.leanDesc}}</text>
  </view>

  <!-- round156：连续录入 —— 保存成功后**留在本页**，这条横幅是"存到哪了"的凭证 + 显式返回出口。
       改前每存一道菜就 navigateBack 回列表，录 30 道菜要来回 60 次。 -->
  <view class="saved-bar" wx:if="{{savedName}}">
    <text class="saved-txt">{{t.savedOk}}「{{savedName}}」· {{t.savedHint}}</text>
    <!-- 🔴 R643：还能建几张 —— 第 18 条就要说，不能等第 21 条被拒才让老板知道 -->
    <text class="quota-tip" wx:if="{{quotaTip}}">{{quotaTip}}</text>
    <!-- 🔴 R644（会审 R637）：金额化 —— 「毛利率 18%」是会计语言，
         「每卖一份亏 1.2 元」是他口袋里的语言。看一眼就会停下来。 -->
    <text class="money-tip" wx:if="{{moneyTip}}">{{moneyTip}}</text>
    <view class="saved-go" bindtap="backToList">{{backLabel}}</view>
  </view>

  <!-- 🔴 P0#7：新手/专业模式（与 M1 录入页同形）—— 新手先填核心项，专业项默认收起 -->
  <!-- 🔴 R708：补价模式下整块隐藏 —— 模式偏好排在「填菜名」**之前**，是精简态最挡路的一块，
       而且草稿场景里「新手/专业」这个选择本身没有意义（他只有一个动作：补价）。 -->
  <view class="im-wrap" wx:if="{{!lean}}">
    <view class="im-sec">{{t.inputModeTitle}}</view>
    <view class="im-opts">
      <view class="im-opt {{inputMode === 'novice' ? 'on' : ''}}" data-val="novice" bindtap="onPickInputMode">
        <view class="im-h">{{inputMode === 'novice' ? '✓ ' : ''}}{{t.inputModeNovice}}</view>
        <view class="im-d">{{t.inputModeNoviceDesc}}</view>
      </view>
      <view class="im-opt {{inputMode === 'pro' ? 'on' : ''}}" data-val="pro" bindtap="onPickInputMode">
        <view class="im-h">{{inputMode === 'pro' ? '✓ ' : ''}}{{t.inputModePro}}</view>
        <view class="im-d">{{t.inputModeProDesc}}</view>
      </view>
    </view>
  </view>
  <view class="im-tip" wx:if="{{inputMode === 'novice' && !showMore && !lean}}">{{t.noviceTip}}</view>

  <view class="sec-lite">{{t.secBasic}}</view>
  <view class="field">
    <text class="lbl">{{t.dishName}}</text>
    <input class="val-input" value="{{name}}" placeholder="{{t.dishNamePh}}" bindinput="onName" bindblur="onNameBlur" adjust-position="{{true}}" cursor-spacing="20" />
  </view>

  <!-- M3.16（批次 C）卡片类型：单品 / 套餐（引用型成本卡）
       R190：提到**名字下面第一步** —— 「是录一道菜，还是组一个套餐」先定，再谈别的；
       选套餐后隐藏「核算模式 / 批量产出 / 菜品模板」（套餐固定按「份」聚合，calc_mode 对其无意义）。 -->
  <!-- 🔴 R708：补价模式隐藏卡片类型 —— 草稿恒为单品（导入页只产单品草稿），
       给一个「改成套餐」的开关，等于在补价路上开一个会**清空原料行口径**的岔路。 -->
  <view class="field" wx:if="{{!lean}}">
    <text class="lbl">{{t.cardTypeLabel}}</text>
    <radio-group class="mode-group" bindchange="onCardType">
      <label class="mode-item"><radio value="1" checked="{{cardType === '1'}}" color="#1e3a5f"/>{{t.cardTypeDish}}</label>
      <label class="mode-item"><radio value="3" checked="{{cardType === '3'}}" color="#1e3a5f"/>{{t.cardTypeCombo}}</label>
    </radio-group>
    <text class="muted">{{t.cardTypeHint}}</text>
  </view>

  <!-- M3.20（批次 B 收尾）从模板新建：一键预填行名/用量/单位，价格全部留空。仅新建态 + 单品。 -->
  <!-- 🔴 R671：两级选择 —— 先选业态大类（与 M2 同一套词），再选该品类下的菜。
       为什么改：22 道平铺一个下拉，老板要滚很久才找到目标；先按品类收窄，一眼能挑到。
       布局：这个 field 用 flex-wrap 让两个 picker 各占一行（并排会挤成 110rpx，点不准）。 -->
  <!-- 🔴 R708：补价模式下模板区必须**整块隐藏** —— 这不是排版偏好，是防误触：
       点模板会用模板行**覆盖**老板刚补好价的原料行（applyTemplate 里 `lines: renumber(lines)`），
       补价补到一半点一下，价全没了。 -->
  <view class="field tpl-field" wx:if="{{!isEdit && cardType === '1' && !lean}}">
    <text class="lbl">{{t.templateFrom}}</text>
    <picker class="tpl-pick" mode="selector" range="{{tplCatNames}}" value="{{tplCatIdx}}" bindchange="onPickTplCat">
      <view class="picker">{{tplCatIdx >= 0 ? tplCatNames[tplCatIdx] : t.templateCatPh}}</view>
    </picker>
    <picker class="tpl-pick" mode="selector" range="{{tplNames}}" value="{{tplPicked}}" bindchange="onPickTemplate" disabled="{{!tplNames.length}}">
      <view class="picker {{!tplNames.length ? 'picker-disabled' : ''}}">{{tplPicked >= 0 ? tplNames[tplPicked] : t.templatePickPh}}</view>
    </picker>
    <text class="muted">{{t.templateHint}}</text>
  </view>
  <!-- 🔴 R731（李老师 2026-11-14 真机）：「点错了套用模板，想清掉但页面没有这个选项，
       整个我还得重新退出去重新进来」。套用是覆盖式的（lines 整块被模板行替换）⇒ 补撤销口。
       只清配料行，菜名/售价保留；已填单价时先确认（见 edit.js::onClearTpl）。 -->
  <view class="tpl-applied" wx:if="{{!isEdit && cardType === '1' && tplApplied && !lean}}">
    <text class="tpl-applied-txt">{{t.tplAppliedTip}}「{{tplAppliedName}}」</text>
    <text class="tpl-applied-clear" catchtap="onClearTpl">{{t.tplClearBtn}}</text>
  </view>
  <!-- 🔴 R676：输完菜名自动匹配模板（替代已删的品类选择器）。
       只在「配料区还是空的」时候提示 —— 已填了内容再提示，一点就覆盖老板的手工录入。 -->
  <view class="tpl-match" wx:if="{{!isEdit && cardType === '1' && tplMatchKey && !lean}}">
    <text class="tpl-match-txt">{{t.tplMatchTip}}「{{tplMatchName}}」</text>
    <text class="tpl-match-go" catchtap="onApplyMatched">{{t.tplMatchApply}}</text>
  </view>
  <!-- 匹配不到时的引导：库里没有这道菜很正常（41 道 vs 老板 30-50 道菜单），
       不吭声老板会以为"输了没反应/功能坏了"。给一句怎么做，比沉默有用。 -->
  <view class="tpl-nomatch" wx:if="{{!isEdit && cardType === '1' && tplNoMatch && !lean}}">{{t.tplNoMatchTip}}</view>
  <!-- 🔴 R677：库里有相关的（自制/外购这类）⇒ 只指路，不自动套 ——
       自制和外购成本结构完全不同，机器替老板选等于让他拿错模型算账。 -->
  <view class="tpl-nomatch" wx:if="{{!isEdit && cardType === '1' && tplSuggest > 0 && !lean}}">{{t.tplSuggestTip}}</view>

  <!-- 🔴 R675（李老师）：删掉「这道菜属于哪类」+ 燃气燃料分摊。
       为什么删：
       ① 品类会预填「猪肉 150 克」这种错主料（老板建宫保鸡丁也拿到猪肉），
          而错的起点比空白更糟 —— 老板要么直接存（成本全错），要么全删重填（比从零填还多两步）；
       ② 燃气属**期间费用**，代码头注（categoryPresets.js:14）2026-10-29 会诊已裁定
          「不进单品食材毛利率」；而 M1 月度支出里**已有「燃气费」真实账单科目**
          ⇒ 在菜品级再分摊一次，同一笔钱记两个地方，且每份 0.15/0.2/0.4 元本身无出处（是当初拍的）。
       出净率改由模板行自带（R674 YIELD_RULES 按原料给），不再依赖品类。
       category 字段保留为**纯标签**（列表筛选仍在用），入口在「更多设置」里。 -->

  <!-- 核算模式（仅单品）· 🔴 P0#7：新手模式默认收起，展开专业项才显示 -->
  <view class="field" wx:if="{{cardType === '1' && (inputMode === 'pro' || showMore)}}">
    <text class="lbl">{{t.calcMode}}</text>
    <radio-group class="mode-group" bindchange="onMode">
      <label class="mode-item"><radio value="A" checked="{{calcMode === 'A'}}" color="#1e3a5f"/>{{t.calcModeA}}</label>
      <label class="mode-item"><radio value="B" checked="{{calcMode === 'B'}}" color="#1e3a5f"/>{{t.calcModeB}}</label>
    </radio-group>
  </view>

  <!-- 批量模式：产出份数（仅单品：套餐无批量预制概念） -->
  <view class="field" wx:if="{{cardType === '1' && calcMode === 'B' && (inputMode === 'pro' || showMore)}}">
    <text class="lbl">{{t.batchOutput}}</text>
    <input class="val-input" type="number" value="{{batchOutput}}" bindinput="onBatch"  adjust-position="{{true}}" cursor-spacing="20" />
    <text class="muted">{{t.batchHint}}</text>
  </view>

  <view class="sec-lite">{{t.secCost}}</view>
  <!-- R693（易填性·填得对）：出成率是这张表单里**唯一没人解释过**的字段，
       而它填错的代价最大（净料成本 = 单价 ÷ 出成率，填 60 还是 0.6 直接差 100 倍）。
       只在**新手模式**给这一句：老手不需要，给了只是占地方。 -->
  <view class="im-tip" wx:if="{{inputMode === 'novice' && cardType === '1' && !lean}}">{{t.yieldExplain}}</view>
  <!-- 明细行（录入方式：档案选择 / 临时手工）—— 仅单品 -->
  <block wx:if="{{cardType === '1'}}">
  <view class="line {{lines[index].isPreset ? 'line-est' : ''}}" wx:for="{{lines}}" wx:key="rid">
    <view class="est-tag" wx:if="{{lines[index].isPreset}}">{{t.estRowTag}}</view>
    <!-- 🔴 R708：补价模式隐藏「录入方式」单选 —— 草稿行恒为手工行（input_type=2），
         切到「档案」会重置该行的单价/出成率（见 onLineType），补价补到一半就被清空。 -->
    <view class="cell2" wx:if="{{!lean}}">
      <text class="lbl">{{t.inputType}}</text>
      <!-- round153：红「×」删行按钮原本挂在这一行的最右边 ⇒ 实测被读成"取消临时手工录入"
           （这行本来就是「二选一」，旁边杵个红叉语义打架）。已挪到明细行末尾「删除本行」。 -->
      <radio-group class="mode-group" data-idx="{{index}}" value="{{lines[index].input_type === 2 ? 'manual' : 'archive'}}" bindchange="onLineType">
        <label class="mode-item"><radio value="archive" checked="{{lines[index].input_type !== 2}}" color="#1e3a5f"/>{{t.inputTypeArchive}}</label>
        <label class="mode-item"><radio value="manual" checked="{{lines[index].input_type === 2}}" color="#1e3a5f"/>{{t.inputTypeManual}}</label>
      </radio-group>
    </view>

    <!-- 档案选择行 -->
    <block wx:if="{{lines[index].input_type !== 2}}">
      <view class="cell2">
        <text class="lbl">{{t.material}}</text>
        <!-- round156：原生 `<picker>`（只能滚）→ **独立选择页**（搜索 + 按分类分组）。
             100 个原料在原 picker 里要滚十几屏 ⇒ 换成跳 `subpkg/biz/material/pick`。
             为什么不用弹层：弹层 × 键盘是死结（PITFALLS §6）。 -->
        <view class="picker" data-idx="{{index}}" bindtap="goPickMaterial">{{lines[index].material_name ? lines[index].material_name : t.material}}</view>
      </view>
      <!-- round149：把「买」与「用」的换算摆在眼前（采购价 ÷ 换算系数 ÷ 出成率 ⇒ 净料元/克），
           老板不用去档案页心算，也不会把「按斤买」的价当成「按克」的价填。 -->
      <!-- 🔴 R372：空态说明只在**第一行**出现一次。原来每行都印一遍同一句 30 字解释，
           三个配料就是三行重复文字（实测每行 30px）。 -->
      <!-- 🔴 R640：进货价 **主显**（老板的语言），换算公式退为副说明。
           改前整句以「⇒ 净料 0.0783 元/克」收尾 ⇒ 老板只看见克价，涨价也看不出来。
           真机原话：「我对克不敏感，对一公斤、一件才敏感」。 -->
      <view class="price-main-row" wx:if="{{lines[index].price_main}}">
        <text class="price-main">{{lines[index].price_main}}</text>
        <text class="price-main-cap">{{t.priceMainCap}}</text>
      </view>
      <view class="muted spec-hint" wx:if="{{lines[index].spec_formula}}">{{lines[index].spec_formula}}</view>
      <view class="muted spec-hint" wx:elif="{{!lines[index].price_main && lines[index].spec_hint}}">{{lines[index].spec_hint}}</view>
      <view class="muted spec-hint" wx:elif="{{index === 0}}">{{t.matSpecHintEmpty}}</view>
      <!-- round151：跨计量族提示（只提示、不拦截）。参考产品在同样情形下静默算出 ¥6,000,000 无告警 -->
      <view class="warn-hint" wx:if="{{lines[index].unit_warn}}">{{lines[index].unit_warn}}</view>
      <!-- round153：用量 + 单位**同一排** —— 数字与单位是同一个量的两半，拆两行会视觉断句。 -->
      <view class="cell2">
        <text class="lbl">{{t.qty}}</text>
        <view class="qty-wrap">
          <input class="val-input qty-input" type="digit" value="{{lines[index].qty}}" data-idx="{{index}}" bindinput="onQty"  adjust-position="{{true}}" cursor-spacing="20" />
          <picker mode="selector" range="{{qtyUnits}}" value="{{lines[index].qtyUnitIdx}}" data-idx="{{index}}" bindchange="onQtyUnit">
            <view class="picker unit-pick">{{lines[index].qty_unit || baseUnit}}</view>
          </picker>
        </view>
      </view>
    </block>

    <!-- 临时手工录入行（仅本卡生效） -->
    <!-- 🔴 R570：四行压成**两行** —— 老板"录一个菜要拉很久"的主因是 4 个字段各占一整行。
         分组按「输入时的思维顺序」：先叫啥 + 多少钱（行 1），再损耗 + 用多少（行 2）。
         ⚠️ 单位 picker 一格不减（round151：单价单位可选项是"6 元/斤能直接填 6"的前提），
         只是从"独占一行"改成"跟在数字框右边"。 -->
    <block wx:else>
      <view class="cell2 line-row2">
        <view class="lr-cell">
          <text class="lbl">{{t.manualName}}</text>
          <input class="val-input" value="{{lines[index].material_name}}" placeholder="{{t.manualNamePh}}" data-idx="{{index}}" bindinput="onManualName" adjust-position="{{true}}" cursor-spacing="20" />
        </view>
        <!-- round151：单价 = 「输入框 + 单位 ▾」并排（对齐参考产品实测布局）。
             改前单位写死在 label 里（「单价（元/克）」）⇒ 老板买 6 元/斤的肉，得先心算 0.012 才敢填。
             round153：单价 = 「[数字框] ｜ 元/斤」—— 单位格带独立浅底 + 左侧留白，
             把"这是单位、不是数字的一部分"在视觉上切开。改前二者紧挨着，实测被连读成
             「50 克」（老板在疑惑自己是不是在填 50 克的数量）。
             ⚠️ 显示用 t.cur 拼，不写死货币符；单位值仍由 price_unit 驱动。 -->
        <!-- 🔴 R708：补价模式下「单价」是**唯一**要他填的格子 ⇒ 标签给个暖橙强调，
             让他在一堆灰标签里一眼找到落点（只改颜色/字重，字号不动，守 AD 28rpx 红线）。 -->
        <view class="lr-cell {{lean ? 'lr-key' : ''}}">
          <text class="lbl">{{t.manualUnitPrice}}</text>
          <view class="price-wrap">
            <input class="val-input price-input" type="digit" value="{{lines[index].unit_price_yuan}}" data-idx="{{index}}" bindinput="onManualPrice"  adjust-position="{{true}}" cursor-spacing="20" />
            <picker mode="selector" range="{{priceUnits}}" value="{{lines[index].priceUnitIdx}}" data-idx="{{index}}" bindchange="onManualPriceUnit">
              <view class="picker unit-pick price-unit">{{t.cur}}/{{lines[index].price_unit || baseUnit}}</view>
            </picker>
          </view>
        </view>
      </view>
      <view class="cell2 line-row2">
        <view class="lr-cell">
          <text class="lbl">{{t.manualYield}}</text>
          <input class="val-input" type="digit" value="{{lines[index].yield_rate}}" data-idx="{{index}}" bindinput="onManualYield"  adjust-position="{{true}}" cursor-spacing="20" />
        </view>
        <!-- round153：用量 + 单位同一排（同上，档案行）。 -->
        <view class="lr-cell">
          <text class="lbl">{{t.qty}}</text>
          <view class="qty-wrap">
            <input class="val-input qty-input" type="digit" value="{{lines[index].qty}}" data-idx="{{index}}" bindinput="onQty"  adjust-position="{{true}}" cursor-spacing="20" />
            <picker mode="selector" range="{{qtyUnits}}" value="{{lines[index].qtyUnitIdx}}" data-idx="{{index}}" bindchange="onQtyUnit">
              <view class="picker unit-pick">{{lines[index].qty_unit || baseUnit}}</view>
            </picker>
          </view>
        </view>
      </view>
    </block>

    <!-- round150（M3.14）组件类型：**只影响规格试算，不影响这份成本**。
         为什么必须有它：半份菜的「调料不减半」（否则没味）、耗材也不减半 ⇒ 分类错了半份成本就错。 -->
    <view class="kind-row" wx:if="{{!lean}}">
      <text class="kind-lbl">{{t.lineKindTitle}}</text>
      <block wx:for="{{kindChips}}" wx:for-item="kc" wx:for-index="ki" wx:key="key">
        <text class="kind-chip {{lines[index].line_kind === kc.key ? 'kind-on' : ''}}" data-idx="{{index}}" data-kind="{{kc.key}}" bindtap="pickKind">{{kc.label}}</text>
      </block>
    </view>
    <!-- round153：删行操作放到**整行的最末尾**并写明语义 —— 它是"删掉这一整行原料"，
         不是"取消某个选项"（改前是行首那排单选旁边的红叉，语义打架）。
         误触保护：只有这行**已经填了东西**才弹确认，空行直接删（见 edit.js::delLine）。 -->
    <view class="del-row" data-idx="{{index}}" bindtap="delLine">{{t.delLine}}</view>
  </view>
  <view class="muted" style="margin:-8rpx 0 12rpx 4rpx;" wx:if="{{!lean}}">{{t.qtyUnitHint}}</view>
  <view class="muted" style="margin:-4rpx 0 12rpx 4rpx;" wx:if="{{!lean}}">{{t.lineKindHint}}</view>
  <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="addLine">{{t.addLine}}</button>

  <!-- 🔴 R637（真机二次实测）：老板「输的时候弹键盘，要看结果得先把键盘收起再滑到底」。
       底部那条是 fixed 的，键盘一弹就被盖住 ⇒ 在明细正下方再放一条**同一份数据**的结果条，
       边填边能看到，不用滑到底、也不用收键盘。 -->
  <view class="inline-cost">
    <block wx:if="{{previewCostFen > 0}}">
      <text class="ic-l">{{t.stickyLast}}</text>
      <text class="ic-v">{{t.cur}}{{previewCost}}</text>
      <text class="ic-m" wx:if="{{stickyMargin}}">{{t.grossMargin}} {{stickyMargin}}</text>
    </block>
    <text class="ic-empty" wx:else>{{stickyHint || t.stickyEmpty}}</text>
    <text class="ic-hint" wx:if="{{stickyHint && previewCostFen > 0}}">{{stickyHint}}</text>
  </view>
  <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="goMaterial" wx:if="{{!lean}}">{{t.materialArchive}}</button>
  <!-- 🔴 R443：批量粘贴配料（解析在 utils/cardPaste.js；只在本页暂存，点「导入」才进 lines） -->
  <!-- 🔴 R708：补价模式隐藏 —— 草稿里的原料行**已经**是解析好的，本页再粘一次是另一件事
       （那属于上一页「批量录入原料」），摆在这里只会让老板以为要重来一遍。 -->
  <view class="paste-toggle" bindtap="onPasteToggle" wx:if="{{!lean}}">{{t.pasteTitle}}{{pasteOpen ? ' ▾' : ' ▸'}}</view>
  <block wx:if="{{pasteOpen && !lean}}">
    <textarea class="paste-ta" value="{{pasteText}}" bindinput="onPasteInput" placeholder="{{t.pastePlaceholder}}" maxlength="-1" adjust-position="{{true}}" cursor-spacing="20" />
    <view class="muted">{{t.pasteHint}}</view>
    <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="onPasteParse">{{t.pasteParseBtn}}</button>
    <block wx:if="{{pasteRows.length}}">
      <view class="paste-row" wx:for="{{pasteRows}}" wx:key="index">
        <text class="pr-name">{{item.name}}</text>
        <text class="pr-qty">{{item.qtyText}} {{item.unit}}</text>
        <text class="pr-st {{item.status === 'ok' ? 'ok' : 'bad'}}">{{item.status === 'ok' ? '✓' : item.statusText}}</text>
      </view>
      <button class="btn primary btn-small" bindtap="onPasteImport" disabled="{{pasteOkCount === 0}}">{{pasteImportLabel}}</button>
    </block>
  </block>
  </block>

  <!-- M3.16（批次 C）套餐：子卡选择行（选卡 + 份数）+ 三个显示数 -->
  <block wx:if="{{cardType === '3'}}">
    <view class="combo-box">
      <view class="spec-title">{{t.comboSubCardTitle}}</view>
      <view class="muted" wx:if="{{subCardOptions.length === 0}}">{{t.comboPickEmpty}}</view>
      <block wx:for="{{comboLines}}" wx:for-item="cl" wx:for-index="ci" wx:key="rid">
        <view class="combo-row">
          <picker mode="selector" range="{{subCardOptions}}" range-key="label" data-idx="{{ci}}" bindchange="onComboSubCard">
            <view class="picker combo-pick">{{comboLines[ci].sub_card_name || t.comboSubCardPh}}</view>
          </picker>
          <view class="qty-wrap">
            <input class="val-input qty-input" type="number" value="{{comboLines[ci].qty}}" data-idx="{{ci}}" bindinput="onComboQty" adjust-position="{{true}}" cursor-spacing="20" />
            <text class="unit-pick">{{t.comboSubCardQty}}</text>
          </view>
          <view class="del-row" data-idx="{{ci}}" bindtap="delComboLine">{{t.delLine}}</view>
        </view>
      </block>
      <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="addComboLine">{{t.comboAddSubCard}}</button>
      <!-- 🔴 R443：子卡成本变了却没有自动更新套餐（syncCostCard 跳过套餐）⇒ 必须说出来 -->
      <view class="muted warn-hint" wx:if="{{comboStaleText}}">{{comboStaleText}}</view>

      <!-- 三个显示数：顾客省 / 我少赚 / 成本结构 -->
      <block wx:if="{{comboInsight}}">
        <view class="muted">{{t.comboInsightCustomerSave}}：{{t.cur}}{{comboInsight.customer_save_yuan}}</view>
        <view class="muted" wx:if="{{comboInsight.merchant_lose_neg}}" style="color:#c0392b;">{{t.comboInsightMerchantLose}}：{{t.cur}}{{comboInsight.merchant_lose_yuan}}（{{t.comboInsightLoseWarn}}）</view>
        <view class="muted" wx:else>{{t.comboInsightMerchantLose}}：{{t.cur}}{{comboInsight.merchant_lose_yuan}}</view>
        <view class="muted">{{t.comboInsightCostShare}}：</view>
        <block wx:for="{{comboInsight.cost_share}}" wx:key="name">
          <view class="muted" style="padding-left:24rpx;">{{item.name}} {{item.share_pct}}%</view>
        </block>
        <!-- P1 · 套餐本身毛利（售价 − 套餐成本）：与「顾客省/我少赚」并列，让老板一眼看到这套餐自己赚多少 -->
        <view class="muted" wx:if="{{comboSelfMargin}}" style="color:#1a7d55;font-weight:600;">{{t.comboSelfMarginTitle}}：{{t.cur}}{{comboSelfMargin.profit}}（{{t.comboSelfMarginHint}} · {{comboSelfMargin.rate}}）</view>
      </block>
    </view>
  </block>

  <!-- 分类 / 标签（后端 cardDoc 已有字段，本次真正传上去） -->
  <!-- 分类：**自由填写**（火锅的锅底/荤菜/素菜、营销栏目"大口吃肉"都选不出来 ⇒ 不能只给下拉）。
       组件用 input + chips 而非 picker 弹层：弹层×键盘在真机上是死结（见 PITFALLS §6）。 -->
  <!-- 🔴 R660（Phase 1 元数据归位）：分类收进「更多设置」。首屏只留 菜名→配料→售价→毛利率 -->
  <view class="line" wx:if="{{inputMode === 'pro' || showMore}}">
    <text class="lbl">{{t.category}}</text>
    <input class="cat-input" value="{{category}}" placeholder="{{t.categoryPh}}" bindinput="onCategoryInput" adjust-position="{{true}}" cursor-spacing="20" />
    <view class="chip-row" wx:if="{{catChips.length}}">
      <block wx:for="{{catChips}}" wx:key="*this">
        <view class="chip {{item === category ? 'chip-on' : ''}}" data-cat="{{item}}" bindtap="pickCat">{{item}}</view>
      </block>
    </view>
    <text class="muted">{{t.categoryHint}}</text>
  </view>
  <view class="field" wx:if="{{inputMode === 'pro' || showMore}}">
    <text class="lbl">{{t.tags}}</text>
    <input class="val-input" value="{{tags}}" placeholder="{{t.tagsPh}}" bindinput="onTags" adjust-position="{{true}}" cursor-spacing="20" />
    <text class="muted">{{t.tagsHint}}</text>
  </view>

  <!-- 成本参数 -->
  <!-- 🔴 R708：补价模式隐藏损耗率 —— 横幅承诺「只补单价，其余已填好」，这里多一个格子就破了承诺；
       草稿的损耗率已按品类预填（buildDraftCard 里 `loss_rate`），要改走「展开完整设置」。 -->
  <view class="field" wx:if="{{!lean}}">
    <text class="lbl">{{t.lossRate}}</text>
    <input class="val-input" type="digit" value="{{lossRate}}" bindinput="onLoss"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- R693（易填性·填得对）：损耗率同样只有标签、没有解释。新手模式给一句参考值，
       否则老板要么不填（默认值未必对），要么凭感觉填一个 30% 把成本算高。 -->
  <view class="im-tip" wx:if="{{inputMode === 'novice' && !lean}}">{{t.lossExplain}}</view>
  <view class="field" wx:if="{{inputMode === 'pro' || showMore}}">
    <text class="lbl">{{t.auxAmount}}</text>
    <input class="val-input" type="digit" value="{{auxYuan}}" bindinput="onAux"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <view class="sec-lite">{{t.secPrice}}</view>
  <view class="field">
    <text class="lbl">{{t.price}}</text>
    <input class="val-input" type="digit" value="{{priceYuan}}" bindinput="onPrice"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- R692（易填性）：售价是预填来的（销量表均价）时给一句来源说明 ——
       不说这句，老板会以为系统知道门市价；而团购/满减会把均价拉低，需要他核对。 -->
  <view class="prefill-note" wx:if="{{prefillPriceNote}}">{{prefillPriceNote}}</view>
  <view class="field" wx:if="{{inputMode === 'pro' || showMore}}">
    <text class="lbl">{{t.activityPrice}}</text>
    <input class="val-input" type="digit" value="{{activityPriceYuan}}" bindinput="onActivityPrice"  adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- R234/J4f：本句 ≥18 字 ⇒ 折叠（完整清点口径下补漏）。
       🔴 R660：本折叠块属于「活动价」，活动价已收进更多设置 ⇒ 这里必须同步收，
       否则新手会看到一句「活动价怎么填」的提示，却找不到活动价输入框。 -->
  <view class="hint-fold" wx:if="{{inputMode === 'pro' || showMore}}">
    <view class="hint-fold-head" data-key="ceActPriceHint" bindtap="onToggleHintFold">
      <text class="hint-fold-guide">{{hintFold.ceActPriceHint ? t.hintFoldHide : t.hintFoldShow}}</text>
      <text class="hint-fold-arrow">{{hintFold.ceActPriceHint ? '▾' : '▸'}}</text>
    </view>
    <view class="hint-fold-body" wx:if="{{hintFold.ceActPriceHint}}">{{t.activityPriceHint}}</view>
  </view>

  <!-- 反算售价（R190：单品 / 套餐**都能用** —— 此前套餐点了没反应，规范 v1.2 早定了套餐反算口径） -->
  <!-- 🔴 R708：补价模式隐藏反算售价 —— 反算的前提是「成本已经对了」，
       而补价模式正在解决的就是成本不对。把它摆在售价下面，等于让老板用**还没补完的成本**
       去反推售价。要反算就去展开完整设置（那里成本行已经在上面）。 -->
  <view class="reverse" wx:if="{{!lean}}">
    <view class="muted rev-pre">{{t.reversePre}}</view>
    <view class="cell">
      <text class="lbl">{{t.targetMargin}}</text>
      <input class="val-input" type="digit" value="{{targetMargin}}" bindinput="onTargetMargin"  adjust-position="{{true}}" cursor-spacing="20" />
    </view>
    <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="reverseCalc">{{t.reverseTitle}}</button>
    <button class="btn-small" style="min-height:88rpx;margin-left:12rpx;" wx:if="{{reversePriceFen > 0}}" bindtap="applyReverse">{{t.reverseApply}}</button>
    <view class="muted" wx:if="{{reversePriceFen > 0}}">{{t.reverseResult}}：{{t.cur}}{{reverseResultPreview}}</view>
    <view class="muted" wx:if="{{previewCostFen > 0}}">{{t.totalCost}}：<text style="color:#1e3a5f;">{{t.cur}}{{previewCost}}</text></view>
    <view class="muted" style="font-size:22rpx;margin-top:-4rpx;" wx:if="{{previewCostFen > 0}}">{{t.costNote}}</view>
  </view>

  <!-- 🔴 P0#7：新手模式「展开专业项」入口（点一下全部专业项都显示；切模式会重置） -->
  <!-- 🔴 R708：补价模式不显示 —— 顶部横幅已有「展开完整设置」，两个展开入口是同一件事的
       两个说法，摆在一页里只会让老板挑（李老师 R706 已就这一点提过一次）。 -->
  <view class="im-expand" wx:if="{{inputMode === 'novice' && !showMore && !lean}}">
    <button class="btn ghost btn-block" bindtap="onExpandPro">{{t.expandProBtn}}</button>
  </view>

  <!-- 🔴 R626：这里原来是一整块「团购价 / 佣金率 / 推广费 + 算到手」的输入。
       为什么删：团购价是**渠道属性**，不是菜品属性 ——
         ① 同一个菜可能堂食 28、单独上团购 19.9、做成套餐又是另一个价，一个格子装不下；
         ② 实测（真实引擎）：把单品团购价从 19.9 改成 9.9，套餐团购毛利**一分不动**（都是 10.75），
            它只多出"这个菜团购到底多少钱"的第二个答案，让老板按单品价加总算套餐，估高 2.90 元；
         ③ 它本来就不入库（只是页面临时输入），删掉不动任何已存数据。
       ⇒ 唯一该填的地方是团购页（能选卡、填价、填佣金、出到手）。这里只留一句指路。
       ⚠️ js 里的 onGrouponPrice / calcGroupon 暂留未删（不再有任何 wxml 绑定），下一轮清理。 -->
  <view class="cell" bindtap="goGrouponPage" wx:if="{{(cardType === '1' || cardType === '3') && !lean}}">
    <text class="lbl" style="color:#2b6cd4;">{{t.grouponGoLink}}</text>
  </view>

  <!-- round150（M3.15）规格（大小份）：成本按组件类型缩放后**单独试算**。
       ⚠️ 页面**不抄系数**（系数单源在服务端 SPEC_PRESETS）—— 只送规格键 + 售价，
       试算结果由云端返回（含它是用哪套系数算的）。主成本口径完全不受影响。
       ⚠️ 套餐（引用型卡）无规格概念 ⇒ 仅单品显示。 -->
  <view class="spec-box" wx:if="{{cardType === '1' && (inputMode === 'pro' || showMore)}}">
    <view class="spec-title">{{t.specTitle}}</view>
    <view class="muted">{{t.specHint}}</view>
    <block wx:for="{{specRows}}" wx:for-item="sp" wx:for-index="si" wx:key="spec_key">
      <view class="spec-row">
        <view class="spec-head">
          <text class="spec-name {{sp.enabled ? 'spec-on' : ''}}" data-spec="{{sp.spec_key}}" bindtap="toggleSpec">{{sp.name}}</text>
          <text class="muted">{{sp.enabled ? t.specEnable : ''}}</text>
        </view>
        <block wx:if="{{sp.enabled}}">
          <!-- 🔴 R547（M1）：per100g 必须先填「这一份多少克」——成本按 100÷克重 折算。
               改前没有这一格，成本按整份算而售价按 100g 填 ⇒ 毛利率被严重低估（真机量级 11.76% vs 真值 82.35%）。 -->
          <view class="cell2" wx:if="{{sp.spec_key === 'per100g'}}">
            <text class="lbl">{{t.specPortionLabel}}</text>
            <input class="val-input" type="digit" value="{{sp.portionG}}" data-spec="{{sp.spec_key}}" bindinput="onSpecPortion" placeholder="{{t.specPortionPh}}"  adjust-position="{{true}}" cursor-spacing="20" />
          </view>
          <view class="muted" wx:if="{{sp.spec_key === 'per100g'}}">{{t.specPortionHint}}</view>
          <view class="cell2">
            <text class="lbl">{{t.specPriceLabel}}<text wx:if="{{sp.spec_key === 'per100g'}}">（元/{{t.specPer100gUnit}}）</text></text>
            <input class="val-input" type="digit" value="{{sp.priceYuan}}" data-spec="{{sp.spec_key}}" bindinput="onSpecPrice"  adjust-position="{{true}}" cursor-spacing="20" />
          </view>
          <view class="muted" wx:if="{{sp.spec_key === 'per100g'}}">{{t.specPer100gNote}}</view>
        </block>
      </view>
    </block>
    <button class="btn ghost btn-small" style="min-height:88rpx;" bindtap="calcSpecs">{{t.specCalc}}</button>
    <block wx:for="{{specRows}}" wx:for-item="sp" wx:for-index="si" wx:key="spec_key">
      <view class="spec-res" wx:if="{{sp.enabled && sp.result}}">
        <view class="spec-res-name">{{sp.result.name}}</view>
        <!-- R547（M1）：没填克重 ⇒ 云端 **不给数**（need_portion）。此处显式提示，绝不显示"0 元成本/100% 毛利"。 -->
        <view class="muted" wx:if="{{sp.result.needPortion}}" style="color:#c0392b;">{{t.specNeedPortion}}</view>
        <block wx:else>
        <view class="muted">{{t.specCostLabel}}：<text style="color:#1e3a5f;">{{t.cur}}{{sp.result.costYuan}}</text></view>
        <view class="muted" wx:if="{{sp.result.price_fen > 0}}">{{t.specMarginLabel}}：{{sp.result.marginPct}}%</view>
        <view class="muted" wx:if="{{sp.result.suggestYuan}}">{{t.specSuggestLabel}}：{{t.cur}}{{sp.result.suggestYuan}}
          <text class="spec-apply" data-spec="{{sp.spec_key}}" bindtap="useSpecSuggest">（{{t.reverseApply}}）</text>
        </view>
        </block>
      </view>
    </block>
  </view>

  <view style="height:20rpx;"></view>
  <!-- 🔴 R708：补价模式只留**吸底条**那一个保存键 —— 精简态整页一屏内看得完，
       页面内再来一个「保存」与吸底按钮是同一个动作的两次出现。 -->
  <button class="btn primary" style="margin-top:0;" bindtap="onSave" wx:if="{{!lean}}">{{t.save}}</button>

  <!-- 🔴 R374：吸底动作条。改前保存按钮在**第三屏底部**（整页 1367px），
       改个菜名也要一路滚到底；而且没有成本/毛利时老板不知道自己填的对不对。
       左边标「上次试算」（不谎称实时：成本只在 calcBom 返回后更新），右边常驻保存。
       ⚠️ 试算仍走 calcBom（引擎单源），本页不抄成本算法。 -->
  <view class="sticky-act">
    <view class="sa-l" bindtap="reverseCalc">
      <block wx:if="{{previewCostFen > 0}}">
        <text class="sa-cap">{{previewStale ? t.stickyStale : t.stickyLast}}</text>
        <text class="sa-val {{previewStale ? 'sa-stale' : ''}}">{{t.cur}}{{previewCost}}</text>
        <text class="sa-mg" wx:if="{{stickyMargin}}">{{t.grossMargin}} {{stickyMargin}}</text>
      </block>
      <text class="sa-empty" wx:else>{{t.stickyEmpty}}</text>
      <!-- 🔴 R635：「还差哪个数」以前写在 wx:else 里 —— 一旦算出过一次成本（previewCostFen>0）
           就永远走 if 分支，提示再也不出现（真机实测：老板从没见过这句话）。
           ⇒ 改成独立显示，可与数字**同时**存在：数字告诉你上次多少，提示告诉你现在缺什么。 -->
      <text class="sa-hint" wx:if="{{stickyHint}}">{{stickyHint}}</text>
    </view>
    <!-- 🔴 R651（李老师：「点完保存页面突然就空了，填东西时候没有一个反应过程」）：
         改前 `saving` 状态在 js 里有、**界面完全没用** ⇒ 点了按钮毫无变化，然后页面突然清空。
         现在按钮自己转圈 + 禁用（同时防连击生成两个版本）。 -->
    <button class="btn primary sa-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">{{saving ? t.savingNow : t.saveShort}}</button>
  </view>
  </block>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>