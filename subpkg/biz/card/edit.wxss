.val-input { text-align: right; font-size: 30rpx; width: 260rpx; }
/* 菜品分类：自由输入 + 候选 chips。色值取 app.wxss 头注单源（墨蓝 #1e3a5f / 浅底 #e8eff7）；
   字号 28rpx = 新增字号下界（26rpx 必红）。 */
.cat-input { width: 100%; box-sizing: border-box; text-align: left; font-size: 30rpx; padding: 14rpx 18rpx; background: #f3f7fb; border-radius: 10rpx; min-height: 88rpx; }
.chip-row { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip { font-size: 28rpx; padding: 10rpx 22rpx; margin: 0 12rpx 12rpx 0; border-radius: 24rpx; background: #e8eff7; color: #1e3a5f; }
.chip-on { background: #1e3a5f; color: #fff; }
/* round149：明细行里的「买→用」换算说明（一行小字，避免把采购价当成净料价填） */
.spec-hint { margin: 0 0 8rpx 4rpx; line-height: 1.5; }
.mode-group { display: flex; align-items: center; }

/* round150（M3.14）组件类型 chips —— 字号 28rpx 起（上线前 AD 缺口 G1 下界） */
.kind-row { display: flex; flex-wrap: wrap; align-items: center; margin-top: 8rpx; }
.kind-lbl { font-size: 28rpx; color: #6b7a8c; margin-right: 12rpx; }
.kind-chip { font-size: 28rpx; padding: 8rpx 20rpx; margin: 0 12rpx 8rpx 0; border-radius: 22rpx; background: #e8eff7; color: #1e3a5f; }
.kind-on { background: #1e3a5f; color: #ffffff; }

/* round150（M3.15）规格（大小份）小节 */
.spec-box { margin: 8rpx 0 4rpx; padding: 16rpx 20rpx 20rpx; background: #f5f8fc; border-radius: 12rpx; }
.spec-title { font-size: 30rpx; color: #1e3a5f; font-weight: 600; margin-bottom: 6rpx; }
.spec-row { margin-top: 12rpx; }
.spec-head { display: flex; align-items: center; }
.spec-name { font-size: 30rpx; padding: 8rpx 24rpx; border-radius: 24rpx; background: #e8eff7; color: #1e3a5f; margin-right: 12rpx; }
.spec-on { background: #1e3a5f; color: #ffffff; }
.spec-res { margin-top: 10rpx; padding: 12rpx 16rpx; background: #ffffff; border-radius: 10rpx; }
.spec-res-name { font-size: 28rpx; color: #1e3a5f; font-weight: 600; }
.spec-apply { color: #2b7de9; font-size: 28rpx; }
.mode-item { font-size: 30rpx; margin-right: 32rpx; display: flex; align-items: center; }
.line { background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx; margin-bottom: 16rpx; }
.cell2 { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.cell2 .lbl { font-size: 28rpx; color: #666; }
/* round151：picker 补下拉箭头 —— 改前只有文字样式，真机上看着像纯文本，用户不知道能点。 */
.picker { color: #1e3a5f; font-size: 30rpx; min-height: 88rpx; line-height: 88rpx; }
.picker::after { content: '▾'; margin-left: 12rpx; font-size: 28rpx; color: #1e3a5f; }
/* round153：明细行输入框补边框 —— 本页用 `.cell2`（不是 `.field`），拿不到 app.wxss 那条
   `.field input` 的边框/底色 ⇒ 改前所有输入框就是"右对齐的一行字"，跟纯文本没有区别
   （真机实测：老板找不到能下手的地方）。边框色沿用 app.wxss:29 的 #cfdae8，不另起一套。 */
.cell2 .val-input { box-sizing: border-box; text-align: right; padding: 14rpx 18rpx;
  min-height: 88rpx; border: 2rpx solid #cfdae8; border-radius: 10rpx; background: #fff; }
/* round153：单位格 —— 给"这一格是单位、不是数字的一部分"划出视觉边界。
   改前数字与单位紧挨着，实测被连读成「50 克」（老板以为自己在填数量）。
   手段：浅底 + 自身圆角 + 左侧留白，三者叠加，跟白底输入框自然分开。 */
.unit-pick { margin-left: 12rpx; padding: 0 24rpx; background: #e8eff7;
  border-radius: 10rpx; color: #1e3a5f; font-size: 30rpx; min-height: 88rpx; line-height: 88rpx; }
/* 用量 / 单价的数值框：定宽留出右侧单位格的位置（不再独占整行） */
.qty-input, .price-input { width: 200rpx; }
.qty-wrap { display: flex; align-items: center; }
/* round153：删行按钮 —— 挪到整行末尾、写成四个字的危险色文字。
   色沿用原本红叉按钮的 #e74c3c（不新增品牌色）；高度≥88rpx 满足 AD 下界。 */
.del-row { margin-top: 8rpx; padding: 0 4rpx; text-align: right;
  font-size: 28rpx; color: #e74c3c; min-height: 88rpx; line-height: 88rpx; }
/* round151：跨计量族提示条。字号 28rpx = 新增下界；告警色不入品牌色单源（单源只管墨蓝/浅底） */
.warn-hint { margin: 0 0 8rpx 4rpx; font-size: 28rpx; line-height: 1.5; color: #b45309; }
.reverse { background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx; margin-bottom: 16rpx; }

/* round156：连续录入横幅 —— 保存成功后就地显示"存的是哪道菜" + 显式返回出口。
   改前存完立刻 navigateBack 把人踢回列表（录 30 道菜来回 60 次）。
   色沿用主色系 #1e3a5f / #e8eff7（不新增品牌色）；字号 28rpx 起（新增下界）。
   触摸下界 88rpx —— 「返回列表」是唯一出口，必须够大够好点。 */
.saved-bar { display: flex; align-items: center; justify-content: space-between;
  background: #e8eff7; border-radius: 12rpx; padding: 8rpx 24rpx; margin-bottom: 16rpx; }
.saved-txt { flex: 1; font-size: 28rpx; color: #1e3a5f; line-height: 1.5; padding: 12rpx 0; }
.saved-go { font-size: 28rpx; color: #2b7de9; min-height: 88rpx; line-height: 88rpx; padding-left: 16rpx; }

/* M3.16（批次 C）套餐：子卡选择行 + 三个显示数。色/字号沿用既有 spec-box / del-row / unit-pick 风格，不新增品牌色。 */
.combo-box { margin: 8rpx 0 4rpx; padding: 16rpx 20rpx 20rpx; background: #f5f8fc; border-radius: 12rpx; }
.combo-row { display: flex; align-items: center; margin-top: 8rpx; }
.combo-pick { flex: 1; padding: 0 24rpx; background: #fff; border-radius: 10rpx; color: #1e3a5f;
  font-size: 30rpx; min-height: 88rpx; line-height: 88rpx; border: 1rpx solid #e8eff7; }
/* ===== R234/J4f · 行内长提示折叠（句级，仓内统一形态）=====
 * body 底色 #f3f7fb 与全局 `.hint` 同色；不套外层白卡（防双层圆角）。
 * 🔴 字号 ≥28rpx（AD-G1）、头行 min-height ≥88rpx（AD-G2）。 */
.hint-fold { padding: 0 0 6rpx; }
.hint-fold-head { display: flex; align-items: center; justify-content: space-between;
  min-height: 88rpx; padding: 14rpx 8rpx; }
.hint-fold-guide { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-arrow { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-body { font-size: 28rpx; color: #4a5b70; line-height: 1.6; padding: 16rpx 20rpx;
  background: #f3f7fb; border-radius: 12rpx; margin: 0 0 12rpx; }

/* ===== P0#7（2026-10-11）：新手/专业模式（与 M1 录入页同形）+ 反算前置说明 ===== */
.im-wrap { padding: 4rpx 0 8rpx; }
.im-sec { font-size: 28rpx; color: #6b7a8d; padding: 0 0 10rpx 8rpx; }
.im-opts { display: flex; gap: 12rpx; }
.im-opt { flex: 1; min-width: 0; padding: 16rpx 14rpx; border-radius: 12rpx; border: 2rpx solid #e3eaf2; background: #fff; }
.im-opt.on { border: 2rpx solid #1e3a5f; background: #e8eff7; }
.im-h { font-size: 28rpx; font-weight: 600; color: #1e3a5f; }
.im-d { font-size: 28rpx; color: #6b7a8d; margin-top: 6rpx; }
.im-tip { font-size: 28rpx; color: #8a94a6; line-height: 1.5; padding: 6rpx 8rpx 4rpx; }
.im-expand { padding: 16rpx 0 4rpx; }
.btn-block { width: 100%; min-height: 88rpx; }
.rev-pre { font-size: 28rpx; color: #8a94a6; line-height: 1.5; margin-bottom: 12rpx; }

/* ===== R372（M3 UI 收紧）=====
 * 问题（模拟器实测，novice 新建态）：整页 1561px ≈ 3.15 屏；其中
 *   · 8 个 `.field` 各自是一张白卡（padding 24rpx × 上下 + margin 16rpx）⇒ 每个 62~115px
 *   · **一个配料就是一张 299px 的卡**（输入方式 / 原料 / 换算说明 / 用量 / 组件 / 删除 各占一行）
 * ⇒ 老板建一张卡要滚三屏，且看不出"填到哪一步了"。
 * 手法（不删任何功能、不动任何计算）：
 *   ① `.field` 从"一张卡一个字段"改成"设置列表行"：无上下内边距、行高 96rpx、1rpx 分隔线；
 *   ② `.field` 允许换行 —— 例外说明（`.muted`）独占一行，不再被挤成 40px 宽的数字窄列
 *      （这正是"竖排"的同族病：flex 行里塞第三块）；
 *   ③ 输入框在本页收窄（覆盖全局 `.field input{min-width:320rpx}`），给标签让位；
 *   ④ 配料卡与单元格的留白各收一档（触控下界 88rpx 不动）。
 */
.sec-lite { font-size: 28rpx; color: #6b7a8d; padding: 20rpx 8rpx 8rpx; }

.form .field {
  padding: 0 20rpx;
  min-height: 96rpx;
  margin-bottom: 1rpx;
  border-radius: 6rpx;
  flex-wrap: wrap;
}
.form .field .lbl { flex: 0 0 auto; padding-right: 16rpx; }
.form .field .val-input { flex: 0 0 auto; width: 220rpx; min-width: 0; box-sizing: border-box; }
.form .field .mode-group { flex: 1; justify-content: flex-end; }
.form .field .muted { flex: 0 0 100%; padding: 0 0 10rpx; line-height: 1.45; }
/* ⚠️ 88rpx 是 AD-G2 触控下界，不能为紧凑再压 */
.form .field .picker { min-height: 88rpx; line-height: 88rpx; text-align: right; }

.line { padding: 10rpx 20rpx; margin-bottom: 10rpx; }
.cell2 { padding: 4rpx 0; }
.del-row { margin-top: 0; }

/* ===== R374：吸底动作条 =====
 * 为什么需要：保存按钮在第三屏底部（整页 1367px，见 R372 实测），改一个字段也要滚到底。
 * 为什么左边写「上次试算」而不是「当前成本」：成本只由 calcBom 返回，页面**不抄算法**；
 *   输入改了但没重算时，标"当前成本"就是拿旧数骗人（R359/R370 同一个坑）。
 * 触控：可点区域 min-height 88rpx（AD-G2），保存按钮同高。 */
.form.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx); }
.sticky-act { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 12rpx);
  background: #ffffff; border-top: 1rpx solid #e6ebf2;
  box-shadow: 0 -4rpx 16rpx rgba(30, 58, 95, 0.06); }
.sa-l { flex: 1; min-width: 0; min-height: 88rpx; display: flex; align-items: center;
  flex-wrap: wrap; column-gap: 12rpx; padding-right: 12rpx; }
.sa-cap { font-size: 28rpx; color: #6b7a8d; }
.sa-val { font-size: 34rpx; font-weight: 800; color: #1e3a5f; font-variant-numeric: tabular-nums; }
.sa-mg { font-size: 28rpx; color: #2f6b4f; }
.sa-empty { font-size: 28rpx; color: #8a94a6; }
.sa-btn { width: 220rpx; margin: 0; min-height: 88rpx; font-size: 30rpx; padding: 0; }
