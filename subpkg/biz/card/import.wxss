/* subpkg/biz/card/import.wxss —— P0-4 批量导入（R566）
 * 色沿用主色 #1e3a5f；三色徽标与成本卡列表的「绿/橙/红」同义（绿=已齐、橙=待补价、红=缺信息）。
 * 字号 ≥28rpx、触控 ≥88rpx（AD-G1/G2）。 */
.imp-page { padding: 16rpx 24rpx 40rpx; }

.imp-ta { width: 100%; min-height: 220rpx; box-sizing: border-box;
  font-size: 28rpx; line-height: 1.6; color: #1e3a5f;
  background: #f7fafd; border: 2rpx solid #dde7f2; border-radius: 12rpx;
  padding: 16rpx; margin-top: 8rpx; }
.imp-ta-ph { color: #776C5E; font-size: 28rpx; }
.imp-tip { margin-top: 12rpx; line-height: 1.6; }
/* 🔴 R570-G：只占内容宽度（块级 .btn 会长到满宽 ⇒ 看起来像「主操作」，把解析按钮比下去）；
   margin-top 清零是因为 .btn 自带 24rpx，叠加后与输入框离得太远。 */
.imp-clip-row { display: flex; margin-top: 16rpx; }
.imp-clip-row .imp-clip { flex: 0 0 auto; margin-top: 0; min-width: 280rpx; }

.imp-summary { font-size: 30rpx; font-weight: 600; color: #1e3a5f;
  padding: 20rpx 4rpx 12rpx; }
/* R702（P0-B）：对账行 —— 弱于汇总行，但字号仍 ≥28rpx（AD-G2 触达/可读下限） */
.imp-recon { font-size: 28rpx; color: #776C5E; padding: 0 4rpx 16rpx; line-height: 1.6; }

/* R702（P0-A）：整表被拒的说明块。用暖色警示而非红色报错 ——
   这不是"系统坏了"，是"你拿错表了，换一张就行"，语气要给出路。 */
.imp-block { margin: 28rpx 4rpx; padding: 28rpx 24rpx;
  background: #FFF7E8; border-left: 8rpx solid #E8A33D; border-radius: 12rpx; }
.imp-block-text { font-size: 28rpx; color: #6B4A1F; line-height: 1.8;
  white-space: pre-line; }   /* 文案里的 \n 要真换行，否则两句话挤成一坨 */
.imp-go-hint { margin: 4rpx 4rpx 16rpx; line-height: 1.6; }

.imp-item { background: #FFFDF8; border-radius: 16rpx; padding: 20rpx; margin-bottom: 14rpx; }
.imp-head { display: flex; align-items: center; justify-content: space-between; }
.imp-name { font-size: 32rpx; font-weight: 600; color: #1e3a5f; flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.imp-badge { flex: none; font-size: 28rpx; border-radius: 8rpx; padding: 6rpx 14rpx; margin-left: 12rpx; }
.imp-badge-green { color: #1f7a4d; background: #e6f6ec; }
.imp-badge-orange { color: #92610a; background: #fdf3d8; }
.imp-badge-red { color: #b3261e; background: #fdeceb; }
/* R704：已保存徽章 —— 比绿色再重一档（实心），因为它是「这件事做完了」而不是「数据齐了」 */
.imp-badge-saved { color: #ffffff; background: #1f7a4d; }

/* R704：开做之前的准备（原料库体检）。放在粘贴框之前。
   空库用暖色警示（给的是"先去建料"这条出路，不是报错）；有料用中性底，只是一句提示。 */
.imp-prereq { margin: 0 0 20rpx; padding: 24rpx 22rpx;
  background: #F5F8FB; border: 2rpx solid #dde7f2; border-radius: 14rpx; }
.imp-prereq-warn { background: #FFF7E8; border-color: #E8A33D; }
.imp-prereq-k { display: block; font-size: 28rpx; color: #776C5E; margin-bottom: 8rpx; }
.imp-prereq-t { display: block; font-size: 30rpx; font-weight: 600; color: #1e3a5f; line-height: 1.5; }
.imp-prereq-warn .imp-prereq-t { color: #6B4A1F; }
.imp-prereq-d { display: block; font-size: 28rpx; color: #776C5E; line-height: 1.7; margin-top: 8rpx; }
.imp-prereq-btn { display: inline-flex; margin-top: 16rpx; min-height: 88rpx; }

.imp-meta { display: flex; align-items: center; justify-content: space-between;
  margin-top: 14rpx; gap: 16rpx; }
/* 分类选择器（左侧，可点区域 ≥88rpx 高） */
.imp-cat { min-height: 88rpx; min-width: 240rpx; display: flex; align-items: center;
  font-size: 28rpx; color: #1e3a5f; background: #eef4fb; border-radius: 10rpx;
  padding: 0 16rpx; box-sizing: border-box; }
.imp-cat-none { color: #b3261e; background: #fdeceb; }
/* 售价（右侧，独立容器 ⇒ 不与按钮同父） */
.imp-price { display: flex; align-items: center; flex: none; }
.imp-price-input { width: 180rpx; height: 88rpx; box-sizing: border-box;
  text-align: right; font-size: 30rpx; color: #1e3a5f;
  background: #f7fafd; border: 2rpx solid #dde7f2; border-radius: 10rpx; padding: 0 12rpx; }
.imp-unit { font-size: 28rpx; color: #776C5E; margin-left: 8rpx; }

.imp-reason { margin-top: 12rpx; font-size: 28rpx; color: #b3261e; line-height: 1.5; }
.imp-go { margin-top: 16rpx; }

.imp-empty { font-size: 28rpx; color: #776C5E; text-align: center; padding: 60rpx 0; }

/* 🔴 R711：上次那批的接续提示。整条可点收起 —— 不另设小叉按钮，
   因为文字小叉的触控面积到不了 88rpx 红线，而整条本身轻松超过。
   字号 28rpx 是 AD 门禁下限，不再往下压。 */
.imp-resume {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 88rpx; margin: 0 0 16rpx; padding: 12rpx 20rpx;
  background: #FDF6EC; border: 2rpx solid #EFDFC4; border-radius: 12rpx;
  box-sizing: border-box;
}
.imp-resume-text { flex: 1; font-size: 28rpx; color: #7A5B2E; line-height: 1.5; }
.imp-resume-tap { flex: none; margin-left: 16rpx; font-size: 28rpx; color: #1a7d55; }
