<view class="container safe-bottom" wx:if="{{!loading}}">
  <view class="hint">{{t.versionReadonly}}</view>

  <!-- M3.19（A3）趋势柱状图：数据全来自 list，前端只做等比换算；≥2 版本才画，否则给空态文案。
       🔴 R192：由「只画成本」升级为**成本 + 售价双柱同尺度**
         —— 李老师 2026-10-03："历史版本的比较图，要有价格，也要有版本"。
         单柱只能看出成本涨跌，看不出"我涨价了没有 / 成本和售价的间距有没有被吃掉"。 -->
  <view class="trend" wx:if="{{showChart}}">
    <view class="trend-title">{{t.impactTrend}}</view>
    <!-- 图例：两条是什么，必须写出来（只靠颜色区分 = 让用户猜） -->
    <view class="trend-legend">
      <view class="lg-item"><view class="lg-dot lg-cost"></view><text>{{t.totalCost}}</text></view>
      <view class="lg-item"><view class="lg-dot lg-price"></view><text>{{t.price}}</text></view>
    </view>
    <!-- 🔴 R192 第二次修正：竖柱版在**版本多 + 金额位数多**时数字挤成一行还被裁掉（模拟器实测）。
         ⇒ 改**横向条形**：每条一行，标签/数值各有其位，版本再多也不挤。
         同尺度（都以 max(成本, 售价) 为 100%）⇒ 长短可直接比。 -->
    <view class="trend-row" wx:for="{{chartRows}}" wx:key="version">
      <text class="trend-ver">v{{item.version}}</text>
      <view class="trend-lines">
        <view class="trend-line">
          <view class="trend-track"><view class="trend-fill trend-bar-cost" style="width:{{item.heightPct}}%;"></view></view>
          <text class="trend-val">{{t.cur}}{{item.costText}}</text>
        </view>
        <view class="trend-line">
          <view class="trend-track"><view class="trend-fill trend-bar-price" style="width:{{item.priceHeightPct}}%;"></view></view>
          <text class="trend-val">{{item.priceKnown ? t.cur + item.priceText : item.priceText}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="trend-empty" wx:else>{{t.impactTrendSingle}}</view>

  <view class="card2" wx:for="{{list}}" wx:key="version" wx:for-item="v">
    <view class="card-title">
      {{v.name}} <text class="tag">{{t.version}} {{v.version}}</text>
      <text class="tag">{{v.calc_mode}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.versionCreatedAt}}</text>
      <text class="val muted">{{v.created_at}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.totalCost}}</text>
      <text class="val">{{t.cur}}{{v.total_cost}}</text>
    </view>
    <view class="cell">
      <text class="lbl">{{t.price}}</text>
      <text class="val">{{v.price}}</text>
    </view>

    <view class="lines-title">{{t.versionLines}}</view>
    <view class="line-row" wx:for="{{v.lines}}" wx:key="index" wx:for-item="l">
      <view class="line-main">
        <text class="lbl">{{l.material_name}} × {{l.quantity}}</text>
        <text class="val muted">{{t.cur}}{{l.line_net_cost}}</text>
      </view>
      <!-- S0 快照 5 字段（只读灰字） -->
      <view class="snapshot" wx:if="{{l.brand_spec || l.purchase_unit || l.purchase_price || l.convert_factor || l.yield_rate}}">
        <text wx:if="{{l.brand_spec}}">{{t.snapshotBrand}}：{{l.brand_spec}}</text>
        <text wx:if="{{l.purchase_unit}}">{{t.snapshotUnit}}：{{l.purchase_unit}}</text>
        <text wx:if="{{l.purchase_price}}">{{t.snapshotPrice}}：{{t.cur}}{{l.purchase_price}}</text>
        <text wx:if="{{l.convert_factor}}">{{t.snapshotConvert}}：{{l.convert_factor}}</text>
        <text wx:if="{{l.yield_rate}}">{{t.snapshotYield}}：{{l.yield_rate}}%</text>
      </view>
    </view>

    <!-- S0（任务 2）恢复此版本 -->
    <button class="btn ghost btn-small" style="min-height:88rpx;" data-v="{{v}}" bindtap="onRestore">{{t.restoreVersion}}</button>
  </view>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">{{t.oldVersionNote}}</view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>