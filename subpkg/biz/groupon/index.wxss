/* subpkg/biz/groupon/index.wxss —— M3.37/R190 到店团购试算页。
   复用 app.wxss 全局类（.container/.sec/.field/.cell/.btn/.muted/.safe-bottom/.sb-page）；
   本文件只补全局缺失的局部类（.lbl/.val-input/.pick/.base-note/.warn/.strong），
   字号一律 ≥28rpx、触控行 ≥88rpx（与外卖页同红线）。 */

/* 口径提示条（与外卖页同配色，不新增品牌色） */
.base-note { font-size: 28rpx; color: #b45309; line-height: 1.5; margin: 0 4rpx 16rpx; padding: 10rpx 16rpx; background: #fdf6ec; border-radius: 10rpx; }

/* 字段标签 */
.lbl { font-size: 28rpx; color: #1e3a5f; flex-shrink: 0; }

/* 金额录入框（落在 .field 内，复用 .field input 的右对齐 + 32rpx） */
.val-input { flex: 1; padding: 0 20rpx; background: #fff; border: 1rpx solid #e8eff7; border-radius: 10rpx; min-height: 88rpx; font-size: 28rpx; }

/* 选卡 picker 触发器 */
.pick-grow { flex: 1; }
.pick { padding: 0 24rpx; background: #fff; border: 1rpx solid #e8eff7; border-radius: 10rpx; color: #1e3a5f; font-size: 28rpx; min-height: 88rpx; line-height: 88rpx; }

/* 结果行强调 */
.val.strong { font-weight: 700; }

/* 亏本警示 */
.warn { font-size: 28rpx; color: #e74c3c; line-height: 1.5; margin: 10rpx 4rpx; }
