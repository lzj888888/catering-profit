<view class="container safe-bottom">
  <!-- ① 粘贴区 -->
  <view class="card2">
    <view class="cell"><text class="lbl">{{t.guide}}</text></view>
    <view class="tip">{{t.cols}}</view>
    <view class="tip">{{t.quick}}</view>
    <view class="tip">{{t.headerAuto}}</view>
    <textarea class="paste" value="{{text}}" placeholder="{{t.ph}}" bindinput="onText" maxlength="-1" />
    <view class="tip">{{t.pasteTip}}</view>
    <view class="tip">{{t.needConv}}</view>
  </view>

  <view class="top-row">
    <button class="btn primary full-btn" bindtap="onParse">{{parseBtn}}</button>
  </view>

  <!-- ② 预览区（解析后才出现） -->
  <block wx:if="{{parsed}}">
    <view class="sec">
      <text class="sec-title">{{t.preview}}</text>
      <text class="sec-count">{{countText}}</text>
    </view>

    <!-- 🔴 R705：整表拦截（菜品销售表被当成原料表粘进来）——
         不再产 12 条红行。红行会让老板以为"要一条条补单位"，而真实原因是**表选错了**。 -->
    <view class="guard guard-block" wx:if="{{blocked}}">
      <text class="guard-t">{{t.blockTitle}}</text>
      <text class="guard-b">{{t.blockBody}}</text>
      <text class="guard-s">{{blockSample}}</text>
    </view>

    <view wx:if="{{!blocked && rows.length === 0}}" class="empty">{{t.none}}</view>

    <!-- 🔴 R705：一条可导行都没有时，**不给**「全选 / 全不选 / 导入」——
         一排点下去毫无反应、还被禁用的按钮，体感就是"这页面卡死了"（李老师原话「都点不动」）。
         这里只留一件事：告诉他怎么改，并且**不用退出重来**。 -->
    <view class="guard guard-bad" wx:if="{{allBadTitle}}">
      <text class="guard-t">{{allBadTitle}}</text>
      <text class="guard-b">{{t.allBadBody}}</text>
      <button class="btn ghost guard-btn" bindtap="onBackTop">{{t.backTop}}</button>
    </view>

    <view class="top-row" wx:if="{{okCount > 0}}">
      <button class="btn-small ghost ops-btn" bindtap="onSelectAll">{{t.selectAll}}</button>
      <button class="btn-small ghost ops-btn" bindtap="onUnselect">{{t.unselect}}</button>
    </view>

    <view class="card2 stripe-material {{item.checked ? 'row-on' : ''}}" wx:for="{{rows}}" wx:key="index" data-i="{{index}}" catchtap="onToggleRow">
      <view class="cell">
        <text class="lbl">{{item.name}}</text>
        <text class="val">{{t.cur}}{{item.priceText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{item.specText}}</text>
        <text class="val" wx:if="{{item.checked}}">{{t.checked}}</text>
      </view>
      <view class="tip">{{item.src}}</view>
      <view class="err-row" wx:for="{{item.errors}}" wx:for-item="e" wx:key="*this">
        <text class="err">{{e}}</text>
      </view>
    </view>

    <view class="top-row" wx:if="{{okCount > 0}}">
      <button class="btn primary full-btn" bindtap="onSave" disabled="{{saving || checkedCount === 0}}">{{saveBtn}}</button>
    </view>
  </block>

  <!-- ③ 结果区 -->
  <view class="card2" wx:if="{{doneText}}">
    <view class="cell"><text class="val ok-text">{{doneText}}</text></view>
    <view class="err" wx:if="{{failText}}">{{failText}}</view>
    <view class="top-row">
      <button class="btn-small ghost ops-btn" catchtap="backToList">{{t.back}}</button>
    </view>
  </view>
</view>
