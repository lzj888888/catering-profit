/* pages/material/batch.wxss —— round204 原料批量录入页样式
 * ⚠️ 字号一律 ≥28rpx、触控区 ≥88rpx（selftest_ad_gates G1/G2 硬判据）。
 * ⚠️ 主色不在此另写一份（色值单源 app.wxss），此处只排布局。
 */
.paste {
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #d9e2ec;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
}
.tip {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #7b8794;
}
.sec {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 12rpx;
}
.sec-title { font-size: 32rpx; color: #1e3a5f; }
.sec-count { font-size: 28rpx; color: #7b8794; }
.card2.row-on { border-left: 8rpx solid #1e3a5f; }
.err-row { margin-top: 8rpx; }
.err { font-size: 28rpx; line-height: 1.6; color: #c0392b; }
.ok-text { color: #1e3a5f; }
