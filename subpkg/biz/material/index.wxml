<view class="container safe-bottom sb-page" wx:if="{{!loading}}">
  <!-- R191：与成本卡列表**同构** —— 顶部「搜索 + 新增」同一行（新增不再沉到页面最底部） -->
  <view class="top-row">
    <view class="inp top-inp"><input value="{{keyword}}" placeholder="{{t.matSearchPh}}" bindinput="onKeyword" /></view>
    <button class="btn primary top-add" bindtap="goAdd">{{t.matAdd}}</button>
    <!-- round204：批量录入（粘贴 Excel → 解析 → 导入）。与「新增原料」**并列可见**，
         不收纳进「⋯」—— R192 教训：功能按钮沉进二级菜单 ⇒ 李老师反馈「功能按钮都丢了」。 -->
    <button class="btn ghost top-add" bindtap="goBatch">{{t.batchEntry}}</button>
  </view>

  <picker mode="selector" range="{{catOptions}}" range-key="label" bindchange="onCatFilter">
    <view class="cell cat-picker sb-card">
      <text class="lbl">{{t.filterCategory}}</text>
      <text class="val">{{catLabel || t.marginAll}}</text>
    </view>
  </picker>

  <!-- 原料列表（左侧色条 = 原料绿，色值走 app.wxss 的 .stripe-material 单源）
       🔴 R437（队列 #6）：加 `sb-card` = 走风格 B 的外壳（底色/圆角/阴影，取值单源在 app.wxss）；
           `.card2` 的 border-left 与 overflow 仍由本页 wxss 给（色条形态是本页专属）。 -->
  <view class="card2 stripe-material sb-card" wx:for="{{list}}" wx:key="id" data-m="{{item}}" bindtap="goEdit">
    <view class="card-head">
      <view class="card-title card-title-flex mat-title">
        <!-- R207：名称单独一层做 ellipsis（长名截断），标签保持可见不被挤掉 -->
        <text class="mat-name">{{item.name}}</text>
        <!-- round156：置顶标记（排序把它们排到最前，界面必须说清"为什么它在前面"） -->
        <text class="tag tag-pin" wx:if="{{item.pinned}}">{{t.pinTag}}</text>
        <text class="tag" wx:if="{{item.is_virtual}}">{{t.matVirtual}}</text>
        <text class="tag" wx:else>{{item.category_label}}</text>
      </view>
      <!-- 🔴 R192：标题行不再放「⋯」（收纳过度 ⇒ 李老师反馈「功能按钮都丢了」）；
           操作统一走卡片底部 ops-mini 行，与成本卡列表同构。 -->
    </view>
    <!-- 🔴 R377（M3 密度对齐）：原来 4 行竖排（品牌 / 单价 / 换算 / 净料成本），
         一张卡约 330rpx ⇒ 一屏只能放 2 张。改为：
           ① 主行 = 净料成本（老板真正比价的那个数）+ 采购价，一行说完；
           ② 品牌规格**为空就不渲染**（原来恒渲染一个「—」占 60rpx）；
           ③ 换算单独一行且只在有换算时出现（round149 的语义不变，只是不再占空行）。
         信息一个字没删，只是不再"每条信息各占一行"。 -->
    <view class="cell-inline mat-kv">
      <text class="lbl">{{t.matNetCost}}</text>
      <text class="val mat-strong">{{t.cur}}{{item.net_cost}}</text>
      <!-- 标签必须短；也不要「·」分隔 —— 实测 dot 两侧各 16rpx 边距白占 26px，带它整行必折 -->
      <text class="lbl mat-lb2">{{t.matPurchase}}</text>
      <text class="val">{{item.purchase_unit}} · {{t.cur}}{{item.purchase_price}}</text>
    </view>
    <view class="cell-inline mat-kv" wx:if="{{item.brand_spec}}">
      <text class="lbl">{{t.matBrand}}</text>
      <text class="val mat-brand">{{item.brand_spec}}</text>
    </view>
    <!-- round149：同一原料可以有不同规格/单位 ⇒ 把「买 → 用」的换算写在卡片上 -->
    <view class="cell-inline mat-kv" wx:if="{{item.spec_line}}">
      <text class="lbl">{{t.matConvert}}</text>
      <text class="val mat-spec">{{item.spec_line}}</text>
    </view>

    <!-- 🔴 R192：操作行 —— 「涨价影响面」是原料库**最高频**的动作（改价前先看影响谁），必须看得见。
         ⚠️ 虚拟原料（只读）不给影响面：它没有价格，点了只会报错 ⇒ 只留「⋯」。 -->
    <view class="ops-mini">
      <button class="btn-small ghost ops-btn" wx:if="{{!item.is_virtual}}" catchtap="goImpact" data-m="{{item}}">{{t.impactTitle}}</button>
      <!-- 虚拟原料没有价格 ⇒ 不给影响面（点了只会报错），靠这个占位把「⋯」推到右边，与其他卡对齐 -->
      <view class="ops-spacer" wx:else></view>
      <view class="more round" catchtap="onMore" data-m="{{item}}">⋯</view>
    </view>
  </view>

  <!-- 🔴 R385：搜索无结果 ≠ 库里没有。原来只有一句「还没有原料」，搜不到会让老板以为原料没录进去。 -->
  <view wx:if="{{list.length === 0 && !loading && keyword}}" class="empty">{{t.matNoMatch}}</view>
  <view wx:elif="{{list.length === 0 && !loading}}" class="empty">{{t.matEmpty}}</view>
</view>
<view wx:else class="container sb-page"><view class="muted">{{t.loading}}</view></view>
