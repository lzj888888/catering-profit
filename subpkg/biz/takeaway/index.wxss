/* pages/takeaway/index.wxss —— M3.17 外卖单均试算页。色沿用主色系 #1e3a5f / #F5EBD8，不新增品牌色。 */

/* 顶层 tab（单均测算 / 账单导入） */
.tab-bar { display: flex; background: #F0E9DC; border-radius: 12rpx; padding: 6rpx; margin-bottom: 16rpx; }
.tab-item { flex: 1; text-align: center; font-size: 28rpx; color: #776C5E; min-height: 88rpx; line-height: 88rpx; border-radius: 10rpx; }
.tab-item.on { background: #1e3a5f; color: #fff; font-weight: 600; }
.hint { font-size: 28rpx; color: #776C5E; line-height: 1.5; margin: 8rpx 4rpx 16rpx; }

/* 口径切换 */
.mode-switch { display: flex; background: #F0E9DC; border-radius: 12rpx; padding: 6rpx; margin-bottom: 10rpx; }
.mode-tab { flex: 1; text-align: center; font-size: 28rpx; color: #776C5E; min-height: 88rpx; line-height: 88rpx; border-radius: 10rpx; }
.mode-tab.on { background: #1e3a5f; color: #fff; font-weight: 600; }
.mode-desc { font-size: 28rpx; color: #776C5E; line-height: 1.5; margin: 6rpx 4rpx 12rpx; }
/* 🔴 R724j（台账 R2-6）：口径说明块**降视觉重量**。
   改前：浅黄底 + 整块 padding + 圆角 ⇒ 首屏 4 个这样的块连成一片色块墙，
   老板扫一眼就「整段跳过」（李老师真机原话同型问题）。
   改后：去底色、去圆角，只留左侧一条竖线 + 内边距 ⇒ 从「4 个色块」变成
   「4 行带标记的说明」，信息量一字未减、位置一字未动（check_takeaway_semantics
   的 B-④ 位置断言照旧成立），但不再形成视觉阻断。
   ⚠️ 字号仍 28rpx（AD 红线下限），颜色只调亮不改色相。
   🔴 R730 更正：R724j「调亮」调过头了 —— #b45309 → #a16207 虽然观感更轻，但**在页面真实底色
   #F6F3EC 上只有 4.44:1，压到 WCAG AA 4.5 线下**（改前 #b45309 是 4.53:1，本来刚好过）。
   根子：check_text_contrast 是「旧坏色黑名单」不是算比值的守卫 ⇒ 新增低对比色一律漏过，
   所以这条只能靠人算。现取 #9a5c06：页面底 4.85:1 / 卡片底 #FFFDF8 5.29:1，双底均过 AA，
   且是「能过线的最浅候选」—— 保住降视觉重量的原意，色相不变。 */
.base-note {
  font-size: 28rpx;
  color: #9a5c06;
  line-height: 1.5;
  margin: 0 4rpx 14rpx;
  padding: 2rpx 0 2rpx 16rpx;
  background: transparent;
  border-left: 4rpx solid #f0c680;
  border-radius: 0;
}

/* 区块标题 */
.sec { font-size: 30rpx; color: #1e3a5f; font-weight: 600; margin: 24rpx 0 10rpx; }

/* 行（菜品 / 包材） */
.row { display: flex; align-items: center; margin-bottom: 10rpx; }
.pick-grow { flex: 1; }
.pick { padding: 0 24rpx; background: #FFFDF8; border: 1rpx solid #F5EBD8; border-radius: 10rpx; color: #1e3a5f; font-size: 28rpx; min-height: 88rpx; line-height: 88rpx; }
.qty-input, .price-input { width: 160rpx; margin-left: 12rpx; padding: 0 16rpx; background: #FFFDF8; border: 1rpx solid #F5EBD8; border-radius: 10rpx; min-height: 88rpx; font-size: 28rpx; }
.del { margin-left: 12rpx; color: #c0392b; font-size: 40rpx; min-width: 88rpx; min-height: 88rpx; line-height: 88rpx; text-align: center; }

/* 字段 */
.field { display: flex; align-items: center; margin-bottom: 12rpx; flex-wrap: wrap; }
.lbl { font-size: 28rpx; color: #1e3a5f; width: 220rpx; flex-shrink: 0; }
.val-input { flex: 1; padding: 0 20rpx; background: #FFFDF8; border: 1rpx solid #F5EBD8; border-radius: 10rpx; min-height: 88rpx; font-size: 28rpx; }
.mode-group { display: flex; }
.mode-item { margin-right: 24rpx; font-size: 28rpx; color: #3A332B; display: flex; align-items: center; }
.payer-pick { padding: 0 24rpx; background: #F5EBD8; border-radius: 10rpx; color: #1e3a5f; font-size: 28rpx; min-height: 88rpx; line-height: 88rpx; margin-left: 12rpx; }

/* 结果 */
.cell { display: flex; justify-content: space-between; padding: 12rpx 4rpx; border-bottom: 1rpx solid #F0E9DC; }
.val { font-size: 30rpx; color: #1e3a5f; }
.val.strong { font-weight: 700; }
.warn { font-size: 28rpx; color: #c0392b; line-height: 1.5; margin: 10rpx 4rpx; }

.btn { margin-top: 12rpx; }

/* ===== R234/J4d · 行内长提示折叠（句级，与月录入页 / M2 / assetEdit / amortize 同形）=====
 * 本页折 2 处（importPickHint 22 字 / importShapeCHint 20 字）；
 * `importPickPlatformHint`（17 字）**故意保持平铺** —— 它是确认按钮紧下方的操作提示。
 * body 底色 #FBF6EC 与全局 `.hint` 同色 ⇒ 折叠前后视觉连贯。
 * 🔴 字号一律 ≥28rpx（AD-G1）、头行 min-height ≥88rpx（AD-G2）。 */
.hint-fold { padding: 0 0 6rpx; }
.hint-fold-head { display: flex; align-items: center; justify-content: space-between;
  min-height: 88rpx; padding: 14rpx 8rpx; }
/* R282：折叠块标题（「去哪下载这张表？」）—— flex:1 占满剩余空间，
   把右侧「展开看看 ▸」推到最右（head 是 space-between 的 flex）。
   字号 28rpx = 本仓 UI 下限（记忆红线：新增字号 ≥28rpx），色值取品牌墨蓝 #1e3a5f（app.wxss 单源）。 */
.hint-fold-title { font-size: 28rpx; color: #1e3a5f; font-weight: 600; flex: 1; }
.hint-fold-guide { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-arrow { font-size: 28rpx; color: #1e3a5f; }
.hint-fold-body { font-size: 28rpx; color: #6B6157; line-height: 1.6; padding: 16rpx 20rpx;
  background: #FBF6EC; border-radius: 12rpx; margin: 0 0 12rpx; }

/* P0#8 导入成功结果条（常驻，给老板明确下一步） */
.ok-bar { border: 2rpx solid #1e9e5a; background: #f1fbf5; padding: 20rpx 24rpx; border-radius: 12rpx; margin-top: 16rpx; }
.ok-title { font-size: 32rpx; font-weight: 600; color: #1a7d55; margin-bottom: 8rpx; }
.ok-bar .btn { margin-top: 16rpx; }
.btn-block { width: 100%; }

/* R590 认不出表时的「让 AI 帮你转」逃生口。
   copied-hint 用绿色＝「这一步成了」，与 warn（红＝要改）区分开；
   ai-fix-text 只在复制失败时摊开正文，所以要可选、可滚动，字号 28rpx 守 G1 下限。 */
.ai-fix-hint { font-size: 28rpx; color: #6B6157; line-height: 1.5; margin: 12rpx 4rpx 8rpx; }
.copied-hint { font-size: 28rpx; color: #1a7d55; line-height: 1.5; margin: 12rpx 4rpx 0; }
.ai-fix-text { display: block; font-size: 28rpx; color: #6B6157; line-height: 1.6;
  background: #f5f7fa; border-radius: 8rpx; padding: 16rpx 20rpx; margin-top: 12rpx;
  white-space: pre-wrap; word-break: break-all; max-height: 600rpx; overflow-y: auto; }

/* P1 · 逐行毛利（本单各菜品/套餐毛利；字号一律 ≥28rpx，守 selftest_ad_gates G1）*/
.ci-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.ci-name { font-size: 28rpx; color: #1e3a5f; }
.tag-combo { font-size: 28rpx; color: #fff; background: #1e3a5f; border-radius: 6rpx; padding: 2rpx 12rpx; margin-left: 12rpx; }
.ci-right { display: flex; align-items: center; flex-shrink: 0; margin-left: 12rpx; }
.ci-meta { font-size: 28rpx; color: #776C5E; margin-right: 16rpx; }
.ci-profit { font-size: 30rpx; color: #1a7d55; font-weight: 600; }

/* ===== R615 M3 决策台 Q3：外卖瀑布 =====
   条高 28rpx、圆角 8rpx；颜色沿用页面既有色系（暖=平台费用、绿=到手）。 */
.wf-bar { display: flex; height: 28rpx; border-radius: 8rpx; overflow: hidden; margin: 12rpx 4rpx; background: #F0E9DC; }
.wf-seg { height: 100%; }
.wf-commission { background: #c2701a; }
.wf-delivery { background: #2a7fa8; }
.wf-deliverySubsidy { background: #7f77dd; }
.wf-subsidyMerchant { background: #b0528a; }
.wf-promo { background: #A99E8E; }
.wf-receipt { background: #1a7d55; }
.wf-legend { display: flex; flex-wrap: wrap; margin: 4rpx 4rpx 12rpx; }
.wf-li { font-size: 28rpx; color: #6B6157; margin-right: 18rpx; }
.wf-li-receipt { color: #1a7d55; font-weight: 600; }

/* 🔴 R712：选文件按钮上方的「会跳到微信」预告。两页共用（渠道营收 / 销量导入）。
   不折叠：这是**点之前**必须看到的，折起来等于没说。28rpx 是 AD 门禁下限。 */
.pick-jump-hint { font-size: 28rpx; color: #7A5B2E; background: #FDF6EC;
  border-radius: 12rpx; padding: 16rpx 20rpx; margin: 8rpx 0 12rpx; line-height: 1.55; }
