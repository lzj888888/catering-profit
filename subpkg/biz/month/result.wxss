/* pages/month/result.wxss —— M1 结果展示页（继承 app.wxss 共享组件） */
.expire-banner { background: #fef3c7; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.expire-ops { display: flex; gap: 16rpx; margin-top: 12rpx; }
.expire-ops .btn-small { flex: 1; }

/* D1：下钻明细面板 */
.drill-head { border-bottom: 1rpx solid #f0f0f0; }
.drill-caret { color: #1e3a5f; font-size: 28rpx; }
.drill-body { padding: 12rpx 0 16rpx; }
.drill-row { margin-bottom: 12rpx; }
.drill-gname { font-size: 28rpx; font-weight: 600; color: #333; display: flex; justify-content: space-between; }
.drill-gamt { color: #222; font-weight: 600; }
.drill-sub { display: flex; justify-content: space-between; padding: 6rpx 0 0 16rpx; font-size: 28rpx; color: #666; }
.drill-samt { color: #444; }


/* ===== round115：行业对照（指标对照 + 业态/地区选择）===== */
/* 🔴 字号下界 28rpx（26rpx 会被守卫判红）；色值单源 app.wxss */
.ind-head { padding: 4rpx 0 12rpx; }
.ind-title { font-size: 30rpx; font-weight: 500; color: #1e3a5f; }
.ind-sub { display: block; font-size: 28rpx; color: #8a94a6; margin-top: 6rpx; }

.ind-scope { display: flex; align-items: center; flex-wrap: wrap; padding-bottom: 8rpx; }
.ind-pk { font-size: 28rpx; color: #1e3a5f; border: 2rpx solid #dfe4ec; border-radius: 8rpx; padding: 6rpx 16rpx; margin-right: 16rpx; }
.ind-scope-tip { font-size: 28rpx; color: #d68910; }

.ind-row { padding: 16rpx 0; border-top: 2rpx solid #f2f4f8; }
.ind-line1 { display: flex; align-items: center; justify-content: space-between; }
.ind-name { font-size: 30rpx; color: #333; }
.ind-line2 { display: flex; align-items: baseline; margin-top: 6rpx; flex-wrap: wrap; }
.ind-mine { font-size: 28rpx; color: #1e3a5f; }
.ind-missing { font-size: 28rpx; color: #b6bcc8; }
.ind-band { font-size: 28rpx; color: #8a94a6; }

.ind-lv { font-size: 28rpx; padding: 2rpx 14rpx; border-radius: 20rpx; }
.ind-lv.lv-good { background: #eaf6f0; }
.ind-lv.lv-ok { background: #eaf0f7; }
.ind-lv.lv-warn { background: #fdf4e7; }
.ind-lv.lv-bad { background: #fdecea; }
.ind-lv.lv-na { background: #f2f4f8; }

.ind-note { font-size: 28rpx; color: #8a94a6; padding-top: 12rpx; line-height: 1.5; }

/* ===== 暖化：结果页顶部「一句话结论 + 红黄绿带」（装饰性，不碰引擎口径）===== */
/* 字号 28rpx 下界（G1 守卫）；色值走本页语义色，不引新品牌色 */
.band { border-radius: 16rpx; padding: 22rpx 24rpx; margin-bottom: 16rpx; display: flex; flex-direction: column; }
.band-label { font-size: 28rpx; color: #6b7280; margin-bottom: 6rpx; }
.band-text { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.band-red { background: #fdecea; }
.band-red .band-text { color: #c0392b; }
.band-yellow { background: #fdf4e7; }
.band-yellow .band-text { color: #b9770e; }
.band-green { background: #eaf6f0; }
.band-green .band-text { color: #1e8e5a; }

/* 🔴 R314：体检卡「展开看依据」头 —— 复用 .cell 布局，只把颜色压弱，
   让它在视觉上明显是"次要入口"，不与上面三条结论争注意力。 */
.be-more-head { border-top: 1rpx solid #f0f0f0; }
/* 🔴 字号**必须 ≥28rpx**（AD-G1 红线：老板多是老花眼，26rpx 已被守卫判红一次）。
   视觉弱化只靠**颜色/字重**，不靠缩字号。 */
.be-more-head .lbl { color: #8a97a8; }

/* R443：现金输入 + 可撑月数（字号走 28rpx 底线，selftest_ad_gates G1） */
.runway-in { flex: 1 1 auto; text-align: right; font-size: 32rpx; color: #1f2329; }
.runway-big { font-size: 36rpx; font-weight: 700; }
/* R443：结果页「下一步」文字链 —— 不造新色板，沿用页面主色 */
.next-link { font-size: 28rpx; color: #1e3a5f; padding: 24rpx 0; text-align: center; }
/* R443：近几个月走势（纯 CSS 柱状，不引图表库 —— 包体余量只剩 0.4KB 级别） */
.trend { display: flex; align-items: flex-end; justify-content: space-between; padding: 16rpx 8rpx 8rpx; }
.tb { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; }
.tb-col { height: 120rpx; display: flex; align-items: flex-end; }
.tb-bar { width: 36rpx; border-radius: 6rpx 6rpx 0 0; }
.tb-bar.up { background: #22a06b; }
.tb-bar.down { background: #e74c3c; }
.tb-lb { font-size: 28rpx; color: #646a73; margin-top: 8rpx; }
.tb-lb.on { color: #1e3a5f; font-weight: 600; }
.tb-v { font-size: 28rpx; color: #646a73; }
