<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- ===== R717：整页定位句（必须先于任何输入框）=====
       李老师 2026-11-12：「一眼就能知道这是干什么的，为什么放有这个按钮」。
       本页进来第一眼是「月份 / 在售菜品数」两个框，没有任何一句说它在算什么 ——
       R712 补的那条只解释了「在售菜品数」这一个字段，不是整页定位。
       ⚠️ 用 `.recon-why` 同一个灰字类（不新造样式，AD 红线字号已合规 28rpx）。 -->
  <view class="recon-why">{{t.reconWhatFor}}</view>

  <!-- 月份 + 在售菜品数 + 含套餐开关 -->
  <view class="field">
    <text class="lbl">{{t.reconMonth}}</text>
    <picker mode="selector" range="{{months}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="picker">{{months[monthIndex] || curMonth}}</view>
    </picker>
  </view>
  <view class="field">
    <text class="lbl">{{t.reconCoverage}}</text>
    <input class="val-input" type="number" value="{{menuDishCount}}" placeholder="{{t.reconCoveragePh}}" bindinput="onDishCount" adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- 🔴 R712（李老师真机：「只需要填在售菜品数就可以了吗？本意是算什么的」）：
       这个数是**覆盖率分母**（已建卡的菜 ÷ 在售菜数），原来只有标签、没解释用途。
       老板不知道它为什么能影响结果，就会跳过不填，然后结果一直被抑制。 -->
  <view class="recon-why">{{t.reconCoverageWhy}}</view>
  <!-- 🔴 R181j 门禁方修：保存按钮**不得与 `val-input` 同父** —— 同层 = 同行 = 金额框被挤窄
       （`tools/check_amount_input_row.js` A1 硬判据：全仓「val-input 与 button 同父」块数必须 = 0）。
       原写法把 button 放在上面那个 .field 里 ⇒ A1 实测 1 处、门禁转红。此处独立成层。 -->
  <view class="field-save">
    <button class="btn-small ghost" bindtap="onSaveCount">{{t.reconSave}}</button>
  </view>
  <view class="field">
    <text class="lbl">{{t.reconIncludeCombo}}</text>
    <switch checked="{{includeCombo}}" bindchange="onIncludeCombo" color="#1e3a5f" />
  </view>

  <!-- 结果区（抑制时只显示两个数 + 原因，不显示差值/金额/归因） -->
  <view class="card2" wx:if="{{result}}">
    <view class="cell">
      <text class="lbl">{{t.reconMenuMargin}}</text>
      <text class="val">{{result.menuPctText}}</text>
    </view>
    <!-- 🔴 R726（R714 E-1）：不写这句，数据全对老板也会读出反结论 -->
    <view class="muted">{{t.reconMenuPriceNote}}</view>
    <!-- 🔴 R729：并列双口径，不替换、不自动切换 -->
    <view class="cell">
      <text class="lbl">{{t.reconWeightedLabel}}</text>
      <text class="val">{{result.weightedPctText}}</text>
    </view>
    <view class="muted" wx:if="{{result.weightedPct !== null}}">{{t.reconWeightedNote}}</view>
    <view class="muted" wx:if="{{result.weightedPct === null}}">{{t.reconWeightedMissing}}</view>
    <view class="cell">
      <text class="lbl">{{t.reconActualMargin}}</text>
      <text class="val">{{result.actualPctText}}</text>
    </view>
    <block wx:if="{{!result.suppressed}}">
      <view class="cell">
        <text class="lbl">{{t.reconDiffPp}}</text>
        <text class="val">{{result.diffPpText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconDiffFen}}</text>
        <text class="val">{{t.cur}}{{result.diffFenText}}</text>
      </view>
    </block>
    <view class="warn" wx:if="{{result.suppressed}}">{{result.suppressText}}</view>
    <!-- 🔴 R723：只有「要去别的页补数」才给直达按钮，其余抑制原因只留文字说明 -->
    <button class="recon-fix" wx:if="{{result.fixUrl}}" bindtap="goFix">{{result.fixLabel}}</button>
  </view>

  <!-- 归因清单（只列方向，不下结论；抑制时不给） -->
  <view class="card2" wx:if="{{result && !result.suppressed}}">
    <view class="attr-title">{{t.reconAttributionTitle}}</view>
    <view class="muted">{{t.reconAttr1}}</view>
    <view class="muted">{{t.reconAttr2}}</view>
    <view class="muted">{{t.reconAttr3}}</view>
    <view class="muted">{{t.reconAttr4}}</view>
  </view>
  <!-- ===== 段二 · 耗用核查（2026-11-24 新增，李老师提需求）=====
       与上面「率对率对账」是**同一个问题的两个视角**：上面比毛利率，这里比金额。
         率视角：实际毛利率 58% vs 标准 63%   ⇒ 差 5 个百分点
         金额视角：实际耗用 1.7万 vs 理论 1.2万 ⇒ 多花 5000 元
       🔴 算不了时只显示「缺什么 + 去哪儿补」，**绝不显示假数**
         （成本卡没建全 / 没导入销量 / 没填库存 / 免费层拿不到成本，四种都要单独说清）。 -->
  <view class="card2" wx:if="{{consume}}">
    <view class="attr-title">{{t.reconConsumeTitle}}</view>
    <view class="recon-why">{{t.reconConsumeWhatFor}}</view>

    <block wx:if="{{consume.ok}}">
      <view class="cell">
        <text class="lbl">{{t.reconConsumeTheoryLabel}}</text>
        <text class="val">{{t.cur}}{{consume.theoryText}}</text>
      </view>
      <!-- 🔴 覆盖率不满 100% 时理论耗用是**外推估算**（未建卡的菜按同比例成本估），
           必须在数字正下方标明，否则老板会把估算当实算（实测 94% 覆盖下真实无偏差也显示 +11.7%）。 -->
      <view class="muted" wx:if="{{consume.extrapolated}}">{{t.reconConsumeTheoryEst}} · 已覆盖 {{consume.coveragePct}}% 销量</view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeActualLabel}}</text>
        <text class="val">{{t.cur}}{{consume.actualText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeVarianceLabel}}</text>
        <text class="val {{consume.over ? 'warn' : ''}}">{{t.cur}}{{consume.varianceText}}（{{consume.variancePctText}}）</text>
      </view>
      <!-- 倒推采购：第二个问法，和上面「差额」是同一个数（恒等式，见 utils/consumeDerive.js 文件头证明） -->
      <view class="cell">
        <text class="lbl">{{t.reconConsumeShouldPurchase}}</text>
        <text class="val">{{t.cur}}{{consume.shouldPurchaseText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeActualPurchaseLabel}}</text>
        <text class="val">{{t.cur}}{{consume.actualPurchaseText}}</text>
      </view>
      <view class="muted">{{t.reconConsumeCoverageNote}}</view>
      <view class="muted">{{t.reconConsumeNoJudge}}</view>
      <view class="warn" wx:if="{{consume.crossWarn}}">{{t.reconConsumeCrossWarn}}</view>
    </block>

    <block wx:else>
      <view class="warn">{{consume.missText}}</view>
      <!-- 🔴 只在「去别的页才能解决」时给直达按钮（免费层不给 —— 那是付费墙的事，不是数据问题） -->
      <button class="recon-fix" wx:if="{{consume.missUrl}}" bindtap="goConsumeFix" data-url="{{consume.missUrl}}">{{t.reconConsumeGoFix}}</button>
    </block>
  </view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
