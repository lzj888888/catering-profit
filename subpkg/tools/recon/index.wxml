<view class="container safe-bottom" wx:if="{{!loading}}">
  <!-- ===== R717：整页定位句（必须先于任何输入框）=====
       李老师 2026-11-12：「一眼就能知道这是干什么的，为什么放有这个按钮」。
       本页进来第一眼是「月份 / 在售菜品数」两个框，没有任何一句说它在算什么 ——
       R712 补的那条只解释了「在售菜品数」这一个字段，不是整页定位。
       ⚠️ 用 `.recon-why` 同一个灰字类（不新造样式，AD 红线字号已合规 28rpx）。 -->
  <view class="recon-why">{{t.reconWhatFor}}</view>

  <!-- 月份 + 在售菜品数 + 含套餐开关 -->
  <view class="field">
    <text class="lbl">{{t.reconMonth}}</text>
    <picker mode="selector" range="{{months}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="picker">{{months[monthIndex] || curMonth}}</view>
    </picker>
  </view>
  <view class="field">
    <text class="lbl">{{t.reconCoverage}}</text>
    <input class="val-input" type="number" value="{{menuDishCount}}" placeholder="{{t.reconCoveragePh}}" bindinput="onDishCount" adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <!-- 🔴 R712（李老师真机：「只需要填在售菜品数就可以了吗？本意是算什么的」）：
       这个数是**覆盖率分母**（已建卡的菜 ÷ 在售菜数），原来只有标签、没解释用途。
       老板不知道它为什么能影响结果，就会跳过不填，然后结果一直被抑制。 -->
  <view class="recon-why">{{t.reconCoverageWhy}}</view>
  <!-- 🔴 R181j 门禁方修：保存按钮**不得与 `val-input` 同父** —— 同层 = 同行 = 金额框被挤窄
       （`tools/check_amount_input_row.js` A1 硬判据：全仓「val-input 与 button 同父」块数必须 = 0）。
       原写法把 button 放在上面那个 .field 里 ⇒ A1 实测 1 处、门禁转红。此处独立成层。 -->
  <view class="field-save">
    <button class="btn-small ghost" bindtap="onSaveCount">{{t.reconSave}}</button>
  </view>
  <view class="field">
    <text class="lbl">{{t.reconIncludeCombo}}</text>
    <switch checked="{{includeCombo}}" bindchange="onIncludeCombo" color="#1e3a5f" />
  </view>

  <!-- ===== 员工餐 / 试吃 / 报损（2026-11-24）=====
       🔴 为什么必须填：这些东西**耗了食材但没产生销售**，不扣掉就会被全部算进差额，
         等于系统在告诉老板「你被偷了」——把正常经营损耗当舞弊（三司会诊的共识缺口）。
       ⚠️ 口径：只算「用店里食材做的」；不含发给员工的现金餐补（那在人工费用里）、不含请客招待。 -->
  <view class="field">
    <text class="lbl">{{t.reconConsumeNonsales}}</text>
    <input class="val-input" type="digit" value="{{nonsalesYuan}}" placeholder="{{t.reconConsumeNonsalesPh}}" bindinput="onNonsales" adjust-position="{{true}}" cursor-spacing="20" />
  </view>
  <view class="recon-why">{{t.reconConsumeNonsalesWhy}}</view>

  <!-- 结果区（抑制时只显示两个数 + 原因，不显示差值/金额/归因） -->
  <view class="card2" wx:if="{{result}}">
    <view class="cell">
      <text class="lbl">{{t.reconMenuMargin}}</text>
      <text class="val">{{result.menuPctText}}</text>
    </view>
    <!-- 🔴 R726（R714 E-1）：不写这句，数据全对老板也会读出反结论 -->
    <view class="muted">{{t.reconMenuPriceNote}}</view>
    <!-- 🔴 R729：并列双口径，不替换、不自动切换 -->
    <view class="cell">
      <text class="lbl">{{t.reconWeightedLabel}}</text>
      <text class="val">{{result.weightedPctText}}</text>
    </view>
    <view class="muted" wx:if="{{result.weightedPct !== null}}">{{t.reconWeightedNote}}</view>
    <view class="muted" wx:if="{{result.weightedPct === null}}">{{t.reconWeightedMissing}}</view>
    <view class="cell">
      <text class="lbl">{{t.reconActualMargin}}</text>
      <!-- 🔴 2026-11-25 真机实测修：原来这里无条件显示 actualPctText，
           而 suppressed 时的红字却写「暂不显示」⇒ 出现「100.00% + 暂不显示」并存的怪象。
           100% 的来由：账上没库存数据 ⇒ 实际成本算成 0 ⇒ 毛利率必然 100%，会误导老板以为真赚 100%。
           ⇒ 抑制态一律只显示「—」（与上面「按实际销量加权 —」同一种表示），
             真实数值等数据齐了再露。 -->
      <text class="val">{{result.suppressed ? '—' : result.actualPctText}}</text>
    </view>
    <block wx:if="{{!result.suppressed}}">
      <view class="cell">
        <text class="lbl">{{t.reconDiffPp}}</text>
        <text class="val">{{result.diffPpText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconDiffFen}}</text>
        <text class="val">{{t.cur}}{{result.diffFenText}}</text>
      </view>
    </block>
    <view class="warn" wx:if="{{result.suppressed}}">{{result.suppressText}}</view>
    <!-- 🔴 R723：只有「要去别的页补数」才给直达按钮，其余抑制原因只留文字说明 -->
    <button class="recon-fix" wx:if="{{result.fixUrl}}" bindtap="goFix">{{result.fixLabel}}</button>
  </view>

  <!-- 归因清单（只列方向，不下结论；抑制时不给） -->
  <view class="card2" wx:if="{{result && !result.suppressed}}">
    <view class="attr-title">{{t.reconAttributionTitle}}</view>
    <view class="muted">{{t.reconAttr1}}</view>
    <view class="muted">{{t.reconAttr2}}</view>
    <view class="muted">{{t.reconAttr3}}</view>
    <view class="muted">{{t.reconAttr4}}</view>
  </view>
  <!-- ===== 段二 · 耗用核查（2026-11-24 新增，李老师提需求）=====
       与上面「率对率对账」是**同一个问题的两个视角**：上面比毛利率，这里比金额。
         率视角：实际毛利率 58% vs 标准 63%   ⇒ 差 5 个百分点
         金额视角：实际耗用 1.7万 vs 理论 1.2万 ⇒ 多花 5000 元
       🔴 算不了时只显示「缺什么 + 去哪儿补」，**绝不显示假数**
         （成本卡没建全 / 没导入销量 / 没填库存 / 免费层拿不到成本，四种都要单独说清）。 -->
  <view class="card2" wx:if="{{consume}}">
    <view class="attr-title">{{t.reconConsumeTitle}}</view>
    <view class="recon-why">{{t.reconConsumeWhatFor}}</view>

    <block wx:if="{{consume.ok}}">
      <view class="cell">
        <text class="lbl">{{t.reconConsumeTheoryLabel}}</text>
        <text class="val">{{t.cur}}{{consume.theoryText}}</text>
      </view>
      <!-- 🔴 覆盖率不满 100% 时理论耗用是**外推估算**（未建卡的菜按同比例成本估），
           必须在数字正下方标明，否则老板会把估算当实算（实测 94% 覆盖下真实无偏差也显示 +11.7%）。 -->
      <view class="muted" wx:if="{{consume.extrapolated}}">{{t.reconConsumeTheoryEst}} · 已覆盖 {{consume.coveragePct}}% 销量</view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeActualLabel}}</text>
        <text class="val">{{t.cur}}{{consume.actualText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeVarianceLabel}}</text>
        <text class="val {{consume.over ? 'warn' : ''}}">{{t.cur}}{{consume.varianceText}}（{{consume.variancePctText}}）</text>
      </view>
      <!-- 🔴 扣掉员工餐/试吃/报损后的「真正说不清的」—— 这才是老板该去查的数。
           不填上面那个数时它等于总差额，页面用 note 提示"可能偏大"。 -->
      <view class="cell" wx:if="{{consume.nonsalesText}}">
        <text class="lbl">{{t.reconConsumeNonsales}}</text>
        <text class="val">−{{t.cur}}{{consume.nonsalesText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeReal}}</text>
        <text class="val {{consume.realOver ? 'warn' : ''}}">{{t.cur}}{{consume.realVarianceText}}（{{consume.realVariancePctText}}）</text>
      </view>
      <view class="muted">{{t.reconConsumeRealNote}}</view>
      <!-- G2（2026-11-25 审计）：填的损耗超过实际用掉的料 ⇒ 提示核对，但不改老板填的数、
           也不让整段消失（消失会让人以为功能坏了，而他真正需要的是"你多打了个 0"）。 -->
      <view class="warn" wx:if="{{consume.nonsalesTooBig}}">{{t.reconConsumeNonsalesTooBig}}</view>
      <!-- 倒推采购：第二个问法，和上面「差额」是同一个数（恒等式，见 utils/consumeDerive.js 文件头证明） -->
      <view class="cell">
        <text class="lbl">{{t.reconConsumeShouldPurchase}}</text>
        <text class="val">{{t.cur}}{{consume.shouldPurchaseText}}</text>
      </view>
      <view class="cell">
        <text class="lbl">{{t.reconConsumeActualPurchaseLabel}}</text>
        <text class="val">{{t.cur}}{{consume.actualPurchaseText}}</text>
      </view>
      <view class="muted">{{t.reconConsumeCoverageNote}}</view>
      <view class="muted">{{t.reconConsumeNoJudge}}</view>
      <view class="warn" wx:if="{{consume.crossWarn}}">{{t.reconConsumeCrossWarn}}</view>
    </block>

    <block wx:else>
      <view class="warn">{{consume.missText}}</view>
      <!-- 🔴 只在「去别的页才能解决」时给直达按钮（免费层不给 —— 那是付费墙的事，不是数据问题） -->
      <button class="recon-fix" wx:if="{{consume.missUrl}}" bindtap="goConsumeFix" data-url="{{consume.missUrl}}">{{t.reconConsumeGoFix}}</button>
    </block>
  </view>

  <!-- ===== 段三 · 分原料看（2026-11-24 第二期）=====
       从「总额差多少」下到「哪个原料超了」。候选由系统按「理论采购金额」自动排前 8 ——
       老板不用挑，最值钱的已经排在前面（top3~5 通常覆盖食材成本 60%+）。
       🔴 口径：理论量已按出成率还原成**毛料**（净料克数 ÷ 出成率 ÷ 换算系数），
         所以老板要按「整块/整袋、没切的」来数。口径不一致时这个比较就不成立（三司会诊结论）。 -->
  <view class="card2" wx:if="{{material}}">
    <view class="attr-title">{{t.reconMaterialTitle}}</view>
    <view class="recon-why">{{t.reconMaterialWhy}}</view>

    <block wx:if="{{material.ok}}">
      <view class="mat-row" wx:for="{{material.rows}}" wx:key="material_id">
        <view class="mat-head">
          <text class="mat-name">{{item.name}}</text>
          <text class="muted">{{t.reconMaterialTheory}} {{item.theoryText}}{{item.unit}}</text>
        </view>
        <view class="mat-inputs">
          <input class="mat-in" type="digit" value="{{item.openVal}}" placeholder="{{t.reconMaterialOpening}}" data-mid="{{item.material_id}}" data-k="o" bindinput="onMatQty" />
          <input class="mat-in" type="digit" value="{{item.purVal}}" placeholder="{{t.reconMaterialPurchase}}" data-mid="{{item.material_id}}" data-k="p" bindinput="onMatQty" />
          <input class="mat-in" type="digit" value="{{item.closeVal}}" placeholder="{{t.reconMaterialClosing}}" data-mid="{{item.material_id}}" data-k="c" bindinput="onMatQty" />
          <!-- 第三期：采购金额（元）。有这个数才能算「本月均价」，进而与上月比价、做量价拆分。
               ⚠️ 不填就只能看数量偏差，看不出「买贵了多少」——那正是回扣最可能的藏身处。 -->
          <input class="mat-in" type="digit" value="{{item.amtVal}}" placeholder="{{t.reconMaterialAmount}}" data-mid="{{item.material_id}}" data-k="a" bindinput="onMatQty" />
        </view>
        <view class="mat-result" wx:if="{{item.actualText}}">
          <text class="muted">{{t.reconMaterialActual}} {{item.actualText}}{{item.unit}}</text>
          <text class="val {{item.diffOver ? 'warn' : ''}}" wx:if="{{item.diffText}}">{{t.reconMaterialDiff}} {{item.diffText}}</text>
        </view>
        <!-- G3（2026-11-25 审计）：理论量太小（< 0.01 采购单位）时不给差率 —— 分母太小比率会爆表
             （实测 0.001 斤对 10 斤 ⇒ 差率 1000000%，没法看）。差量照给，只把比率换成这句话。 -->
        <view class="muted" wx:if="{{item.pctSuppressed}}">{{t.reconMaterialPctSuppressed}}</view>
        <!-- ===== 第三期 · 量价拆分 =====
             把「多花了多少」拆成「买贵了多少」+「多买了多少」。
             🔴 金额持平也可能是「买贵 + 少买」互相抵消 —— 拆开才看得见（实测 +2250 / −2250 = 0）。
             只给事实，不写"回扣/贪污"：涨价也可能是行情、季节、品质变化。 -->
        <view class="mat-price" wx:if="{{item.hasPrice}}">
          <text class="muted">{{t.reconPriceCur}} {{item.priceCurText}} 元/{{item.unit}}</text>
          <text class="muted {{item.priceChgLevel === 'up' ? 'warn' : ''}}" wx:if="{{item.priceChgText}}">{{t.reconPriceChange}} {{item.priceChgText}}</text>
        </view>
        <view class="mat-price" wx:if="{{item.priceImpactText}}">
          <text class="muted {{item.priceImpactOver ? 'warn' : ''}}">{{t.reconPriceImpact}} {{item.priceImpactText}} 元</text>
          <text class="muted {{item.qtyImpactOver ? 'warn' : ''}}">{{t.reconQtyImpact}} {{item.qtyImpactText}} 元</text>
        </view>
        <view class="muted" wx:if="{{item.priceNeedAmount}}">{{t.reconPriceNeedAmount}}</view>
        <view class="muted" wx:if="{{item.priceNeedPrev}}">{{t.reconPriceNeedPrev}}</view>
      </view>
      <view class="muted">{{t.reconMaterialNote}}</view>
    </block>
    <block wx:else>
      <view class="warn">{{material.missText}}</view>
    </block>
  </view>
</view>
<view wx:else class="container"><view class="muted">{{t.loading}}</view></view>
