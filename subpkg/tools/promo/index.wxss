/* subpkg/tools/promo/index.wxss —— 做活动划算吗（R757）
   ⚠️ AD 门禁：正文 ≥28rpx、输入框/可点区域 ≥88rpx 高。 */
.pw {
  padding: 24rpx 28rpx 60rpx;
}

.pw-intro {
  font-size: 28rpx;
  color: #5b6472;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  background: #f4f7fb;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.pw-sec {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2733;
  margin: 36rpx 0 16rpx;
}

.pw-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.pw-lbl {
  flex: 0 0 auto;
  font-size: 29rpx;
  color: #2b3442;
  min-width: 240rpx;
}

.pw-in {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #1f2733;
  min-height: 96rpx;
  line-height: 96rpx;
}

.pw-unit {
  flex: 0 0 auto;
  font-size: 28rpx;
  color: #78828f;
  margin-left: 10rpx;
}

.pw-hint {
  font-size: 24rpx;
  color: #8b95a3;
  line-height: 1.55;
  padding: 8rpx 0 12rpx;
}

.pw-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.pw-pickv {
  font-size: 30rpx;
  color: #2f6bd8;
}

.pw-empty {
  font-size: 28rpx;
  color: #8b95a3;
  text-align: center;
  padding: 60rpx 0;
}

/* ===== R759 第一段主角：折扣换算大字（老板 80% 心智就是「几折」） ===== */
.pw-convert {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1e3a5f, #2f6bd8);
  border-radius: 16rpx;
  padding: 36rpx 24rpx 30rpx;
  margin: 28rpx 0 8rpx;
}

.pw-convert-k {
  font-size: 28rpx;
  color: #d7e3f5;
}

.pw-convert-v {
  font-size: 88rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  margin-top: 8rpx;
}

.pw-formula {
  font-size: 28rpx;
  color: #eaf1fb;
  margin-top: 10rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 24rpx;
}

/* R761 代金券限用张数：凑单提示（在蓝色换算块内，弱一档但不隐身） */
.pw-limit-tip {
  font-size: 26rpx;
  color: #f7e6b8;
  line-height: 1.5;
  margin-top: 12rpx;
}

.pw-convert-err {
  font-size: 28rpx;
  color: #8b95a3;
  text-align: center;
  padding: 44rpx 0 12rpx;
}

/* R761 第三段「填毛利率反算」的折扣块：比主换算块小一档，保持主次 */
.pw-convert-sm {
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.pw-convert-sm .pw-convert-v {
  font-size: 52rpx;
}

/* ===== R759 第二段：回本（次要，才要毛利率） ===== */
.pw-back-intro {
  font-size: 26rpx;
  color: #78828f;
  line-height: 1.55;
  padding: 0 0 8rpx;
}

.pw-back-empty {
  font-size: 28rpx;
  color: #8b95a3;
  text-align: center;
  padding: 40rpx 0;
  background: #fafbfd;
  border-radius: 12rpx;
}

.pw-out {
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #eef1f5;
  padding: 4rpx 24rpx;
}

.pw-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f4f6f9;
}

.pw-cell:last-child {
  border-bottom: none;
}

.pw-k {
  font-size: 28rpx;
  color: #5b6472;
}

.pw-v {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2733;
}

.pw-hot {
  color: #c0392b;
}

.pw-crit {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f4f7fb;
  border-radius: 12rpx;
}

.pw-crit-t {
  font-size: 28rpx;
  color: #5b6472;
}

.pw-crit-v {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2733;
  margin-left: 14rpx;
}

.pw-crit-h {
  display: block;
  font-size: 24rpx;
  color: #8b95a3;
  margin-top: 8rpx;
}

.pw-bad {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  background: #fdeaea;
  border-radius: 12rpx;
}

.pw-bad-t {
  font-size: 32rpx;
  font-weight: 700;
  color: #c0392b;
  line-height: 1.4;
}

.pw-bad-d {
  font-size: 27rpx;
  color: #7d3b34;
  line-height: 1.6;
  margin-top: 12rpx;
}

/* ===== R764 统一对比口径：每百元原价流水的商家成本损失（蓝色块外，弱一档） ===== */
.pw-loss {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #f4f7fb;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
}

.pw-loss-k {
  font-size: 27rpx;
  color: #5b6472;
}

.pw-loss-v {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2733;
}

/* ===== R764 第四段：预计赔/赚大字（赚=暖金不报警，亏=红报警） ===== */
.pw-eff {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 16rpx;
  margin: 22rpx 0 16rpx;
}

.pw-eff-win {
  background: #fdf3e3;
  border: 1rpx solid #f0d9b5;
}

.pw-eff-lose {
  background: #fdeaea;
  border: 1rpx solid #f3c9c9;
}

.pw-eff-k {
  font-size: 28rpx;
  color: #5b6472;
}

.pw-eff-v {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 6rpx;
}

.pw-eff-win .pw-eff-v {
  color: #b45309;
}

.pw-eff-lose .pw-eff-v {
  color: #c0392b;
}

.pw-eff-u {
  font-size: 28rpx;
  color: #78828f;
  margin-top: 2rpx;
}

.pw-foot {
  font-size: 24rpx;
  color: #98a1ad;
  line-height: 1.6;
  padding: 40rpx 0 20rpx;
  text-align: center;
}
