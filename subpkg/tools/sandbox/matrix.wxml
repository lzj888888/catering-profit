<!-- subpkg/tools/sandbox/matrix.wxml —— M2 G1 场景矩阵生成器 -->
<view class="page">
  <view class="head">
    <view class="title">{{t.title}}</view>
    <view class="subtitle">{{t.subtitle}}</view>
  </view>

  <!-- 业态 + 城市 -->
  <view class="mcard">
    <view class="mfield">
      <text class="mlabel">{{t.presetLabel}}</text>
      <picker mode="selector" range="{{presets}}" range-key="name" value="{{presetIdx}}" bindchange="onPresetChange">
        <view class="picker">{{presets[presetIdx].name}}</view>
      </picker>
    </view>
    <view class="mfield">
      <text class="mlabel">{{t.cityLabel}}</text>
      <picker mode="selector" range="{{t.cityTiers}}" range-key="name" value="{{cityIdx}}" bindchange="onCityChange">
        <view class="picker">{{t.cityTiers[cityIdx].name}}</view>
      </picker>
    </view>
  </view>

  <!-- 🔴 R551（李老师 2026-10-28）：两个动作**上移到城市层级下面** ——
       它们影响的是整页（经营类型/城市/装修/设备/档位），放在档位卡最底部既看不见、
       也让人以为只作用于档位。放在这里就位于"整页输入区"的入口处。 -->
  <view class="mcard">
    <view class="reset-row">
      <text class="reset-tx" bindtap="onReadSeed">{{t.readMyData}}</text>
      <text class="reset-tx" bindtap="onResetDims">{{t.resetDims}}</text>
    </view>
    <view class="hint">{{t.readMyDataNote}}</view>
    <view class="hint">{{t.resetDimsNote}}</view>
  </view>

  <!-- 全局投入 -->
  <view class="mcard">
    <view class="card-title">{{t.buildLabel}}</view>
    <!-- 🔴 R336：拆 4 项、各自年限。原来「一个总额 + 一个年限」把 5 年摊的设备压成 3 年
         ⇒ 月摊销虚高 11~20% ⇒ 保本线连锁虚高；老板也看不出这笔钱花在哪。 -->
    <view class="mfield">
      <text class="mlabel">{{t.buildDecorLabel}}</text>
      <input class="minp bd-inp" type="digit" value="{{global.buildDecorYuan}}" data-key="buildDecorYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.yuan}}" />
      <input class="minp yr-inp" type="digit" value="{{global.buildDecorYears}}" data-key="buildDecorYears" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.buildYearPh}}" />
      <text class="yr-lb">{{t.buildYearsUnit}}</text>
    </view>
    <view class="mfield">
      <text class="mlabel">{{t.buildEquipLabel}}</text>
      <input class="minp bd-inp" type="digit" value="{{global.buildEquipYuan}}" data-key="buildEquipYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.yuan}}" />
      <input class="minp yr-inp" type="digit" value="{{global.buildEquipYears}}" data-key="buildEquipYears" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.buildYearPh}}" />
      <text class="yr-lb">{{t.buildYearsUnit}}</text>
    </view>
    <view class="mfield">
      <text class="mlabel">{{t.buildFranchiseLabel}}</text>
      <input class="minp bd-inp" type="digit" value="{{global.buildFranchiseYuan}}" data-key="buildFranchiseYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.yuan}}" />
      <input class="minp yr-inp" type="digit" value="{{global.buildFranchiseYears}}" data-key="buildFranchiseYears" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.buildYearPh}}" />
      <text class="yr-lb">{{t.buildYearsUnit}}</text>
    </view>
    <view class="mfield">
      <text class="mlabel">{{t.buildTransferLabel}}</text>
      <input class="minp bd-inp" type="digit" value="{{global.buildTransferYuan}}" data-key="buildTransferYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.yuan}}" />
      <input class="minp yr-inp" type="digit" value="{{global.buildTransferYears}}" data-key="buildTransferYears" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.buildYearPh}}" />
      <text class="yr-lb">{{t.buildYearsUnit}}</text>
    </view>
    <!-- 🔴 R336：转让费是买位置、不是可摊资产 ⇒ 默认不摊，勾上才摊 -->
    <view class="mfield amort-row">
      <view class="amort-chk {{global.buildTransferAmort?'on':''}}" bindtap="onTransferAmortTap">
        <text class="amort-box">{{global.buildTransferAmort?'✓':''}}</text>
        <text class="amort-tx">{{t.buildTransferAmort}}</text>
      </view>
    </view>
    <view class="hint">{{t.buildTransferNote}}</view>
    <view class="build-sum" wx:if="{{buildSumText}}">{{buildSumText}}</view>
    <view class="hint">{{t.buildSumNote}}</view>
    <view class="mfield">
      <text class="mlabel">{{t.areaLabel}}</text>
      <input class="minp" type="digit" value="{{global.area}}" data-key="area" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="㎡" />
    </view>
    <!-- 🔴 R335（B 方案）：人均工资由**老板自己填**，不是系统猜；人工 = 人数 × 人均 -->
    <view class="mfield">
      <text class="mlabel">{{t.laborUnitLabel}}</text>
      <input class="minp" type="digit" value="{{global.laborUnitYuan}}" data-key="laborUnitYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
    </view>
    <view class="hint">{{t.laborUnitNote}}</view>
    <!-- 🔴 R331/R335：总额是覆盖项 —— 只想填总额时用它，优先级高于「人数 × 人均」 -->
    <view class="mfield">
      <text class="mlabel">{{t.laborTotalLabel2}}</text>
      <input class="minp" type="digit" value="{{global.laborTotalYuan}}" data-key="laborTotalYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
    </view>
    <view class="hint">{{t.laborTotalNote2}}</view>
    <!-- 🔴 D4（2026-10-27 拍板）：矩阵补「管理费」输入，与单页（已有铺面）同形状；留空=不评（默认 0，不自动派生） -->
    <view class="mfield">
      <text class="mlabel">{{t.manageOptLabel}}</text>
      <input class="minp" type="digit" value="{{global.manageYuan}}" data-key="manageYuan" bindinput="onGlobalInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
    </view>
    <view class="hint">{{t.manageOptNote}}</view>
  </view>

  <!-- 维度编辑器 -->
  <!-- 🔴 R548：取消折叠（李老师"折叠着莫名其妙"）。原折叠还会让扫描只取第 1 档 = 悄悄关掉两个维度。
       不新增维度（组合会指数膨胀）；名字改「可调参数档位」——毛利率/人数不是"高级"。 -->
  <view class="mcard">
    <view class="card-title">{{t.dimsTitle}}</view>
    <view class="dim-block">
      <view class="dim-head"><text>{{t.dimRent}}</text><view class="add" bindtap="addDim" data-dim="rent">{{t.addDim}}</view></view>
      <view class="dim-row" wx:for="{{dims.rent}}" wx:key="index" wx:for-index="idx">
        <input class="minp dim-inp" type="digit" value="{{item}}" data-dim="rent" data-idx="{{idx}}" bindinput="onDimInput" adjust-position="{{true}}" cursor-spacing="20" />
        <view class="del" wx:if="{{dims.rent.length>1}}" bindtap="delDim" data-dim="rent" data-idx="{{idx}}">{{t.delDim}}</view>
      </view>
    </view>
    <!-- 🔴 R334：人工档位整块删除 —— 人数每店都不同（麻辣烫有 8 人的也有 3 人的），人均工资也无统一值，
         用「人数 × 人均」估只会算错。人工改为在上方「人工每月总额」直接填。 -->
    <!-- 🔴 R335：人数档位回来了（按业态给默认：快餐 2/3、火锅正餐 5/6）-->
    <view class="dim-block">
      <view class="dim-head"><text>{{t.dimLabor}}</text><view class="add" bindtap="addDim" data-dim="labor">{{t.addDim}}</view></view>
      <view class="dim-row" wx:for="{{dims.labor}}" wx:key="index" wx:for-index="idx">
        <input class="minp dim-inp" type="digit" value="{{item}}" data-dim="labor" data-idx="{{idx}}" bindinput="onDimInput" adjust-position="{{true}}" cursor-spacing="20" />
        <view class="del" wx:if="{{dims.labor.length>1}}" bindtap="delDim" data-dim="labor" data-idx="{{idx}}">{{t.delDim}}</view>
      </view>
      <!-- 🔴 R552：这句原来在 js 里算了却**从未渲染** ⇒ 老板永远看不到"人数怎么算"的说明 -->
      <view class="hint" wx:if="{{laborHint}}">{{laborHint}}</view>
    </view>
    <view class="dim-block">
      <view class="dim-head"><text>{{t.dimMargin}}</text><view class="add" bindtap="addDim" data-dim="margin">{{t.addDim}}</view></view>
      <view class="dim-row" wx:for="{{dims.margin}}" wx:key="index" wx:for-index="idx">
        <input class="minp dim-inp" type="digit" value="{{item}}" data-dim="margin" data-idx="{{idx}}" bindinput="onDimInput" adjust-position="{{true}}" cursor-spacing="20" />
        <view class="del" wx:if="{{dims.margin.length>1}}" bindtap="delDim" data-dim="margin" data-idx="{{idx}}">{{t.delDim}}</view>
      </view>
    </view>
    <view class="dim-block">
      <view class="dim-head"><text>{{t.dimTarget}}</text><view class="add" bindtap="addDim" data-dim="target">{{t.addDim}}</view></view>
      <view class="dim-row" wx:for="{{dims.target}}" wx:key="index" wx:for-index="idx">
        <input class="minp dim-inp" type="digit" value="{{item}}" data-dim="target" data-idx="{{idx}}" bindinput="onDimInput" adjust-position="{{true}}" cursor-spacing="20" />
        <view class="del" wx:if="{{dims.target.length>1}}" bindtap="delDim" data-dim="target" data-idx="{{idx}}">{{t.delDim}}</view>
      </view>
    </view>
  </view>

  <view class="hint" wx:if="{{!result}}">{{t.matrixEmptyTip}}</view>
  <button class="btn-primary" bindtap="onGenerate" disabled="{{loading}}">{{loading ? t.generating : t.generate}}</button>

  <!-- 结果区 -->
  <block wx:if="{{result}}">
    <view class="mcard">
      <view class="result-bar">
        <text class="count">{{t.count}}</text>
        <view class="view-tabs">
          <view class="tab {{result.view==='detail'?'on':''}}" bindtap="onViewChange" data-view="detail">{{t.detail}}</view>
          <view class="tab {{result.view==='pivot'?'on':''}}" bindtap="onViewChange" data-view="pivot">{{t.pivot}}</view>
        </view>
      </view>

      <!-- 🔴 R553（李老师 2026-10-28 + 豆包）：你现在卖多少 ——
           矩阵只回答"要卖多少"时还不构成决策，老板要的是"我差多少"。
           放在结果区最上面：两种视图（明细/透视）都能看到。 -->
      <!-- 🔴 R554 收尾：「你现在月营收」只对**已有店铺**有意义 ——
           找铺面的人还没开店，没有"现在营收"；显示出来是废话，还会让他误填成"预计"。 -->
      <view class="real-row">
        <text class="real-lb">{{mode === 'forward' ? t.realMonthLabel : t.realMonthLabelRev}}</text>
        <view class="real-in-wrap">
          <input class="real-in" type="digit" value="{{realMonthYuan}}" placeholder="{{t.realMonthPh}}" bindinput="onRealInput" adjust-position="{{true}}" cursor-spacing="20" />
          <text class="real-unit">元</text>
        </view>
      </view>
      <!-- 差额结论只对已有店铺（找铺面的结论在下面的「结论速读」里，那里才算得了租金上限） -->
      <block wx:if="{{mode === 'forward'}}">
      <view class="real-gap {{realGap.cls}}" wx:if="{{realGap}}">{{realGap.text}}</view>
      <view class="hint" wx:else>{{t.realMonthNote}}</view>
      </block>

      <!-- 🔴 round279 · #9 结论速读：结论高亮 + 房租杠杆提示 + 淡季安全垫 -->
      <view class="insight" wx:if="{{result.insight && result.insight.has}}">
        <view class="insight-title">{{t.insightTitle}}</view>
        <view class="insight-line" wx:if="{{result.insight.bestText}}">{{result.insight.bestText}}</view>
        <view class="insight-line lever">{{result.insight.leverText}}</view>
        <view class="insight-line" wx:if="{{result.insight.cushionText}}">{{result.insight.cushionText}}</view>
        <view class="insight-rule">{{t.leverRule}}</view>
      </view>
      <view class="insight none" wx:elif="{{result.insight}}">{{t.insightNone}}</view>

      <!-- 🔴 R331：固定费用构成 —— 让老板能核对「这个保本点是怎么来的」。
           前端用同一个 assembleItems 重算，并与引擎对账；对不上就整块不显示（fail-closed）。
           ⚠️ 只对应上表第一档房租（其余档位的房租/水电气会不同），文案已写明。 -->
      <view class="fixed-break" wx:if="{{fixedBreak}}">
        <view class="fb-title">{{t.fixedBreakTitle}}</view>
        <view class="fb-row" wx:for="{{fixedBreak}}" wx:key="key">
          <text class="fb-lb">{{item.name}}</text><text class="fb-val">{{item.text}}</text>
        </view>
        <view class="hint">{{t.fixedBreakNote}}</view>
      </view>

      <!-- 🔴 R325：钱够不够开 / 能撑几个月 —— 上面答"稳态赚不赚钱"，这里答"有没有命等到稳态"。
           🔴 R548：**已有店铺整块隐藏**（李老师拍板）——店都开了再问"够不够开"没意义；
           他要算现金流该去月度核算（真实账）。抗风险由表里的「淡季安全垫」列承担。 -->
      <view class="cash-card" wx:if="{{mode === 'reverse'}}">
        <view class="cash-title">{{t.cashTitle}}</view>
        <view class="cash-lead">{{t.cashLead}}</view>
        <view class="cash-row">
          <text class="cash-lb">{{t.cashRentLabel}}</text>
          <input class="cash-inp" type="digit" value="{{cash.rentYuan}}" data-key="rentYuan" bindinput="onCashInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
        </view>
        <view class="cash-row">
          <text class="cash-lb">{{t.cashBudgetLabel}}</text>
          <input class="cash-inp" type="digit" value="{{cash.budgetYuan}}" data-key="budgetYuan" bindinput="onCashInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
        </view>
        <view class="cash-row">
          <text class="cash-lb">{{t.cashEquipLabel}}</text>
          <input class="cash-inp" type="digit" value="{{cash.equipYuan}}" data-key="equipYuan" bindinput="onCashInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
        </view>
        <view class="cash-row">
          <text class="cash-lb">{{t.cashStockLabel}}</text>
          <input class="cash-inp" type="digit" value="{{cash.stockYuan}}" data-key="stockYuan" bindinput="onCashInput" adjust-position="{{true}}" cursor-spacing="20" placeholder="{{t.cashYuanPh}}" />
        </view>
        <block wx:if="{{cashRes}}">
          <view class="cash-need">{{cashRes.needText}}</view>
          <view class="cash-parts">{{cashRes.partsText}}</view>
          <view class="cash-verdict {{cashRes.levelCls}}">{{cashRes.verdictText}}</view>
        </block>
        <view class="cash-note">{{t.cashDepositNote}}</view>
      </view>

      <!-- 明细表 -->
      <block wx:if="{{result.view==='detail'}}">
      <!-- 🔴 R357：分批中途失败 ⇒ 已算出的先给，并说清哪一段没算（不整表空白） -->
      <view class="partial-note" wx:if="{{result.partialText}}">{{result.partialText}}</view>
      <!-- 🔴 R378：14 列 × 200rpx ≈ 1400px，手机只能看到 2 列半 ⇒ 窄屏明说"可以横滑"。
           首列（指标名）已冻结（见 matrix.wxss `.td:first-child`），横滑时行名不会跟着滚走。 -->
      <view class="hint">{{t.matrixReadGrid}}</view>
      <view class="swipe-hint" wx:if="{{narrow && result}}">{{t.matrixSwipeHint}}</view>
      <!-- 🔴 R548 默认列（各 6 列）：已有店铺 = 毛利率/人工人数/月人工费/保本月营收/目标月营收/
           淡季安全垫；寻找铺面首列换月租金。毛利率必进默认列（否则分不清差异来自成本端还是毛利端）。
           房租只 1 档时不占列。⚠️ 只管显示；导出仍全 14 列（R349 按源码计列） -->
      <view class="col-toggle" bindtap="onToggleCols">
        <text>{{colsOpen ? t.lessCols : t.moreCols}}</text>
        <text class="col-arrow">{{colsOpen ? '▾' : '▸'}}</text>
      </view>
      <scroll-view scroll-x="true" class="tbl-scroll">
        <view class="tbl">
          <view class="tr th">
            <text class="td" wx:if="{{dims.rent.length>1}}">{{t.colRent}}</text>
            <text class="td">{{t.colMargin}}</text>
            <text class="td">{{t.colLabor}}</text><text class="td">{{t.colLaborFee}}</text>
            <text class="td">{{t.colBreakMonthly}}</text>
            <text class="td">{{t.colTargetMonthly}}</text>
            <!-- 🔴 淡季安全垫：已有店铺默认给（那里没有现金卡），找铺面收进更多列。
                 ⚠️ 只能一个条目 —— 拆两个 wx:if 会让页面列数变 15，撞 R349 对齐全。 -->
            <text class="td" wx:if="{{colsOpen || mode === 'forward'}}">{{t.colCushion}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{t.colTarget}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{t.payback}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{t.colBreakCash}}</text><text class="td" wx:if="{{colsOpen}}">{{t.colBreakDaily}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{t.colTargetDaily}}</text><text class="td" wx:if="{{colsOpen}}">{{t.rentPct}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{t.colLever}}</text>
          </view>
          <!-- 🔴 R297 第四轮（审计 B7）：被云端拒掉的档位（toRow 给 invalid:true）此前**无任何视觉区分**
               —— 与"正常但无数"的行长得一样，老板在表里定位不到是哪几档算不出来（只有一句 toast）。
               现加 .invalid 灰显 + 首列 ⚠ 标记。 -->
          <view class="tr {{item.red?'red':''}}{{item.invalid?' invalid':''}}" wx:for="{{result.rows}}" wx:key="index">
            <text class="td" wx:if="{{dims.rent.length>1}}">{{item.rent}}{{t.yuan}}{{item.invalid?' ⚠':''}}</text>
            <text class="td">{{item.netMarginPct!=null?item.netMarginPct:'—'}}{{t.pct}}</text>
            <text class="td">{{item.labor}}{{t.person}}</text>
            <text class="td">{{item.laborYuan!=null?item.laborYuan:'—'}}</text>
            <text class="td">{{item.breakMonthly!=null?item.breakMonthly:'—'}}</text>
            <text class="td">{{item.targetMonthly!=null?item.targetMonthly:'—'}}</text>
            <text class="td" wx:if="{{colsOpen || mode === 'forward'}}">{{item.cushionPct!=null?item.cushionPct+t.pct:t.cushionBreakEven}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{item.targetYuan}}{{t.yuan}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{item.payback!=null?item.payback:'—'}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{item.beCashMonthly!=null?item.beCashMonthly:'—'}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{item.breakDaily!=null?item.breakDaily:'—'}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{item.targetDaily!=null?item.targetDaily:'—'}}</text>
            <text class="td rent-{{item.rentCls}}" wx:if="{{colsOpen}}">{{item.rentPct!=null?item.rentPct:'—'}}</text>
            <text class="td" wx:if="{{colsOpen}}">{{item.leverYuan!=null?item.leverYuan:'—'}}</text>
          </view>
        </view>
      </scroll-view>
      <!-- 🔴 R336：两个保本并排，必须说清差别（不然老板以为哪个算错了） -->
      <view class="hint">{{t.beCashNote}}</view>
      <view class="hint">{{t.rentPctNote}}</view>
      </block>

      <!-- 透视表 -->
      <block wx:else>
        <!-- 🔴 round273：被"固定住"的维度随场景走 ——
             A（已有铺面）主轴扫毛利率 ⇒ 固定**月租金**；B（寻找铺面）主轴扫租金档位 ⇒ 固定**毛利率**。
             人工两边都固定。维度本身一个没删，只是换主轴。 -->
        <view class="pivot-fix">
          <view class="mfield" wx:if="{{mode === 'forward'}}">
            <text class="mlabel">{{t.pivotFixRent}}</text>
            <input class="minp" type="digit" value="{{pivotFix.rent}}" data-key="rent" bindinput="onPivotFixInput" adjust-position="{{true}}" cursor-spacing="20" />
          </view>
          <view class="mfield" wx:else>
            <text class="mlabel">{{t.pivotFixMargin}}</text>
            <input class="minp" type="digit" value="{{pivotFix.margin}}" data-key="margin" bindinput="onPivotFixInput" adjust-position="{{true}}" cursor-spacing="20" />
          </view>
          <view class="mfield">
            <text class="mlabel">{{t.pivotFixLabor}}</text>
            <input class="minp" type="digit" value="{{pivotFix.labor}}" data-key="labor" bindinput="onPivotFixInput" adjust-position="{{true}}" cursor-spacing="20" />
          </view>
        </view>
        <scroll-view scroll-x="true" class="tbl-scroll">
          <!-- 🔴 R528：透视表列窄（130rpx）+ 字号大（30rpx）—— 一屏能看到 4 档以上，
               横滑次数从"每屏 1.7 档"降到"每屏 ~4 档"。列宽缩了仍保首列 150rpx（要放「月租金」+ 单位）。 -->
          <view class="tbl pivot-tbl">
            <view class="tr th">
              <!-- 🔴 round273：首列表头随场景（毛利率 / 月租金） -->
              <text class="td">{{t.pivotRowLabel}}</text>
              <text class="td" wx:for="{{result.pivot.cols}}" wx:key="index">{{item==0?t.colBreakDaily:item+t.yuan}}</text>
            </view>
            <view class="tr" wx:for="{{result.pivot.rows}}" wx:key="index" wx:for-item="rrow">
              <!-- 行值单位随维度：毛利率 ⇒ %，月租金 ⇒ 元 -->
              <text class="td">{{rrow}}{{pivotRowDim==='margin' ? t.pct : t.yuan}}</text>
              <text class="td" wx:for="{{result.pivot.cols}}" wx:key="index" wx:for-item="cc">{{result.pivot.cells[rrow+'|'+cc]!=null?result.pivot.cells[rrow+'|'+cc]:'—'}}</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <button class="btn-export" bindtap="onExport" disabled="{{exporting}}">{{exporting ? t.exporting : t.exportXlsx}}</button>
    </view>
  </block>

  <view class="nav-row">
    <button class="btn-ghost" bindtap="goSandbox">{{t.backToSandbox}}</button>
    <button class="btn-ghost" bindtap="goCompare">{{t.toCompare}}</button>
  </view>
</view>
