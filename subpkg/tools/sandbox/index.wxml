    <view class="card2 eff-need" wx:elif="{{mode === 'forward'}}" bindtap="onGoEffInput">
      <view class="sec">{{t.fwdEffTitle}}</view>
      <view class="cell"><text class="lbl">{{t.fwdPixelEffLbl}}</text><text class="val muted">{{effNeedRev ? t.fwdEffNeedRev : t.fwdEffNeedArea}}</text></view>
      <view class="cell"><text class="lbl">{{t.fwdPerHeadLbl}}</text><text class="val muted">{{effNeedRev ? t.fwdEffNeedRev : t.fwdEffNeedHead}}</text></view>
    </view>

    <view class="card2 calc-basis" wx:if="{{result.valid_days}}">
      <view class="sec">{{t.calcBasisTitle}}</view>
      <view class="cell"><text class="lbl">{{t.fixedTotalWithAmort}}</text><text class="val">{{t.cur}}{{result.fixed_total}}</text></view>
      <view class="cell"><text class="lbl">{{t.marginName}}</text><text class="val">{{result.margin_rate}}%</text></view>
      <view class="cell"><text class="lbl">{{t.calcBasisDays}}</text><text class="val">{{result.valid_days}} 天</text></view>
      <view class="hint calc-basis-formula">{{t.calcBasisFormula}}</view>
    </view>
  </block>

  <!-- 餐饮指标对照（待下面 payback 卡前） -->
  <view class="card2" wx:if="{{mode === 'forward' && showMore && payback}}">
    <view class="sec">{{t.paybackTitle}}</view>
    <view class="cell">
