/* pages/sandbox/index.wxss —— M2 开店盈亏平衡点测算（v2）
   色值单源见 app.wxss 头部声明；本文件不引入新的品牌色。
   ⚠️ 无障碍硬约束（selftest_ad_gates.js 真判据，非建议）：
     G1 字号一律 ≥28rpx · G2 min-height ≥88rpx 或恰为 20/40rpx 占位（本文件 88rpx + 40rpx） */

/* v1 遗留（结论行样式；v2 结果区改为表格化展示，保留以防其他引用） */
.val-input { text-align: right; font-size: 32rpx; width: 280rpx; }
.concl { font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; line-height: 1.6; }
.concl .hl { color: #1e3a5f; font-size: 36rpx; }

/* ===== M2v1.1 双 Tab（R234 改名：已有铺面 / 寻找铺面，并各带一句副标题）=====
   ⚠️ G1 字号硬约束 ≥28rpx ⇒ **副标题也必须是 28rpx**（不能做成常见的 24rpx 灰字），
      两级区分改用「字重 + 颜色」而不是字号。 */
.tab-bar { display: flex; background: #eef2f7; border-radius: 12rpx; padding: 6rpx; margin-bottom: 16rpx; }
.tab-item {
  flex: 1 1 0; text-align: center; min-height: 88rpx; border-radius: 10rpx;
  padding: 10rpx 8rpx; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.tab-item.on { background: #1e3a5f; color: #fff; font-weight: 600; }
.tab-main { font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.tab-sub { font-size: 30rpx; font-weight: 400; line-height: 1.35; margin-top: 2rpx; color: #8b97a7; }
.tab-item.on .tab-sub { color: #c9dcf0; }

/* ===== 0 · 前提选择器（城市层级 / 经营类型）===== */
.sel-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; border-bottom: 1rpx solid #eef1f5; }
.sel-lbl { font-size: 30rpx; color: #333; }
.sel-pk { flex: 0 0 auto; }
.sel-val { font-size: 30rpx; color: #1e3a5f; font-weight: 600; padding: 8rpx 16rpx; background: #f2f5f9; border-radius: 8rpx; }
/* R234：业态大类改为**只读回显**（由上面「打算开什么店」自动带出）⇒ 视觉上要"点不动"：
   降饱和 + 去加粗，避免用户把它当成还能选的第二道题。 */
.sel-val.readonly { color: #6b7a90; background: #f7f9fc; font-weight: 400; }

/* ===== 板块一级标题 ===== */
.sec { position: relative; font-size: 40rpx; font-weight: 800; color: #1e3a5f; padding-left: 20rpx; margin: 8rpx 0 18rpx; line-height: 1.3; }
.sec::before {
  content: '';
  position: absolute;
  left: 0; top: 6rpx; bottom: 6rpx; width: 8rpx; border-radius: 4rpx;
  background: linear-gradient(180deg, #2a4e7c 0%, #162c49 100%);
}

/* ===== 明细行 ===== */
.row { display: flex; align-items: center; min-height: 88rpx; }
.row-name { flex: 0 0 220rpx; font-size: 30rpx; color: #333; }
/* 🔴 R341：输入项的语义补答（≤18 字），对齐输入框左边界；字号 28rpx 满足 AD-G1 */
.row-hint { font-size: 30rpx; color: #646a73; padding: 0 0 10rpx 220rpx; line-height: 1.4; }
.row-in-wrap {
  flex: 1 1 auto; display: flex; align-items: center;
  border: 1rpx solid #dfe5ec; border-radius: 10rpx; padding: 6rpx 14rpx; background: #fff;
  margin-right: 12rpx; min-height: 88rpx;
}
/* 🔴 R543（李老师 2026-10-27）：「输个 5 万只出来 5000」——
   年限框原固定 168rpx（只放「5 年」两个字），把金额框挤到 200rpx 出头；金额又是右对齐 ⇒
   多位数只露得出尾巴几位。⇒ 年限框收到 110rpx，金额框吃满剩余宽度并保底 260rpx。 */
.row-in-wrap.yr { flex: 0 0 110rpx; }
.row-in { flex: 1 1 auto; font-size: 30rpx; color: #1e3a5f; text-align: right; min-height: 40rpx; }
.row-unit { font-size: 30rpx; color: #888; margin-left: 6rpx; }
.row-del { flex: 0 0 auto; font-size: 30rpx; color: #9aa4b2; padding: 16rpx 0 16rpx 8rpx; }
.add-row { font-size: 30rpx; color: #1e3a5f; min-height: 88rpx; line-height: 88rpx; }
.row-val { flex: 1 1 auto; font-size: 30rpx; color: #1e3a5f; text-align: right; font-weight: 600; }
.row-strong .row-name, .row-strong .row-val { font-weight: 700; color: #1e3a5f; }
.switch-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.switch-label { flex: 1 1 auto; font-size: 30rpx; color: #555; line-height: 1.4; padding-right: 16rpx; }

/* ===== ③ 毛利率滑杆 ===== */
.mg-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6rpx; }
.mg-val { font-size: 46rpx; font-weight: 800; color: #1e3a5f; }
.mg-sub { font-size: 30rpx; color: #888; }
/* 🔴 R545：毛利率「从哪来」引导条 —— 轻底色（不用卡片，避免一张卡里再套一张卡），
   字号 28rpx 起（AD 门禁下界），按钮沿用 .btn-small 的 88rpx 触控红线。 */
/* 🔴 R549 口径二选一（互斥）；28rpx 满足 AD-G1；选中态墨蓝实底 */
.mscope { margin-top: 16rpx; padding: 16rpx 18rpx; background: #f6f8fb; border-radius: 10rpx; }
.mscope-q { font-size: 28rpx; color: #4a5b70; margin-bottom: 12rpx; }
.mscope-row { display: flex; }
.mscope-item { flex: 1; text-align: center; font-size: 28rpx; color: #4a5b70;
  padding: 16rpx 8rpx; border: 1rpx solid #dfe5ec; background: #fff; }
.mscope-item:first-child { border-radius: 10rpx 0 0 10rpx; }
.mscope-item:last-child { border-radius: 0 10rpx 10rpx 0; border-left: none; }
.mscope-item.on { background: #1e3a5f; color: #fff; border-color: #1e3a5f; }
.mscope-note { font-size: 28rpx; color: #6b7a90; margin-top: 10rpx; }
/* 🔴 R549：9 字放不进 220rpx ⇒ 该行放宽，金额框随之变窄 */
.row-name.wide { flex: 0 0 300rpx; }
.margin-src { margin-top: 14rpx; padding: 16rpx 18rpx; background: #f6f8fb; border-radius: 10rpx; }
/* 🔴 R547b：pre-line —— 否则 \n 被压成空格、两行挤成一段。.margin-src-btn 随按钮撤掉。 */
.margin-src-note { display: block; font-size: 28rpx; color: #4a5b70; line-height: 1.55; white-space: pre-line; }

/* ===== 结果区 ===== */
.cell.big .lbl { font-weight: 600; color: #333; }
/* 🔴 R543：保本线 hero（结果区第一张卡）—— 独立底色 + 大字，让测算完第一眼看到的就是它。
   配色只用页面既有的墨蓝体系，不另造色板。 */
.be-hero {
  background: linear-gradient(135deg, #1e3a5f 0%, #162c49 100%);
  border: none; padding: 30rpx 28rpx;
}
.be-cap { font-size: 30rpx; color: rgba(255, 255, 255, 0.82); }
.be-num { font-size: 64rpx; font-weight: 800; color: #fff; line-height: 1.25; margin-top: 6rpx; }
.be-hint { font-size: 28rpx; color: rgba(255, 255, 255, 0.72); margin-top: 2rpx; }
.be-sub { font-size: 30rpx; color: rgba(255, 255, 255, 0.92); margin-top: 14rpx; }
/* 🔴 #100（R576）：M1 真实数据预填的来源说明 + 缺口卡。
   字号一律 ≥28rpx（本仓 AD 红线）；颜色只表"差/超"，不做好坏评级（无市场数据可判）。 */
.m1-prefill-note { font-size: 28rpx; color: #6b7280; padding: 2rpx 0 10rpx; }
.m1-gap { padding: 24rpx 28rpx; }
.m1-gap-text { font-size: 30rpx; line-height: 1.5; }
.m1-gap-text.is-behind { color: #c0392b; }
.m1-gap-text.is-above { color: #2e7d32; }
/* 指标对照表的颜色图例（颜色由 .lv-* 单源给，这里只管排版） */
.ind-legend { display: flex; flex-wrap: wrap; padding: 4rpx 0 12rpx; }
.ind-lg { font-size: 28rpx; margin-right: 22rpx; }
.keynum { font-size: 40rpx; font-weight: 800; color: #1e3a5f; }
.calc-btn { margin: 8rpx 0 24rpx; }
.err-hint { font-size: 30rpx; color: #c0392b; min-height: 88rpx; line-height: 88rpx; }
.empty-tip { text-align: center; padding: 30rpx; }

/* ===== 餐饮指标对照 ===== */
.tab-row { display: flex; margin-bottom: 14rpx; }
.tab { flex: 1 1 0; text-align: center; font-size: 30rpx; color: #666; min-height: 88rpx; line-height: 88rpx; border-bottom: 3rpx solid transparent; }
.tab.on { color: #1e3a5f; font-weight: 700; border-bottom-color: #1e3a5f; }
.ind-row { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #f0f3f7; }
.ind-row.ind-head { border-bottom: 1rpx solid #dfe5ec; }
.ind-c1 { flex: 0 0 200rpx; font-size: 30rpx; color: #333; }
.ind-c2 { flex: 1 1 0; text-align: center; font-size: 30rpx; font-weight: 700; color: #1e3a5f; }
.ind-c3 { flex: 1 1 0; text-align: center; font-size: 30rpx; color: #666; }
.ind-c4 { flex: 0 0 120rpx; text-align: right; font-size: 30rpx; }
.ind-head .ind-c1, .ind-head .ind-c2, .ind-head .ind-c3, .ind-head .ind-c4 {
  font-size: 30rpx; font-weight: 400; color: #888;
}
/* 评级配色已上提到全局 app.wxss（单源）——本页不再重复定义，跨模块同色同义（round115） */

/* ===== round113 · 填表引导（逐项口径备注 + 行业参考区间）=====
   目的：降低"不知道这项该填多少"的门槛（客户多为餐饮小白）。
   ⚠️ 无障碍硬约束（selftest_ad_gates G1/G2）：字号一律 ≥28rpx；min-height 只在 88rpx 用。 */
.rw { display: block; }
/* 🔴 R543：开店投入行是「名称 + 金额 + 年限 + 删」四段，名称列比通用行窄一档，
   把宽度让给金额（5~6 位数不能截断）。 */
.rw .row-name { flex: 0 0 190rpx; }
.rw .row-in-wrap:not(.yr) { flex: 1 1 auto; min-width: 260rpx; }
.rw .row-in { min-width: 200rpx; }
.row-note { font-size: 30rpx; color: #646a73; line-height: 1.4; padding: 0 0 12rpx; }
/* R443：输入区「每月固定支出合计」——只加粗，不另造配色（避免与页面既有色板打架） */
.total-line { font-weight: 600; }
/* ===== R234 · 「寻找铺面」Tab：行规自动带出条（房租率来自云端 BANDS，**不是用户填的**）=====
   设计意图：这行不是输入框，是"告知"。把百分比放大到标题级字号，让它像一句结论而非一个参数。 */
.auto-band { display: flex; align-items: baseline; flex-wrap: wrap; padding: 14rpx 0 4rpx; }
.auto-band-txt { font-size: 30rpx; color: #4a5b70; line-height: 1.5; }
.auto-band-num { font-size: 44rpx; font-weight: 800; color: #1e3a5f; margin: 0 6rpx; }

/* ===== R234 · 主结论卡「这个铺子租金贵不贵」=====
   放在结果区第一位 ⇒ 用左侧墨蓝竖条与上方输入区断开（与全局 .sec 同手法），
   让用户意识到"从这儿开始是结论，不是要你填的东西"。
   ⚠️ 配色不自造：`.lv-*` 评级色已在 app.wxss 单源，本文件不重复定义。 */
.verdict-card { border-left: 8rpx solid #1e3a5f; padding-left: 20rpx; }
.verdict-head { display: flex; align-items: center; justify-content: space-between; padding: 6rpx 0 12rpx; }
.verdict-title { font-size: 32rpx; font-weight: 700; color: #1e3a5f; }
.verdict-lv { font-size: 32rpx; font-weight: 700; padding: 6rpx 22rpx; border-radius: 8rpx; }
.verdict-row { display: flex; align-items: center; justify-content: space-between; padding: 6rpx 0; }
.verdict-lbl { font-size: 30rpx; color: #666; }
.verdict-val { font-size: 34rpx; font-weight: 700; color: #1e3a5f; }
/* 行规区间是"对照基准"，不是"你的数" ⇒ 降字重降饱和，避免与上面那行主数字抢注意力 */
.verdict-val.sub { font-size: 30rpx; font-weight: 400; color: #888; }
.verdict-note {
  font-size: 30rpx; color: #4a5b70; line-height: 1.6; padding: 14rpx 20rpx;
  background: #f3f7fb; border-radius: 12rpx; margin-top: 10rpx;
}
/* 🔴 #7（P0-2，round272）：主结论卡加「6 项指标体检」条 —— 一眼看出哪项拖后腿。
   ⚠️ 配色不自造：`.lv-*` 评级色已在 app.wxss 单源，本文件不重复定义。 */
.verdict-health { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #e3e9f0; }
.vh-cap { font-size: 30rpx; color: #888; display: block; margin-bottom: 8rpx; }
.vh-item { display: flex; align-items: center; justify-content: space-between; padding: 5rpx 0; }
.vh-name { font-size: 30rpx; color: #444; }
.vh-pct { font-size: 30rpx; color: #1e3a5f; font-weight: 600; flex: 1; text-align: center; }
.vh-lv { font-size: 30rpx; font-weight: 700; padding: 2rpx 16rpx; border-radius: 6rpx; }
/* L1 引导句：紧贴标题下，说明"哪些该你答、哪些我们替你算" —— 降低第一次进页面的放弃率 */
.l1-guide { padding: 10rpx 20rpx; }

/* ===== R234 · 已废弃的「行业参考区间」占比网格 =====
   R234 把这张 6 项网格从页面移除（原因见 index.wxml 同处注释：与结果区指标对照表重复）。
   🔴 样式**先留着不删**：`bands` 数据仍要算（`rentRateDefault()` 依赖它），
      后续若要在「我的方案」对比页恢复同类视图，可直接复用本节，不必重写。 */
.bp-grid { display: flex; flex-wrap: wrap; }
.bp-item {
  flex: 0 0 50%; box-sizing: border-box; padding-right: 20rpx;
  display: flex; align-items: center; justify-content: space-between; min-height: 88rpx;
}
.bp-name { font-size: 30rpx; color: #333; }
.bp-band { font-size: 30rpx; font-weight: 700; color: #1e3a5f; }
/* round114：参考金额（起点）—— 与区间上下排列，灰字弱化，避免与"区间"抢注意力 */
.bp-right { display: flex; flex-direction: column; align-items: flex-end; }
.bp-amt { font-size: 30rpx; color: #9aa4b2; }

/* R193：草稿提示行（"已载入上次填的数"+ 清空重填） */
.draft-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
/* 🔴 字号 ≥28rpx 是硬红线（AD G1 机器判据） */
.draft-note { flex: 1; font-size: 30rpx; color: #9aa4b2; }
/* 本页不写内联 style（仓内惯例：修 6 起内联样式一律回 wxss） */
.draft-btn { margin: 0; flex: 0 0 auto; }

/* ===== M2v1.2 · 我的方案入口 ===== */
.entry-bar { display: flex; justify-content: flex-end; margin-bottom: 4rpx; }
.entry-link { font-size: 32rpx; color: #1e3a5f; font-weight: 600; padding: 8rpx 8rpx 8rpx 24rpx; }

/* ===== M2v1.2 · 保存沙盘按钮 ===== */
.save-sandbox-btn { margin: 0 0 24rpx; }

/* ===== M2v1.2 · 保存沙盘弹窗 ===== */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 50; }
.sheet { width: 640rpx; background: #fff; border-radius: 16rpx; padding: 32rpx 32rpx 24rpx; }
.sheet-title { font-size: 36rpx; font-weight: 700; color: #1e3a5f; margin-bottom: 20rpx; }
.sheet-row { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #eef1f5; }
.sheet-lbl { flex: 0 0 150rpx; font-size: 30rpx; color: #333; }
.sheet-in { flex: 1 1 auto; font-size: 32rpx; color: #1e3a5f; min-height: 40rpx; }
.type-chips { flex: 1 1 auto; display: flex; }
.chip { font-size: 30rpx; color: #6b7a90; border: 1rpx solid #c4ccd6; border-radius: 10rpx; padding: 10rpx 24rpx; margin-right: 16rpx; }
.chip.on { color: #fff; background: #1e3a5f; border-color: #1e3a5f; }
.sheet-btns { display: flex; justify-content: flex-end; margin-top: 28rpx; }
.sheet-btns .btn { margin: 0 0 0 20rpx; width: 220rpx; }

/* ===== M2v1.3 · 业态参数包 / 三层披露 / 回本卡 ===== */
.fold-toggle { font-size: 32rpx; color: #1e3a5f; font-weight: 600; padding: 20rpx 0; border-top: 1rpx solid #f0f3f7; margin-top: 8rpx; }
.asm { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #f0f3f7; }
.asm-lbl { flex: 0 0 220rpx; font-size: 30rpx; color: #333; }
.asm-input { flex: 1 1 auto; font-size: 30rpx; color: #1e3a5f; font-weight: 600; }
.asm-src { flex: 0 0 auto; font-size: 30rpx; color: #9aa4b2; margin-left: 12rpx; }
.payback-disclaimer { color: #b45309; }
/* 🔴 #8（P1，round272）：全局测算边界免责声明（与 payback-disclaimer 互补，灰调以示边界） */
.m2-disclaimer { color: #8a93a0; margin-top: 4rpx; }
.calc-basis-formula { color: #4a5b70; font-size: 30rpx; line-height: 1.6; margin-top: 10rpx; padding: 10rpx 14rpx; background: #f3f7fb; border-radius: 10rpx; }
.payback-m3-btn { margin: 16rpx 0 0; }

/* 🔴 R546：※ 图例 —— 比正文小一号、灰一档，像脚注而不像警告（它不是错，是说明）。 */
.ref-legend { font-size: 28rpx; color: #8a94a6; line-height: 1.5; }

/* 🔴 R234/J4 句级折叠 .hint-fold（与区段级 .fold-toggle 必须视觉可分）：
   .fold-toggle 收「整块参数区」（30rpx 加粗 + 上边框）；.hint-fold 收「一句说明」（28rpx 常规、无边框）。
   body 底色 #f3f7fb 与全局 .hint 同色 ⇒ 折叠前后视觉连贯；本块无外层背景，不套白卡。 */
.hint-fold { padding: 0 0 6rpx; }
.hint-fold-head { display: flex; align-items: center; justify-content: space-between;
  min-height: 88rpx; padding: 14rpx 8rpx; }
.hint-fold-guide { font-size: 30rpx; color: #1e3a5f; }
.hint-fold-arrow { font-size: 30rpx; color: #1e3a5f; }
/* 🔴 R547b：pre-line —— 折叠正文里的 \n 要真换行（多平台说明是 4 段，挤成一段读不动） */
.hint-fold-body { font-size: 30rpx; color: #4a5b70; line-height: 1.6; padding: 16rpx 20rpx;
  background: #f3f7fb; border-radius: 12rpx; margin: 0 0 12rpx; white-space: pre-line; }

/* 🔴 D8（2026-10-27 拍板）：派生项标注样式——浅琥珀底 + 左边框，提示"此项为行业估算值" */
.derived-note { font-size: 26rpx; color: #8a6d3b; background: #fff7e6; border-left: 6rpx solid #f0ad4e;
  border-radius: 8rpx; padding: 12rpx 16rpx; margin-bottom: 12rpx; line-height: 1.6; }

/* ===== P0#5（2026-10-11）：翻台「?」触发说明 + 结果吸底条 ===== */
/* 翻台率单元格里的「?」徽标：小圆点、可点、不抢视觉 */
.lbl-q { display: flex; align-items: center; }
.q-mark { display: inline-flex; align-items: center; justify-content: center;
  width: 34rpx; height: 34rpx; margin-left: 10rpx; border-radius: 50%;
  background: #e3eaf2; color: #1e3a5f; font-size: 30rpx; font-weight: 600; line-height: 1; }
/* 「?」点开后的白话说明面板 */
.turn-help { background: #f3f7fb; border-radius: 12rpx; padding: 16rpx 20rpx; margin: 4rpx 0 8rpx; }
.th-title { font-size: 30rpx; font-weight: 600; color: #1e3a5f; margin-bottom: 6rpx; }
.th-body { font-size: 30rpx; color: #4a5b70; line-height: 1.6; margin-bottom: 10rpx; }
.th-levels { display: flex; flex-direction: column; gap: 6rpx; }
.th-lv { font-size: 30rpx; color: #9aa4b2; line-height: 1.5; }
.th-lv.on { color: #1e3a5f; font-weight: 600; }
.th-dot { margin-right: 8rpx; }
/* 结果吸底条：测算出数后常驻屏幕底部，老板滚长表单也看得见核心数 */
.container.has-stick { padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx); }
.stick-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: #1e3a5f; box-shadow: 0 -4rpx 16rpx rgba(30, 58, 95, 0.18); }
.stick-row { display: flex; align-items: baseline; justify-content: space-between; }
.stick-row2 { display: flex; align-items: center; justify-content: space-between; margin-top: 6rpx; }
.stick-l { display: flex; align-items: baseline; min-width: 0; }
/* 🔴 R364 + G1：标签 28rpx 是无障碍底线（selftest_ad_gates 禁 <28），
   原来想用 22/24rpx 塞下三段，改成**两行**：第一行两个数、第二行评级 + 入口。 */
.stick-lbl { font-size: 30rpx; color: #cfe0f2; margin-right: 8rpx; flex: 0 0 auto; }
.stick-val { font-size: 34rpx; font-weight: 700; color: #fff; }
.stick-m { display: flex; align-items: baseline; min-width: 0; flex: 0 0 auto; }
.stick-val2 { font-size: 34rpx; font-weight: 700; color: #fff; }
.stick-lv { font-size: 30rpx; color: #1e3a5f; background: #cfe0f2; border-radius: 999rpx;
  padding: 2rpx 14rpx; flex: 0 0 auto; }
.stick-go { font-size: 30rpx; color: #9ec3e8; flex: 0 0 auto; }

/* ===== 🔴 round279c · #10 敏感度：毛利率 ±5% 看保本额变化 =====
   ⚠️ 字号 ≥28rpx 是硬红线（AD G1）；用颜色区上下、不压字号。 */
.sens-delta { font-size: 30rpx; font-weight: 600; margin-left: 16rpx; }
.sens-delta.up { color: #c0392b; }
.sens-delta.down { color: #1e8e3e; }
/* 🔴 瞬态「测算中」用独立类（非 .hint），避免被 hint-fold 守卫计入平铺提示数 */
.sens-loading { font-size: 30rpx; color: #8a93a0; padding: 8rpx 0; }

/* 🔴 R327：正推表（做到某营业额能赚多少）
   ⚠️ 字号一律 ≥28rpx（AD-G1 可读性红线）；「赚/亏」只靠颜色区分，不靠缩字号。 */
.pl-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pl-row.pl-head { border-bottom: 1rpx solid #e2e2e2; }
.pl-c1 { flex: 1; font-size: 30rpx; color: #333; }
.pl-c2 { flex: 1; font-size: 32rpx; font-weight: 600; text-align: right; color: #1a1a1a; }
.pl-c2.pl-ok { color: #1f7a4d; }
.pl-c2.pl-warn { color: #b3491d; }

/* 🔴 R330：促销卡（折扣 / 参与率）—— 复用 .chip，字号 ≥28rpx（AD-G1） */
.promo-row { display: flex; align-items: flex-start; margin-top: 18rpx; flex-wrap: wrap; }
.promo-real-inp { background: #f2f3f7; padding: 12rpx 18rpx; border-radius: 10rpx;
  font-size: 30rpx; width: 180rpx; text-align: right; margin-left: 12rpx; }
.promo-real-unit { font-size: 30rpx; color: #666; margin-left: 8rpx; }
.promo-lb { flex: 0 0 190rpx; font-size: 30rpx; color: #333; line-height: 56rpx; }
.promo-chips { flex: 1 1 0; display: flex; flex-wrap: wrap; min-width: 0; }
.promo-chips .chip { margin-bottom: 10rpx; }

/* ===== R351 · 补「被 wxml 引用但从未定义」的 class =====
   🔴 这类问题能编译、能跑、零报错，只是**长得不对**（走默认样式）。
      新增守卫 tools/check_wxml_class_defined.js 扫出来的，只补样式，不动结构。
      取值对齐同页既有口径：.warn 沿用 app.wxss 的 .warn-line 琥珀告警；
      .ipt-num 对齐 .row-in；.unit 对齐 .row-unit。 */
.warn {
  font-size: 30rpx; color: #92610a; background: #fdf3d8;
  border-left: 8rpx solid #e8a33d; border-radius: 0 12rpx 12rpx 0;
  padding: 16rpx 20rpx; margin: 12rpx 0; line-height: 1.6;
}
/* R419：`.warn-note` 已提到 app.wxss（M1 月度录入页同用）⇒ 本地不再重复定义 */
.ipt-num { flex: 1 1 auto; font-size: 30rpx; color: #1e3a5f; text-align: right; min-height: 40rpx; }
.unit { font-size: 30rpx; color: #888; margin-left: 6rpx; }
/* 两个入口按钮原本会各自占满一行（.btn 是 display:flex 且无宽度限制） */
.entry-row { display: flex; gap: 16rpx; }
.entry-btn { flex: 1 1 0; min-width: 0; margin-top: 24rpx; }

/* 🔴 R364：试验台卡片 —— 与"事实表单"视觉分离（虚线边 + 浅底），但**不引入新品牌色**，
   只用仓内已有色（页面底 #f6f7fb / 边框 #dfe5ec / 品牌墨蓝 #1e3a5f）。 */
.trial-card { background: #fbfcfe; border: 1rpx dashed #dfe5ec; }
.trial-card .fold-toggle { margin-top: 0; }

/* 🔴 R367：目标反推卡 —— 与"体检卡"分开，视觉上像一张便签（左竖条 + 浅底） */
.tgt-back-card { border-left: 6rpx solid #1e3a5f; background: #f8fafc; }
.tgt-back-line { white-space: normal; line-height: 1.5; }

/* R436：顶部一行导航（填什么 → 看什么）。字号走 28rpx 底线（selftest_ad_gates G1）。 */
.m2nav { font-size: 30rpx; color: #8a94a6; line-height: 1.6; padding: 8rpx 24rpx 0; }

/* R439：费率行「≈ 每月多少钱」—— 灰色小字但走 28rpx 底线；宽度不够时换行不挤掉输入框。 */
.fee-amt { font-size: 30rpx; color: #646a73; margin-left: 12rpx; flex: 0 0 auto; }

/* 🔴 R570：人效/坪效缺数态 —— 数值位显示「—」，整卡可点（点了去填预计月营业额）。
   灰掉是刻意的：它表示「不是算不出来，是缺你一个数」，比整块消失诚实。 */
.eff-need .val.muted { color: #9aa3af; }
.eff-need .hint { color: #6b7280; }
